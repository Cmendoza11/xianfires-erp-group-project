{{> head}}
<body class="bg-[#fffdf2] dark:bg-[#0f0f0f] min-h-screen">
  <div class="min-h-screen md:flex">
    {{> adminSidebar activeSection="top-customers"}}
    <main class="flex-1 px-4 py-8 lg:px-8">
      <header class="mb-6 rounded-2xl bg-[#171717] p-6 text-white shadow-lg">
        <p class="text-xs uppercase tracking-widest text-[#f7d83d] font-semibold">Admin Reports</p>
        <h1 class="mt-2 text-3xl font-bold">🏆 Top Customers Leaderboard</h1>
        <p class="mt-2 text-[#f5edbd] opacity-80">Monthly contest winners - Reward your most loyal customers!</p>
      </header>

      {{#if error_msg}}
      <div class="mb-4 rounded-xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 p-4">
        <p class="text-sm text-red-800 dark:text-red-200">{{error_msg}}</p>
      </div>
      {{/if}}

      {{#if success_msg}}
      <div class="mb-4 rounded-xl bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 p-4">
        <p class="text-sm text-green-800 dark:text-green-200">{{success_msg}}</p>
      </div>
      {{/if}}

      <!-- Stats Cards -->
      <div class="grid gap-4 md:grid-cols-4 mb-6">
        <div class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] p-5 shadow-sm">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 font-semibold">Active Customers</p>
              <p class="mt-2 text-3xl font-bold text-[#171717] dark:text-white">{{stats.totalCustomers}}</p>
            </div>
            <div class="rounded-xl bg-blue-100 dark:bg-blue-900/30 p-3">
              <svg class="h-6 w-6 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
              </svg>
            </div>
          </div>
        </div>

        <div class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] p-5 shadow-sm">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 font-semibold">Total Revenue</p>
              <p class="mt-2 text-3xl font-bold text-green-600 dark:text-green-400">₱{{stats.totalRevenue}}</p>
            </div>
            <div class="rounded-xl bg-green-100 dark:bg-green-900/30 p-3">
              <svg class="h-6 w-6 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
          </div>
        </div>

        <div class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] p-5 shadow-sm">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 font-semibold">Avg per Customer</p>
              <p class="mt-2 text-3xl font-bold text-[#75651d] dark:text-[#f7d83d]">₱{{stats.avgSpendPerCustomer}}</p>
            </div>
            <div class="rounded-xl bg-[#f7d83d]/20 p-3">
              <svg class="h-6 w-6 text-[#75651d] dark:text-[#f7d83d]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
              </svg>
            </div>
          </div>
        </div>

        {{#if stats.topSpender}}
        <div class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-gradient-to-br from-yellow-50 to-orange-50 dark:from-yellow-900/20 dark:to-orange-900/20 p-5 shadow-sm">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs uppercase tracking-wide text-gray-500 dark:text-gray-400 font-semibold">👑 Top Spender</p>
              <p class="mt-2 text-lg font-bold text-[#171717] dark:text-white truncate">{{stats.topSpender.name}}</p>
              <p class="text-sm text-gray-600 dark:text-gray-400">{{stats.topSpender.purchaseCount}} purchases</p>
            </div>
          </div>
        </div>
        {{/if}}
      </div>

      <!-- Period Filter -->
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-[#171717] dark:text-white">{{periodLabel}} Rankings</h2>
          {{#if startDate}}
          <p class="text-sm text-gray-600 dark:text-gray-400">{{startDate}} - {{endDate}}</p>
          {{/if}}
        </div>
        <form method="GET" action="/admin/reports/top-customers" class="flex gap-2">
          <select name="period" onchange="this.form.submit()" class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]">
            <option value="this_month" {{#ifEquals period "this_month"}}selected{{/ifEquals}}>This Month</option>
            <option value="last_month" {{#ifEquals period "last_month"}}selected{{/ifEquals}}>Last Month</option>
            <option value="this_year" {{#ifEquals period "this_year"}}selected{{/ifEquals}}>This Year</option>
            <option value="all_time" {{#ifEquals period "all_time"}}selected{{/ifEquals}}>All Time</option>
          </select>
        </form>
      </div>

      <!-- Leaderboard Table -->
      <section class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-[#171717] text-white">
              <tr>
                <th class="p-4 text-left text-xs uppercase tracking-wide font-semibold">Rank</th>
                <th class="p-4 text-left text-xs uppercase tracking-wide font-semibold">Customer</th>
                <th class="p-4 text-left text-xs uppercase tracking-wide font-semibold">Purchases</th>
                <th class="p-4 text-left text-xs uppercase tracking-wide font-semibold">Spent (Period)</th>
                <th class="p-4 text-left text-xs uppercase tracking-wide font-semibold">Total Spent</th>
                <th class="p-4 text-left text-xs uppercase tracking-wide font-semibold">Points</th>
                <th class="p-4 text-left text-xs uppercase tracking-wide font-semibold">Tier</th>
                <th class="p-4 text-left text-xs uppercase tracking-wide font-semibold">Last Purchase</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[#ead36a] dark:divide-[#2d2d2d]">
              {{#each topCustomers}}
              <tr class="hover:bg-[#fffdf2] dark:hover:bg-[#111] transition-colors {{#ifEquals rank 1}}bg-yellow-50 dark:bg-yellow-900/10{{/ifEquals}}">
                <td class="p-4">
                  <div class="flex items-center gap-2">
                    {{#ifEquals rank 1}}
                    <span class="text-2xl">🥇</span>
                    {{else}}{{#ifEquals rank 2}}
                    <span class="text-2xl">🥈</span>
                    {{else}}{{#ifEquals rank 3}}
                    <span class="text-2xl">🥉</span>
                    {{else}}
                    <span class="text-lg font-bold text-gray-500 dark:text-gray-400">#{{rank}}</span>
                    {{/ifEquals}}{{/ifEquals}}{{/ifEquals}}
                  </div>
                </td>
                <td class="p-4">
                  <p class="font-semibold text-[#171717] dark:text-white">{{name}}</p>
                  {{#if email}}
                  <p class="text-xs text-gray-500 dark:text-gray-400">{{email}}</p>
                  {{/if}}
                </td>
                <td class="p-4">
                  <span class="inline-flex items-center rounded-full bg-blue-100 dark:bg-blue-900/30 px-3 py-1 text-sm font-semibold text-blue-700 dark:text-blue-300">
                    {{purchaseCount}} purchases
                  </span>
                </td>
                <td class="p-4 font-semibold text-green-600 dark:text-green-400">₱{{periodSpent}}</td>
                <td class="p-4 text-gray-600 dark:text-gray-400">₱{{totalSpent}}</td>
                <td class="p-4">
                  <span class="inline-flex items-center rounded-full bg-[#f7d83d]/20 px-3 py-1 text-sm font-semibold text-[#75651d] dark:text-[#f7d83d]">
                    {{loyaltyPoints}} pts
                  </span>
                </td>
                <td class="p-4">
                  {{#ifEquals tier "Gold"}}
                  <span class="inline-flex items-center rounded-full bg-yellow-100 dark:bg-yellow-900/30 px-3 py-1 text-xs font-semibold text-yellow-700 dark:text-yellow-300">
                    👑 {{tier}}
                  </span>
                  {{else}}{{#ifEquals tier "Silver"}}
                  <span class="inline-flex items-center rounded-full bg-gray-200 dark:bg-gray-700 px-3 py-1 text-xs font-semibold text-gray-700 dark:text-gray-300">
                    ⭐ {{tier}}
                  </span>
                  {{else}}
                  <span class="inline-flex items-center rounded-full bg-blue-100 dark:bg-blue-900/30 px-3 py-1 text-xs font-semibold text-blue-700 dark:text-blue-300">
                    {{tier}}
                  </span>
                  {{/ifEquals}}{{/ifEquals}}
                </td>
                <td class="p-4 text-xs text-gray-600 dark:text-gray-400">{{lastPurchase}}</td>
              </tr>
              {{else}}
              <tr>
                <td colspan="8" class="p-12 text-center">
                  <div class="flex flex-col items-center gap-3">
                    <svg class="h-16 w-16 text-gray-300 dark:text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    <p class="text-gray-500 dark:text-gray-400 font-semibold">No purchase data for this period</p>
                    <p class="text-sm text-gray-400 dark:text-gray-500">Staff need to log customer purchases first</p>
                  </div>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </section>


    </main>
  </div>
{{> footer}}
