<aside class="w-full shrink-0 bg-[#171717] p-5 text-white md:flex md:min-h-screen md:w-64 md:flex-col shadow-xl">
  <div class="flex items-center gap-3 border-b border-[#2d2d2d] pb-5">
    <img src="/foodhub-logo.png" alt="FoodHuB logo" class="h-14 w-14 rounded-xl object-contain shadow-md" />
    <div>
      <p class="font-bold text-[#f7d83d] text-lg leading-tight">FoodHuB</p>
      <p class="text-xs text-[#f5edbd] opacity-75">Admin Panel</p>
    </div>
  </div>
  <nav class="mt-6 grid gap-1" aria-label="Admin functions">
    <a href="/admin/promo-management" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition-all {{#ifEquals activeSection "promo-management"}}bg-[#f7d83d] text-[#171717] shadow-md font-bold{{else}}text-[#f5edbd] hover:bg-[#2d2d2d] hover:text-white{{/ifEquals}}">
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
      </svg>
      <span>Promo Management</span>
    </a>
    <a href="/admin/users" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition-all {{#ifEquals activeSection "users"}}bg-[#f7d83d] text-[#171717] shadow-md font-bold{{else}}text-[#f5edbd] hover:bg-[#2d2d2d] hover:text-white{{/ifEquals}}">
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
      </svg>
      <span>User Management</span>
    </a>
    <a href="/admin/reports/top-customers" class="flex items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition-all {{#ifEquals activeSection "top-customers"}}bg-[#f7d83d] text-[#171717] shadow-md font-bold{{else}}text-[#f5edbd] hover:bg-[#2d2d2d] hover:text-white{{/ifEquals}}">
      <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
      </svg>
      <span>Top Customers</span>
    </a>
    {{> erpModules}}
  </nav>
  <a href="/logout" class="mt-6 flex items-center justify-center gap-2 rounded-xl border border-[#f7d83d]/50 px-4 py-3 text-center text-sm font-semibold text-[#f7d83d] hover:bg-[#f7d83d] hover:text-[#171717] transition-all md:mt-auto">
    <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
    </svg>
    <span>Logout</span>
  </a>
</aside>
