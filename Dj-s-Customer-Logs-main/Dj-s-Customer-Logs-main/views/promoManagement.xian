{{> head}}
<body class="bg-[#fffdf2] dark:bg-[#0f0f0f] min-h-screen">
  <div class="min-h-screen md:flex">
    {{> adminSidebar activeSection="promo-management"}}
    <main class="flex-1 px-4 py-8 lg:px-8">
      <header class="mb-6 rounded-2xl bg-[#171717] p-6 text-white shadow-lg">
        <p class="text-xs uppercase tracking-widest text-[#f7d83d] font-semibold">Admin workspace</p>
        <h1 class="mt-2 text-3xl font-bold">Promo Management</h1>
        <p class="mt-2 text-[#f5edbd] opacity-80">Create promos and vouchers. With a code, the cashier applies them in the POS checkout; the discount, validity, minimum spend and points cost are checked here.</p>
      </header>

      <section class="rounded-2xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] p-6 shadow-sm mb-6">
        <h2 class="text-lg font-bold text-[#171717] dark:text-white mb-4">Create New Promo</h2>
        <form class="grid gap-3 md:grid-cols-2 lg:grid-cols-5" method="POST" action="/admin/promos">
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Promo name<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="name" value="" placeholder="10% Off Weekend" required /></label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Promo code<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="code" value="" placeholder="DJ-YUM10" maxlength="30" style="text-transform:uppercase" /></label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Discount type
            <select class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="discountType">
              <option value="percent" >Percent (%)</option>
              <option value="fixed" >Fixed amount (₱)</option>
            </select>
          </label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Discount value<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="discountValue" type="number" min="0" step="0.01" value="10" required /></label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Minimum spend (₱)<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="minimumSpend" type="number" min="0" step="0.01" value="0" required /></label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Points cost<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="pointsCost" type="number" min="0" step="1" value="0" required /></label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Min. earlier purchases<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="minimumPurchases" type="number" min="0" step="1" value="0" required /></label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Valid from<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="startDate" type="date" value="" required /></label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Valid until<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="endDate" type="date" value="" required /></label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Mechanics<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="mechanics" value="" placeholder="10% off orders over ₱500" required /></label>
          <button class="rounded-xl bg-[#171717] dark:bg-[#f7d83d] px-4 py-2.5 font-semibold text-[#f7d83d] dark:text-[#171717] hover:opacity-90 transition-all lg:col-span-5 shadow-sm" type="submit">Create Promo</button>
        </form>
      </section>

      <section class="rounded-2xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#1a1a1a] p-6 shadow-sm">
        <h2 class="text-lg font-bold text-[#171717] dark:text-white mb-4">Available Promotions</h2>
        <div class="grid gap-4 md:grid-cols-2">
          {{#each promos}}
          <article class="rounded-2xl border border-[#ead36a] dark:border-[#2d2d2d] bg-[#fffdf2] dark:bg-[#111] p-5 shadow-sm">
            <div class="flex items-start justify-between mb-1">
              <h3 class="font-bold text-[#171717] dark:text-white">{{name}}</h3>
              <span class="rounded-full px-3 py-1 text-xs font-semibold {{#ifEquals status "active"}}bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400{{else}}bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-400{{/ifEquals}}">{{status}}</span>
            </div>
            <p class="mb-3 text-xs text-gray-500 dark:text-gray-400">
              {{#if code}}<span class="font-mono font-bold text-[#75651d] dark:text-[#f7d83d]">{{code}}</span> · {{/if}}{{summary}} · {{redeemed}} use(s)
            </p>
            <form class="grid gap-2 sm:grid-cols-2" method="POST" action="/admin/promos/{{promoId}}">
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Promo name<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="name" value="{{name}}" placeholder="10% Off Weekend" required /></label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Promo code<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="code" value="{{code}}" placeholder="DJ-YUM10" maxlength="30" style="text-transform:uppercase" /></label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Discount type
            <select class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="discountType">
              <option value="percent" {{#ifEquals discountType "percent"}}selected{{/ifEquals}}>Percent (%)</option>
              <option value="fixed" {{#ifEquals discountType "fixed"}}selected{{/ifEquals}}>Fixed amount (₱)</option>
            </select>
          </label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Discount value<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="discountValue" type="number" min="0" step="0.01" value="{{discountValue}}" required /></label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Minimum spend (₱)<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="minimumSpend" type="number" min="0" step="0.01" value="{{minimumSpend}}" required /></label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Points cost<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="pointsCost" type="number" min="0" step="1" value="{{pointsCost}}" required /></label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Min. earlier purchases<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="minimumPurchases" type="number" min="0" step="1" value="{{minimumPurchases}}" required /></label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Valid from<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="startDate" type="date" value="{{startDate}}" required /></label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Valid until<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="endDate" type="date" value="{{endDate}}" required /></label>
          <label class="grid gap-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">Mechanics<input class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] bg-white dark:bg-[#111] dark:text-white p-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#f7d83d]" name="mechanics" value="{{mechanics}}" placeholder="10% off orders over ₱500" required /></label>
              <button class="rounded-xl bg-[#171717] dark:bg-[#f7d83d] px-3 py-2 text-xs font-semibold text-[#f7d83d] dark:text-[#171717] hover:opacity-90 transition-all sm:col-span-2" type="submit">Save Changes</button>
            </form>
            <div class="mt-3 flex gap-2">
              <form method="POST" action="/admin/promos/{{promoId}}/toggle">
                <button class="rounded-xl border border-[#ead36a] dark:border-[#2d2d2d] px-3 py-2 text-xs font-semibold text-[#75651d] dark:text-[#f7d83d] hover:bg-[#f7d83d] hover:text-[#171717] transition-all" type="submit">Activate / Deactivate</button>
              </form>
              <form method="POST" action="/admin/promos/{{promoId}}/delete" onsubmit="return confirm('Delete this promo? This cannot be undone.')">
                <button class="rounded-xl border border-red-300 dark:border-red-800 px-3 py-2 text-xs font-semibold text-red-600 dark:text-red-400 hover:bg-red-600 hover:text-white transition-all" type="submit">Delete</button>
              </form>
            </div>
          </article>
          {{else}}
          <p class="text-sm text-gray-400 dark:text-gray-500 col-span-2 py-4 text-center">No promotions created yet.</p>
          {{/each}}
        </div>
      </section>
    </main>
  </div>
{{> footer}}
