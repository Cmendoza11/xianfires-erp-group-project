<button type="button" class="{{#if class}}{{ class }}{{else}}theme-toggle{{/if}}" data-theme-toggle aria-label="Switch between light and dark mode" title="Switch light / dark mode">
  <svg class="theme-icon-moon w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
  <svg class="theme-icon-sun w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
  {{#if label}}<span class="rail-label"><span class="theme-label-dark">Dark</span><span class="theme-label-light">Light</span></span>{{/if}}
</button>
