<ul class="password-rules" data-password-rules aria-live="polite">
  <li data-rule="length">At least 8 characters</li>
  <li data-rule="upper">An uppercase letter (A-Z)</li>
  <li data-rule="lower">A lowercase letter (a-z)</li>
  <li data-rule="number">A number (0-9)</li>
  <li data-rule="symbol">A symbol (e.g. ! @ # $ %)</li>
  <li data-rule="space">No spaces</li>
</ul>
