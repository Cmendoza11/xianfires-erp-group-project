PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=xianfires_erp
DB_USER=root
DB_PASSWORD=
# Long random string used to sign the session cookie
SESSION_SECRET=change-me
# true shows a "Create an account" page that makes ADMIN accounts. Local setup only; keep it off in production.
ALLOW_SIGNUP=false
# ERP integration API (/api/v1): comma-separated browser origins allowed to call it directly.
# Leave empty for server-to-server calls (recommended); API keys must not be exposed in browsers.
API_CORS_ORIGINS=

# --- Online hosting (Hostinger Web Apps, VPS) ---
# true when the app runs behind the host's HTTPS proxy: real client IP for rate limits.
TRUST_PROXY=false
# true once the site is served over https:// only (session cookie is then never sent over plain http).
COOKIE_SECURE=false
# Used by start-hosted.js: creates this first administrator if the login does not exist yet.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Where the other modules are online, and the shared internal key they all use.
ERP_URL_HR=
ERP_URL_POS=
ERP_URL_SCM=
ERP_URL_CRM=
ERP_INTERNAL_KEY=
