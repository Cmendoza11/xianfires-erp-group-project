{{> head}}
<body class="bg-black text-gray-100 min-h-screen flex flex-col justify-between">

  <!-- Toast Notification Popups -->
  {{#if successMessage}}
    <div id="toastMessage" class="fixed top-5 right-5 z-50 bg-emerald-950 border border-emerald-800 text-emerald-300 px-6 py-3 rounded-xl shadow-2xl flex items-center space-x-3 transition-all duration-300">
      <i class="fas fa-check-circle text-emerald-400"></i>
      <span class="text-xs font-semibold">{{successMessage}}</span>
    </div>
  {{/if}}
  {{#if errorMessage}}
    <div id="toastMessage" class="fixed top-5 right-5 z-50 bg-red-950 border border-red-800 text-red-300 px-6 py-3 rounded-xl shadow-2xl flex items-center space-x-3 transition-all duration-300">
      <i class="fas fa-exclamation-triangle text-red-400"></i>
      <span class="text-xs font-semibold">{{errorMessage}}</span>
    </div>
  {{/if}}

  <div class="flex flex-1">
    <!-- Master Sidebar -->
    {{> sidebar}}

    <!-- Main Content Area -->
    <main class="flex-1 p-8 overflow-y-auto bg-black">
      
      <!-- Page Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 bg-zinc-900/60 border border-zinc-800/80 p-6 rounded-2xl backdrop-blur-md">
        <div>
          <div class="flex items-center space-x-3">
            <h2 class="text-xl font-bold text-white tracking-wide">Purchasing & Supplier Intelligence Reports</h2>
            <span class="bg-yellow-400/10 text-yellow-400 border border-yellow-400/30 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
              Module 12
            </span>
          </div>
          <p class="text-xs text-gray-400 mt-1">Exportable decision-making analytics across purchasing, inventory deliveries, returns, and liabilities.</p>
        </div>
        <div class="flex items-center space-x-3">
          <button onclick="window.print()" class="bg-zinc-800 hover:bg-zinc-700 text-white font-bold px-4 py-2.5 rounded-xl text-xs transition border border-zinc-700 flex items-center space-x-2">
            <i class="fas fa-print"></i>
            <span>Print Report</span>
          </button>
        </div>
      </div>

      <!-- Report Type Navigation Tabs -->
      <div class="flex items-center space-x-2 overflow-x-auto pb-3 mb-6 border-b border-zinc-800/80 text-xs">
        <a href="/reports?reportType=purchase-orders" class="px-4 py-2 rounded-xl font-semibold transition shrink-0 {{#eq reportType 'purchase-orders'}}bg-yellow-400 text-black shadow-lg font-bold{{else}}text-gray-400 hover:bg-zinc-900 hover:text-white{{/eq}}">
          <i class="fas fa-file-invoice mr-1.5"></i> Purchase Orders
        </a>
        <a href="/reports?reportType=supplier-directory" class="px-4 py-2 rounded-xl font-semibold transition shrink-0 {{#eq reportType 'supplier-directory'}}bg-yellow-400 text-black shadow-lg font-bold{{else}}text-gray-400 hover:bg-zinc-900 hover:text-white{{/eq}}">
          <i class="fas fa-address-book mr-1.5"></i> Supplier Directory
        </a>
        <a href="/reports?reportType=supplier-products" class="px-4 py-2 rounded-xl font-semibold transition shrink-0 {{#eq reportType 'supplier-products'}}bg-yellow-400 text-black shadow-lg font-bold{{else}}text-gray-400 hover:bg-zinc-900 hover:text-white{{/eq}}">
          <i class="fas fa-boxes-stacked mr-1.5"></i> Products & Pricing
        </a>
        <a href="/reports?reportType=goods-received" class="px-4 py-2 rounded-xl font-semibold transition shrink-0 {{#eq reportType 'goods-received'}}bg-yellow-400 text-black shadow-lg font-bold{{else}}text-gray-400 hover:bg-zinc-900 hover:text-white{{/eq}}">
          <i class="fas fa-dolly mr-1.5"></i> Goods Receiving
        </a>
        <a href="/reports?reportType=returned-products" class="px-4 py-2 rounded-xl font-semibold transition shrink-0 {{#eq reportType 'returned-products'}}bg-yellow-400 text-black shadow-lg font-bold{{else}}text-gray-400 hover:bg-zinc-900 hover:text-white{{/eq}}">
          <i class="fas fa-rotate-left mr-1.5"></i> Supplier Returns
        </a>
        <a href="/reports?reportType=outstanding-invoices" class="px-4 py-2 rounded-xl font-semibold transition shrink-0 {{#eq reportType 'outstanding-invoices'}}bg-yellow-400 text-black shadow-lg font-bold{{else}}text-gray-400 hover:bg-zinc-900 hover:text-white{{/eq}}">
          <i class="fas fa-receipt mr-1.5"></i> Outstanding Invoices
        </a>
        <a href="/reports?reportType=monthly-purchasing" class="px-4 py-2 rounded-xl font-semibold transition shrink-0 {{#eq reportType 'monthly-purchasing'}}bg-yellow-400 text-black shadow-lg font-bold{{else}}text-gray-400 hover:bg-zinc-900 hover:text-white{{/eq}}">
          <i class="fas fa-chart-line mr-1.5"></i> Monthly Purchasing
        </a>
      </div>

      <!-- Report Filters & Date Controls -->
      <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 mb-6 shadow-xl">
        <form action="/reports" method="GET" class="flex flex-col md:flex-row items-center gap-3">
          <input type="hidden" name="reportType" value="{{reportType}}">
          
          <div class="flex-1 w-full flex items-center space-x-2">
            <select name="supplierId" class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400">
              <option value="All">All Suppliers</option>
              {{#each suppliers}}
                <option value="{{id}}" {{#eq ../filterSupplier id}}selected{{/eq}}>{{name}}</option>
              {{/each}}
            </select>
          </div>

          <div class="flex items-center space-x-2 w-full md:w-auto">
            <div class="flex items-center space-x-1.5 bg-black border border-zinc-800 rounded-xl px-3 py-1.5">
              <span class="text-[10px] text-gray-500 uppercase font-semibold">From:</span>
              <input type="date" name="startDate" value="{{filterStartDate}}" class="bg-transparent text-xs text-white focus:outline-none">
            </div>
            <div class="flex items-center space-x-1.5 bg-black border border-zinc-800 rounded-xl px-3 py-1.5">
              <span class="text-[10px] text-gray-500 uppercase font-semibold">To:</span>
              <input type="date" name="endDate" value="{{filterEndDate}}" class="bg-transparent text-xs text-white focus:outline-none">
            </div>
            <button type="submit" class="bg-zinc-800 hover:bg-zinc-700 text-yellow-400 px-4 py-2.5 rounded-xl text-xs font-bold transition">
              Apply
            </button>
            <a href="/reports?reportType={{reportType}}" class="text-gray-400 hover:text-white text-xs px-2">
              Reset
            </a>
          </div>
        </form>
      </div>

      <!-- Summary KPI Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
        <div class="bg-zinc-900/80 border border-zinc-800 p-4 rounded-xl">
          <span class="text-[10px] text-gray-400 uppercase font-semibold block">Total Entries</span>
          <span class="text-xl font-bold text-white mt-1 block">{{summaryTotals.totalRecords}}</span>
        </div>
        {{#if summaryTotals.metric1Label}}
          <div class="bg-zinc-900/80 border border-zinc-800 p-4 rounded-xl">
            <span class="text-[10px] text-gray-400 uppercase font-semibold block">{{summaryTotals.metric1Label}}</span>
            <span class="text-xl font-bold text-yellow-400 mt-1 block">{{summaryTotals.metric1Val}}</span>
          </div>
        {{/if}}
        {{#if summaryTotals.metric2Label}}
          <div class="bg-zinc-900/80 border border-zinc-800 p-4 rounded-xl">
            <span class="text-[10px] text-gray-400 uppercase font-semibold block">{{summaryTotals.metric2Label}}</span>
            <span class="text-xl font-bold text-emerald-400 mt-1 block">{{summaryTotals.metric2Val}}</span>
          </div>
        {{/if}}
        {{#if summaryTotals.metric3Label}}
          <div class="bg-zinc-900/80 border border-zinc-800 p-4 rounded-xl">
            <span class="text-[10px] text-gray-400 uppercase font-semibold block">{{summaryTotals.metric3Label}}</span>
            <span class="text-xl font-bold text-red-400 mt-1 block">{{summaryTotals.metric3Val}}</span>
          </div>
        {{/if}}
      </div>

      <!-- Dynamic Report Table -->
      <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl overflow-hidden shadow-2xl">
        <div class="p-4 border-b border-zinc-800 flex items-center justify-between">
          <div class="flex items-center space-x-2">
            <span class="w-2 h-2 rounded-full bg-yellow-400"></span>
            <h3 class="text-xs font-bold text-white uppercase tracking-wider">Report Dataset</h3>
          </div>
          <span class="text-[10px] text-gray-500 font-mono">Official System Audit Record</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-zinc-950 text-gray-400 uppercase text-[10px] tracking-wider border-b border-zinc-800">
              <tr>
                <th class="py-3 px-4">Identifier / Ref</th>
                <th class="py-3 px-4">Entity / Primary</th>
                <th class="py-3 px-4">Details / Dept</th>
                <th class="py-3 px-4">Date / Contact</th>
                <th class="py-3 px-4">Terms / Breakdown</th>
                <th class="py-3 px-4 text-right">Value / Metric</th>
                <th class="py-3 px-4 text-center">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-800/60 text-gray-300">
              {{#if reportData.length}}
                {{#each reportData}}
                  <tr class="hover:bg-zinc-800/40 transition">
                    <td class="py-3 px-4 font-mono font-bold text-yellow-400">
                      {{col1}}
                    </td>
                    <td class="py-3 px-4 font-semibold text-white">
                      {{col2}}
                    </td>
                    <td class="py-3 px-4 text-gray-400">
                      {{col3}}
                    </td>
                    <td class="py-3 px-4 text-gray-400 font-mono">
                      {{col4}}
                    </td>
                    <td class="py-3 px-4 text-gray-300">
                      {{col5}}
                    </td>
                    <td class="py-3 px-4 text-right font-mono font-bold text-white">
                      {{col6}}
                    </td>
                    <td class="py-3 px-4 text-center">
                      {{{statusBadge status}}}
                    </td>
                  </tr>
                {{/each}}
              {{else}}
                <tr>
                  <td colspan="7" class="py-12 text-center text-gray-500">
                    <i class="fas fa-chart-pie text-4xl mb-3 text-zinc-700"></i>
                    <p class="text-sm font-medium">No records found for this report configuration.</p>
                  </td>
                </tr>
              {{/if}}
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>

  {{> footer}}

  <script>
    setTimeout(() => {
      const toast = document.getElementById('toastMessage');
      if (toast) toast.style.display = 'none';
    }, 4500);
  </script>
</body>
</html>