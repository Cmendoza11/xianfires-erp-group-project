{{> head}}
<body class="bg-black text-gray-100 flex flex-col justify-between min-h-screen">

  <!-- Top Bar with Theme Toggle -->
  <div class="p-6 flex justify-between items-center max-w-7xl mx-auto w-full">
    <div class="flex items-center space-x-2">
      <img src="/images/logo.png" alt="DJ's FoodHub" class="w-8 h-8 object-contain">
      <span class="font-bold text-yellow-400 text-sm tracking-wide">DJ's FoodHub</span>
    </div>

    <!-- Theme Switcher Pill -->
    <button onclick="toggleTheme()" type="button" class="flex items-center space-x-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-gray-300 transition shadow" title="Toggle Dark/Light Mode">
      <i id="themeToggleIcon" class="fas fa-moon text-yellow-400"></i>
      <span id="themeToggleText">Dark Mode</span>
    </button>
  </div>

  <!-- Center Login Card Container -->
  <div class="flex items-center justify-center p-6 my-auto">
    <div class="w-full max-w-md bg-zinc-900/90 border border-zinc-800 rounded-3xl p-8 shadow-2xl backdrop-blur-md">
      
      <!-- Official Logo / Brand Section -->
      <div class="flex flex-col items-center text-center mb-6">
        <img src="/images/logo.png" alt="DJ's FoodHub Logo" class="w-20 h-20 object-contain rounded-2xl bg-black/60 p-2 border-2 border-yellow-400/80 shadow-2xl mb-3">
        <h1 class="text-2xl font-black text-yellow-400 tracking-wide leading-tight">DJ'S FOODHUB</h1>
        <p class="text-xs text-gray-400 mt-1 uppercase tracking-wider font-semibold">Supplier Management System</p>
      </div>

      <!-- Error Message -->
      {{#if errorMessage}}
        <div class="mb-4 p-3 rounded-xl bg-red-950/80 border border-red-800 text-red-300 text-xs text-center flex items-center justify-center space-x-2">
          <i class="fas fa-circle-exclamation text-red-400"></i>
          <span>{{errorMessage}}</span>
        </div>
      {{/if}}

      <!-- Login Form -->
      <form action="/login" method="POST" class="space-y-4" autocomplete="off">
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1 uppercase tracking-wider">Email Address</label>
          <input type="email" name="email" placeholder="admin@gmail.com" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-yellow-400 transition">
        </div>

        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="block text-xs font-semibold text-gray-400 uppercase tracking-wider">Password</label>
            <a href="/forgot-password" class="text-[11px] text-yellow-400 hover:underline">Forgot password?</a>
          </div>
          <div class="relative">
            <input type="password" id="loginPassword" name="password" placeholder="••••••••" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2.5 pr-10 text-sm text-white focus:outline-none focus:border-yellow-400 transition">
            <button type="button" onclick="toggleLoginPassword()" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-yellow-400 focus:outline-none">
              <i id="loginEyeIcon" class="fas fa-eye text-sm"></i>
            </button>
          </div>
        </div>

        <button type="submit" class="w-full bg-yellow-400 hover:bg-yellow-500 text-black font-extrabold py-3 px-4 rounded-xl text-sm transition shadow-lg mt-2 flex items-center justify-center space-x-2">
          <span>Sign In to Portal</span>
          <i class="fas fa-arrow-right text-xs"></i>
        </button>
      </form>

      <!-- Register Link -->
      <div class="mt-5 text-center">
        <p class="text-xs text-gray-400">
          Need an account? 
          <a href="/register" class="text-yellow-400 hover:underline font-bold ml-1">Register new user</a>
        </p>
      </div>

      <div class="mt-6 text-center border-t border-zinc-800/80 pt-4">
        <p class="text-[11px] text-gray-500 font-mono">DJYum Enterprise Integrated Suite &bull; 2026</p>
      </div>

    </div>
  </div>

  <!-- Bottom Footer -->
  <footer class="py-6 text-center text-xs text-gray-500 tracking-wide">
    &copy; 2026 XianFire Framework &bull; Mindoro State University
  </footer>

  <!-- Theme Script -->
  <script>
    function updateThemeUI(theme) {
      const icon = document.getElementById('themeToggleIcon');
      const text = document.getElementById('themeToggleText');

      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
        if (icon) icon.className = 'fas fa-sun text-yellow-500';
        if (text) text.innerText = 'Light Mode';
      } else {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
        if (icon) icon.className = 'fas fa-moon text-yellow-400';
        if (text) text.innerText = 'Dark Mode';
      }
    }

    function toggleTheme() {
      const isDark = document.documentElement.classList.contains('dark');
      const newTheme = isDark ? 'light' : 'dark';
      localStorage.setItem('dj_theme', newTheme);
      updateThemeUI(newTheme);
    }

    function toggleLoginPassword() {
      const passwordInput = document.getElementById('loginPassword');
      const eyeIcon = document.getElementById('loginEyeIcon');
      if (passwordInput.type === 'password') {
        passwordInput.type = 'text';
        eyeIcon.className = 'fas fa-eye-slash text-sm text-yellow-400';
      } else {
        passwordInput.type = 'password';
        eyeIcon.className = 'fas fa-eye text-sm';
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const currentTheme = localStorage.getItem('dj_theme') || 'dark';
      updateThemeUI(currentTheme);
    });
  </script>
</body>
</html>
