{{> head}}
<body class="bg-black text-gray-100 min-h-screen flex flex-col justify-between">

  <!-- Toast Notification Popups -->
  {{#if successMessage}}
    <div id="toastMessage" class="fixed top-5 right-5 z-50 bg-emerald-950 border border-emerald-800 text-emerald-300 px-6 py-3 rounded-xl shadow-2xl flex items-center space-x-3 transition-all duration-300">
      <i class="fas fa-check-circle text-emerald-400"></i>
      <span class="text-xs font-semibold">{{successMessage}}</span>
    </div>
  {{/if}}
  {{#if errorMessage}}
    <div id="toastMessage" class="fixed top-5 right-5 z-50 bg-red-950 border border-red-800 text-red-300 px-6 py-3 rounded-xl shadow-2xl flex items-center space-x-3 transition-all duration-300">
      <i class="fas fa-exclamation-triangle text-red-400"></i>
      <span class="text-xs font-semibold">{{errorMessage}}</span>
    </div>
  {{/if}}

  <div class="flex flex-1">
    <!-- Master Sidebar -->
    {{> sidebar}}

    <!-- Main Content Area -->
    <main class="flex-1 p-8 overflow-y-auto bg-black">
      
      <!-- Page Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 bg-zinc-900/60 border border-zinc-800/80 p-6 rounded-2xl backdrop-blur-md">
        <div>
          <div class="flex items-center space-x-3">
            <h2 class="text-xl font-bold text-white tracking-wide">Supplier Returns & Credit Management</h2>
            <span class="bg-yellow-400/10 text-yellow-400 border border-yellow-400/30 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
              Module 8
            </span>
          </div>
          <p class="text-xs text-gray-400 mt-1">Manage return of damaged, substandard, or rejected items to vendors; track replacements and credit refunds.</p>
        </div>
        <div class="flex items-center space-x-3">
          <button onclick="openCreateReturnModal()" class="bg-yellow-400 hover:bg-yellow-500 text-black font-bold px-4 py-2.5 rounded-xl text-xs transition shadow-lg flex items-center space-x-2">
            <i class="fas fa-rotate-left"></i>
            <span>Initiate Return Request</span>
          </button>
        </div>
      </div>

      <!-- Quick KPI Cards -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-zinc-900/80 border border-zinc-800 p-5 rounded-2xl flex items-center justify-between">
          <div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Total Returns</p>
            <h3 class="text-2xl font-bold text-white mt-1">{{totalReturns}}</h3>
          </div>
          <div class="w-10 h-10 rounded-xl bg-yellow-400/10 text-yellow-400 flex items-center justify-center">
            <i class="fas fa-rotate-left text-base"></i>
          </div>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-800 p-5 rounded-2xl flex items-center justify-between">
          <div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Pending Review</p>
            <h3 class="text-2xl font-bold text-amber-400 mt-1">{{pendingReturns}}</h3>
          </div>
          <div class="w-10 h-10 rounded-xl bg-amber-400/10 text-amber-400 flex items-center justify-center">
            <i class="fas fa-clock text-base"></i>
          </div>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-800 p-5 rounded-2xl flex items-center justify-between">
          <div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Approved for Dispatch</p>
            <h3 class="text-2xl font-bold text-blue-400 mt-1">{{approvedReturns}}</h3>
          </div>
          <div class="w-10 h-10 rounded-xl bg-blue-400/10 text-blue-400 flex items-center justify-center">
            <i class="fas fa-truck-arrow-right text-base"></i>
          </div>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-800 p-5 rounded-2xl flex items-center justify-between">
          <div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Resolved (Replaced/Refunded)</p>
            <h3 class="text-2xl font-bold text-emerald-400 mt-1">{{completedReturns}}</h3>
          </div>
          <div class="w-10 h-10 rounded-xl bg-emerald-400/10 text-emerald-400 flex items-center justify-center">
            <i class="fas fa-hand-holding-dollar text-base"></i>
          </div>
        </div>
      </div>

      <!-- Filter & Search Controls -->
      <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 mb-6 shadow-xl flex flex-col md:flex-row items-center justify-between gap-4">
        <form action="/supplier-returns" method="GET" class="flex-1 w-full flex flex-col md:flex-row items-center gap-3">
          <div class="relative flex-1 w-full">
            <i class="fas fa-search absolute left-4 top-3.5 text-gray-500 text-xs"></i>
            <input type="text" name="search" value="{{searchQuery}}" placeholder="Search return # or return reason..." class="w-full bg-black border border-zinc-800 rounded-xl pl-10 pr-4 py-2.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-yellow-400 transition">
          </div>
          <div class="flex items-center space-x-2 w-full md:w-auto">
            <select name="supplierId" class="bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400 transition">
              <option value="All">All Suppliers</option>
              {{#each suppliers}}
                <option value="{{id}}" {{#eq ../selectedSupplier id}}selected{{/eq}}>{{name}}</option>
              {{/each}}
            </select>
            <select name="status" class="bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400 transition">
              <option value="All" {{#eq statusFilter 'All'}}selected{{/eq}}>All Statuses</option>
              <option value="Pending" {{#eq statusFilter 'Pending'}}selected{{/eq}}>Pending</option>
              <option value="Approved" {{#eq statusFilter 'Approved'}}selected{{/eq}}>Approved</option>
              <option value="Returned to Supplier" {{#eq statusFilter 'Returned to Supplier'}}selected{{/eq}}>Returned to Supplier</option>
              <option value="Replaced" {{#eq statusFilter 'Replaced'}}selected{{/eq}}>Replaced</option>
              <option value="Refunded" {{#eq statusFilter 'Refunded'}}selected{{/eq}}>Refunded</option>
              <option value="Rejected" {{#eq statusFilter 'Rejected'}}selected{{/eq}}>Rejected</option>
            </select>
            <button type="submit" class="bg-zinc-800 hover:bg-zinc-700 text-gray-200 font-bold px-4 py-2.5 rounded-xl text-xs transition">
              Filter
            </button>
            {{#if searchQuery}}
              <a href="/supplier-returns" class="text-xs text-gray-400 hover:text-white px-2 py-2">Reset</a>
            {{/if}}
          </div>
        </form>
      </div>

      <!-- Returns Table -->
      <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl shadow-xl overflow-hidden mb-8">
        <div class="p-5 border-b border-zinc-800 flex justify-between items-center">
          <h3 class="text-xs font-bold text-yellow-400 uppercase tracking-wider">Vendor Returns Log</h3>
          <span class="text-xs text-gray-500">{{returns.length}} record(s)</span>
        </div>

        {{#if returns.length}}
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead>
                <tr class="border-b border-zinc-800 text-gray-400 uppercase tracking-wider text-[10px] bg-black/40">
                  <th class="py-3 px-4">Return #</th>
                  <th class="py-3 px-4">Date</th>
                  <th class="py-3 px-4">Supplier</th>
                  <th class="py-3 px-4">PO Reference</th>
                  <th class="py-3 px-4">Reason</th>
                  <th class="py-3 px-4 text-center">Items</th>
                  <th class="py-3 px-4 text-center">Status</th>
                  <th class="py-3 px-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-800/60">
                {{#each returns}}
                  <tr class="hover:bg-zinc-800/40 transition">
                    <td class="py-3.5 px-4 font-mono font-bold text-yellow-400">{{returnNumber}}</td>
                    <td class="py-3.5 px-4 text-gray-300">{{formatDate returnDate}}</td>
                    <td class="py-3.5 px-4 font-bold text-white">{{Supplier.name}}</td>
                    <td class="py-3.5 px-4 font-mono text-gray-300">{{PurchaseOrder.poNumber}}</td>
                    <td class="py-3.5 px-4 text-gray-300 truncate max-w-xs">{{returnReason}}</td>
                    <td class="py-3.5 px-4 text-center font-mono text-gray-300">{{itemCount}} item(s)</td>
                    <td class="py-3.5 px-4 text-center">
                      {{{statusBadge status}}}
                    </td>
                    <td class="py-3.5 px-4 text-right">
                      <div class="flex items-center justify-end space-x-1.5">
                        {{#eq status 'Pending'}}
                          <form action="/supplier-returns/approve/{{id}}" method="POST" class="inline" onsubmit="return confirm('Authorize this supplier return?')">
                            <button type="submit" class="p-1.5 bg-zinc-800 hover:bg-emerald-950 text-emerald-400 rounded-lg transition" title="Approve Return">
                              <i class="fas fa-check text-xs"></i>
                            </button>
                          </form>
                        {{/eq}}

                        {{#eq status 'Approved'}}
                          <form action="/supplier-returns/mark-returned/{{id}}" method="POST" class="inline" onsubmit="return confirm('Mark items as physically dispatched to vendor?')">
                            <button type="submit" class="p-1.5 bg-zinc-800 hover:bg-blue-950 text-blue-400 rounded-lg transition" title="Mark Dispatched to Supplier">
                              <i class="fas fa-truck text-xs"></i>
                            </button>
                          </form>
                        {{/eq}}

                        {{#eq status 'Returned to Supplier'}}
                          <button onclick="openResolutionModal('{{id}}', '{{returnNumber}}')" class="p-1.5 bg-zinc-800 hover:bg-yellow-400 hover:text-black text-yellow-400 rounded-lg transition" title="Record Replacement or Refund">
                            <i class="fas fa-handshake text-xs"></i>
                          </button>
                        {{/eq}}
                      </div>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{else}}
          <div class="p-12 text-center text-gray-500">
            <i class="fas fa-rotate-left text-3xl mb-3 text-zinc-700"></i>
            <p class="text-sm">No return records found.</p>
            <button onclick="openCreateReturnModal()" class="mt-4 bg-yellow-400 hover:bg-yellow-500 text-black font-bold px-4 py-2 rounded-xl text-xs transition">
              + Initiate First Return
            </button>
          </div>
        {{/if}}
      </div>
    </main>
  </div>

  <!-- ==================== MODALS ==================== -->

  <!-- 1. Create Return Modal -->
  <div id="createReturnModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 w-full max-w-xl shadow-2xl max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-4 border-b border-zinc-800 pb-3">
        <h3 class="text-sm font-bold text-yellow-400 uppercase tracking-wider flex items-center space-x-2">
          <i class="fas fa-rotate-left"></i>
          <span>Initiate Supplier Return Request</span>
        </h3>
        <button onclick="closeCreateReturnModal()" class="text-gray-400 hover:text-white text-lg font-bold">&times;</button>
      </div>

      <form action="/supplier-returns/add" method="POST" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-400 mb-1">Target Supplier *</label>
            <select name="supplierId" id="returnSupplierSelect" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">
              <option value="">-- Select Supplier --</option>
              {{#each suppliers}}
                <option value="{{id}}">{{name}} ({{supplierCode}})</option>
              {{/each}}
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-400 mb-1">Purchase Order Reference *</label>
            <select name="purchaseOrderId" id="returnPOSelect" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">
              <option value="">-- Select PO --</option>
              {{#each openPOs}}
                <option value="{{id}}">{{poNumber}} ({{Supplier.name}})</option>
              {{/each}}
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1">Primary Reason for Return *</label>
          <input type="text" name="returnReason" placeholder="e.g. Expired batch, broken packaging, wrong cuts delivered" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">
        </div>

        <!-- Defective Items Rows -->
        <div class="border-t border-zinc-800 pt-3">
          <div class="flex justify-between items-center mb-2">
            <h4 class="text-xs font-bold text-gray-300 uppercase tracking-wider">Defective / Returned Line Items</h4>
            <button type="button" onclick="addReturnItemRow()" class="text-[11px] bg-zinc-800 hover:bg-yellow-400 hover:text-black text-yellow-400 font-bold px-2.5 py-1 rounded-lg transition">
              + Add Item Row
            </button>
          </div>

          <table class="w-full text-left text-xs" id="returnItemsTable">
            <thead>
              <tr class="border-b border-zinc-800 text-gray-400 uppercase text-[10px]">
                <th class="py-2">Item Name *</th>
                <th class="py-2 w-24">Qty *</th>
                <th class="py-2 w-20">Unit</th>
                <th class="py-2">Defect Reason</th>
                <th class="py-2 w-8 text-center"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-800/40" id="returnItemsBody">
              <tr>
                <td class="py-2 pr-2">
                  <input type="text" name="item_name" placeholder="Item name" required class="w-full bg-black border border-zinc-800 rounded-lg px-2.5 py-1 text-xs text-white focus:outline-none focus:border-yellow-400">
                  <input type="hidden" name="item_id" value="101">
                </td>
                <td class="py-2 pr-2">
                  <input type="number" step="0.01" name="item_qty" value="2.00" required class="w-full bg-black border border-zinc-800 rounded-lg px-2.5 py-1 text-xs text-white focus:outline-none focus:border-yellow-400">
                </td>
                <td class="py-2 pr-2">
                  <input type="text" name="item_unit" value="kg" class="w-full bg-black border border-zinc-800 rounded-lg px-2.5 py-1 text-xs text-white focus:outline-none focus:border-yellow-400">
                </td>
                <td class="py-2 pr-2">
                  <input type="text" name="item_reason" placeholder="e.g. Torn bags" class="w-full bg-black border border-zinc-800 rounded-lg px-2.5 py-1 text-xs text-white focus:outline-none focus:border-yellow-400">
                </td>
                <td class="py-2 text-center">
                  <button type="button" onclick="removeReturnItemRow(this)" class="text-red-400 font-bold">&times;</button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1">Additional Staff Remarks</label>
          <textarea name="remarks" rows="2" class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400"></textarea>
        </div>

        <div class="flex justify-end space-x-3 pt-4 border-t border-zinc-800">
          <button type="button" onclick="closeCreateReturnModal()" class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-gray-300 text-xs font-bold rounded-xl transition">Cancel</button>
          <button type="submit" class="px-5 py-2 bg-yellow-400 hover:bg-yellow-500 text-black text-xs font-bold rounded-xl transition shadow-lg">Submit Return Request</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 2. Record Resolution Modal (Replacement or Refund) -->
  <div id="resolutionModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 w-full max-w-md shadow-2xl">
      <div class="flex justify-between items-center mb-4 border-b border-zinc-800 pb-3">
        <h3 class="text-sm font-bold text-yellow-400 uppercase tracking-wider">Record Return Resolution</h3>
        <button onclick="closeResolutionModal()" class="text-gray-400 hover:text-white text-lg font-bold">&times;</button>
      </div>
      <form id="resolutionForm" action="/supplier-returns/resolve/" method="POST" class="space-y-4">
        <p class="text-xs text-gray-300">Recording resolution for return <span id="resReturnNumber" class="font-mono text-yellow-400 font-bold"></span>:</p>
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1">Resolution Outcome *</label>
          <select name="resolutionType" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400">
            <option value="Replaced">Product Replaced (Supplier provided replacement stock)</option>
            <option value="Refunded">Credit Memo / Refund (Supplier refunded or deducted from payable)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1">Resolution Notes</label>
          <textarea name="notes" rows="2" placeholder="Credit memo reference, replacement DR number, etc." class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400"></textarea>
        </div>
        <div class="flex justify-end space-x-3 pt-3 border-t border-zinc-800">
          <button type="button" onclick="closeResolutionModal()" class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-gray-300 text-xs font-bold rounded-xl transition">Cancel</button>
          <button type="submit" class="px-5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl transition shadow-lg">Save Resolution</button>
        </div>
      </form>
    </div>
  </div>

  <footer class="bg-zinc-950 border-t border-zinc-800/80 px-8 py-4 text-center text-xs text-gray-600">
    © 2026 DJ's FoodHub. All rights reserved. Supplier Management Module v2.0.
  </footer>

  <script>
    function openCreateReturnModal() {
      document.getElementById('createReturnModal').classList.remove('hidden');
      document.getElementById('createReturnModal').classList.add('flex');
    }

    function closeCreateReturnModal() {
      document.getElementById('createReturnModal').classList.remove('flex');
      document.getElementById('createReturnModal').classList.add('hidden');
    }

    function addReturnItemRow() {
      const tbody = document.getElementById('returnItemsBody');
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="py-2 pr-2">
          <input type="text" name="item_name" placeholder="Item name" required class="w-full bg-black border border-zinc-800 rounded-lg px-2.5 py-1 text-xs text-white focus:outline-none focus:border-yellow-400">
          <input type="hidden" name="item_id" value="101">
        </td>
        <td class="py-2 pr-2">
          <input type="number" step="0.01" name="item_qty" value="1.00" required class="w-full bg-black border border-zinc-800 rounded-lg px-2.5 py-1 text-xs text-white focus:outline-none focus:border-yellow-400">
        </td>
        <td class="py-2 pr-2">
          <input type="text" name="item_unit" value="kg" class="w-full bg-black border border-zinc-800 rounded-lg px-2.5 py-1 text-xs text-white focus:outline-none focus:border-yellow-400">
        </td>
        <td class="py-2 pr-2">
          <input type="text" name="item_reason" placeholder="Reason" class="w-full bg-black border border-zinc-800 rounded-lg px-2.5 py-1 text-xs text-white focus:outline-none focus:border-yellow-400">
        </td>
        <td class="py-2 text-center">
          <button type="button" onclick="removeReturnItemRow(this)" class="text-red-400 font-bold">&times;</button>
        </td>
      `;
      tbody.appendChild(tr);
    }

    function removeReturnItemRow(btn) {
      const tbody = document.getElementById('returnItemsBody');
      if (tbody.children.length > 1) {
        btn.closest('tr').remove();
      } else {
        alert('At least one item must be entered for return.');
      }
    }

    function openResolutionModal(id, returnNumber) {
      document.getElementById('resolutionForm').action = '/supplier-returns/resolve/' + id;
      document.getElementById('resReturnNumber').innerText = returnNumber;
      document.getElementById('resolutionModal').classList.remove('hidden');
      document.getElementById('resolutionModal').classList.add('flex');
    }

    function closeResolutionModal() {
      document.getElementById('resolutionModal').classList.remove('flex');
      document.getElementById('resolutionModal').classList.add('hidden');
    }

    // Auto-open if query param openCreate=true and pre-fill
    const returnParams = new URLSearchParams(window.location.search);
    if (returnParams.get('openCreate') === 'true') {
      openCreateReturnModal();
      if (returnParams.get('supplierId')) {
        const sSelect = document.getElementById('returnSupplierSelect');
        if (sSelect) sSelect.value = returnParams.get('supplierId');
      }
      if (returnParams.get('poId')) {
        const pSelect = document.getElementById('returnPOSelect');
        if (pSelect) pSelect.value = returnParams.get('poId');
      }
    }

    setTimeout(() => {
      const toast = document.getElementById('toastMessage');
      if (toast) {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 400);
      }
    }, 3500);
  </script>

</body>
</html>
