{{> head}}
<body class="bg-black text-gray-100 min-h-screen flex flex-col justify-between">

  <!-- Toast Notification Popups -->
  {{#if successMessage}}
    <div id="toastMessage" class="fixed top-5 right-5 z-50 bg-emerald-950 border border-emerald-800 text-emerald-300 px-6 py-3 rounded-xl shadow-2xl flex items-center space-x-3 transition-all duration-300">
      <i class="fas fa-check-circle text-emerald-400"></i>
      <span class="text-xs font-semibold">{{successMessage}}</span>
    </div>
  {{/if}}
  {{#if errorMessage}}
    <div id="toastMessage" class="fixed top-5 right-5 z-50 bg-red-950 border border-red-800 text-red-300 px-6 py-3 rounded-xl shadow-2xl flex items-center space-x-3 transition-all duration-300">
      <i class="fas fa-exclamation-triangle text-red-400"></i>
      <span class="text-xs font-semibold">{{errorMessage}}</span>
    </div>
  {{/if}}

  <div class="flex flex-1">
    <!-- Master Sidebar -->
    {{> sidebar}}

    <!-- Main Content Area -->
    <main class="flex-1 p-8 overflow-y-auto bg-black">
      
      <!-- Page Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 bg-zinc-900/60 border border-zinc-800/80 p-6 rounded-2xl backdrop-blur-md">
        <div>
          <div class="flex items-center space-x-3">
            <h2 class="text-xl font-bold text-white tracking-wide">Purchase Requests</h2>
            <span class="bg-yellow-400/10 text-yellow-400 border border-yellow-400/30 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
              Module 5
            </span>
          </div>
          <p class="text-xs text-gray-400 mt-1">Submit department supply requisitions, manage approvals, and convert approved requests into official purchase orders.</p>
        </div>
        <div class="flex items-center space-x-3">
          <button onclick="openCreatePRModal()" class="bg-yellow-400 hover:bg-yellow-500 text-black font-bold px-4 py-2.5 rounded-xl text-xs transition shadow-lg flex items-center space-x-2">
            <i class="fas fa-plus"></i>
            <span>New Purchase Request</span>
          </button>
        </div>
      </div>

      <!-- Quick KPI Cards -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-zinc-900/80 border border-zinc-800 p-5 rounded-2xl flex items-center justify-between">
          <div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Total Requisitions</p>
            <h3 class="text-2xl font-bold text-white mt-1">{{totalRequests}}</h3>
          </div>
          <div class="w-10 h-10 rounded-xl bg-yellow-400/10 text-yellow-400 flex items-center justify-center">
            <i class="fas fa-clipboard-list text-base"></i>
          </div>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-800 p-5 rounded-2xl flex items-center justify-between">
          <div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Pending Review</p>
            <h3 class="text-2xl font-bold text-amber-400 mt-1">{{pendingRequests}}</h3>
          </div>
          <div class="w-10 h-10 rounded-xl bg-amber-400/10 text-amber-400 flex items-center justify-center">
            <i class="fas fa-clock text-base"></i>
          </div>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-800 p-5 rounded-2xl flex items-center justify-between">
          <div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Approved Requests</p>
            <h3 class="text-2xl font-bold text-emerald-400 mt-1">{{approvedRequests}}</h3>
          </div>
          <div class="w-10 h-10 rounded-xl bg-emerald-400/10 text-emerald-400 flex items-center justify-center">
            <i class="fas fa-check-circle text-base"></i>
          </div>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-800 p-5 rounded-2xl flex items-center justify-between">
          <div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Converted to PO</p>
            <h3 class="text-2xl font-bold text-blue-400 mt-1">{{convertedRequests}}</h3>
          </div>
          <div class="w-10 h-10 rounded-xl bg-blue-400/10 text-blue-400 flex items-center justify-center">
            <i class="fas fa-file-invoice text-base"></i>
          </div>
        </div>
      </div>

      <!-- Search & Filter Controls -->
      <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 mb-6 shadow-xl flex flex-col md:flex-row items-center justify-between gap-4">
        <form action="/purchase-requests" method="GET" class="flex-1 w-full flex flex-col md:flex-row items-center gap-3">
          <div class="relative flex-1 w-full">
            <i class="fas fa-search absolute left-4 top-3.5 text-gray-500 text-xs"></i>
            <input type="text" name="search" value="{{searchQuery}}" placeholder="Search by PR number or purpose..." class="w-full bg-black border border-zinc-800 rounded-xl pl-10 pr-4 py-2.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-yellow-400 transition">
          </div>
          <div class="flex items-center space-x-2 w-full md:w-auto">
            <select name="departmentId" class="bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400 transition">
              <option value="All">All Departments</option>
              {{#each departments}}
                <option value="{{id}}" {{#eq ../selectedDepartment id}}selected{{/eq}}>{{name}}</option>
              {{/each}}
            </select>
            <select name="status" class="bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400 transition">
              <option value="All" {{#eq statusFilter 'All'}}selected{{/eq}}>All Statuses</option>
              <option value="Pending" {{#eq statusFilter 'Pending'}}selected{{/eq}}>Pending</option>
              <option value="Approved" {{#eq statusFilter 'Approved'}}selected{{/eq}}>Approved</option>
              <option value="Converted to PO" {{#eq statusFilter 'Converted to PO'}}selected{{/eq}}>Converted to PO</option>
              <option value="Rejected" {{#eq statusFilter 'Rejected'}}selected{{/eq}}>Rejected</option>
            </select>
            <select name="priority" class="bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400 transition">
              <option value="All" {{#eq priorityFilter 'All'}}selected{{/eq}}>All Priorities</option>
              <option value="Urgent" {{#eq priorityFilter 'Urgent'}}selected{{/eq}}>Urgent</option>
              <option value="High" {{#eq priorityFilter 'High'}}selected{{/eq}}>High</option>
              <option value="Medium" {{#eq priorityFilter 'Medium'}}selected{{/eq}}>Medium</option>
              <option value="Low" {{#eq priorityFilter 'Low'}}selected{{/eq}}>Low</option>
            </select>
            <button type="submit" class="bg-zinc-800 hover:bg-zinc-700 text-gray-200 font-bold px-4 py-2.5 rounded-xl text-xs transition">
              Filter
            </button>
            {{#if searchQuery}}
              <a href="/purchase-requests" class="text-xs text-gray-400 hover:text-white px-2 py-2">Reset</a>
            {{/if}}
          </div>
        </form>
      </div>

      <!-- Requests Table Section -->
      <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl shadow-xl overflow-hidden mb-8">
        <div class="p-5 border-b border-zinc-800 flex justify-between items-center">
          <h3 class="text-xs font-bold text-yellow-400 uppercase tracking-wider">Department Requisitions Log</h3>
          <span class="text-xs text-gray-500">{{requests.length}} request(s)</span>
        </div>

        {{#if requests.length}}
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead>
                <tr class="border-b border-zinc-800 text-gray-400 uppercase tracking-wider text-[10px] bg-black/40">
                  <th class="py-3 px-4">Request #</th>
                  <th class="py-3 px-4">Date</th>
                  <th class="py-3 px-4">Department</th>
                  <th class="py-3 px-4">Purpose</th>
                  <th class="py-3 px-4 text-center">Priority</th>
                  <th class="py-3 px-4 text-center">Items</th>
                  <th class="py-3 px-4 text-center">Status</th>
                  <th class="py-3 px-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-800/60">
                {{#each requests}}
                  <tr class="hover:bg-zinc-800/40 transition">
                    <td class="py-3.5 px-4 font-mono font-bold text-yellow-400">{{requestNumber}}</td>
                    <td class="py-3.5 px-4 text-gray-400">{{formatDate requestDate}}</td>
                    <td class="py-3.5 px-4">
                      <span class="font-bold text-white">{{Department.name}}</span>
                      <span class="block text-[10px] text-gray-500">by {{Requester.name}}</span>
                    </td>
                    <td class="py-3.5 px-4 text-gray-300 truncate max-w-xs">{{purpose}}</td>
                    <td class="py-3.5 px-4 text-center">
                      {{#eq priority 'Urgent'}}
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-red-950 text-red-400 border border-red-800 animate-pulse">Urgent</span>
                      {{else}}{{#eq priority 'High'}}
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-950 text-amber-400 border border-amber-800">High</span>
                      {{else}}{{#eq priority 'Medium'}}
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-950 text-blue-400 border border-blue-800">Medium</span>
                      {{else}}
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-zinc-800 text-gray-400 border border-zinc-700">Low</span>
                      {{/eq}}{{/eq}}{{/eq}}
                    </td>
                    <td class="py-3.5 px-4 text-center font-mono text-gray-300">
                      {{itemCount}} item(s)
                    </td>
                    <td class="py-3.5 px-4 text-center">
                      {{{statusBadge status}}}
                    </td>
                    <td class="py-3.5 px-4 text-right">
                      <div class="flex items-center justify-end space-x-2">
                        <!-- Inspect Details Button -->
                        <button onclick="viewPRDetails('{{id}}')" class="p-1.5 bg-zinc-800 hover:bg-zinc-700 text-gray-300 hover:text-white rounded-lg transition" title="Inspect Request">
                          <i class="fas fa-eye text-xs"></i>
                        </button>

                        {{#eq status 'Pending'}}
                          <!-- Approve Button -->
                          <form action="/purchase-requests/approve/{{id}}" method="POST" class="inline" onsubmit="return confirm('Approve this purchase request?')">
                            <button type="submit" class="p-1.5 bg-zinc-800 hover:bg-emerald-950 text-emerald-400 rounded-lg transition" title="Approve Request">
                              <i class="fas fa-check text-xs"></i>
                            </button>
                          </form>
                          <!-- Reject Button -->
                          <button onclick="openRejectModal('{{id}}', '{{requestNumber}}')" class="p-1.5 bg-zinc-800 hover:bg-red-950 text-red-400 rounded-lg transition" title="Reject Request">
                            <i class="fas fa-times text-xs"></i>
                          </button>
                        {{/eq}}

                        {{#eq status 'Approved'}}
                          <!-- Convert to PO Button -->
                          <a href="/purchase-orders/create?fromPR={{id}}" class="inline-flex items-center space-x-1 bg-yellow-400 hover:bg-yellow-500 text-black px-2.5 py-1 rounded-lg text-[10px] font-bold transition shadow">
                            <i class="fas fa-file-invoice"></i>
                            <span>Create PO</span>
                          </a>
                        {{/eq}}
                      </div>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{else}}
          <div class="p-12 text-center text-gray-500">
            <i class="fas fa-clipboard-list text-3xl mb-3 text-zinc-700"></i>
            <p class="text-sm">No purchase requests found.</p>
            <button onclick="openCreatePRModal()" class="mt-4 bg-yellow-400 hover:bg-yellow-500 text-black font-bold px-4 py-2 rounded-xl text-xs transition">
              + Submit First Purchase Request
            </button>
          </div>
        {{/if}}
      </div>
    </main>
  </div>

  <!-- Footer -->
  <footer class="bg-zinc-950 border-t border-zinc-800/80 px-8 py-4 text-center text-xs text-gray-600">
    © 2026 DJ's FoodHub. All rights reserved. Supplier Management Module v2.0.
  </footer>

  <!-- ==================== MODALS ==================== -->

  <!-- 1. Create Purchase Request Modal -->
  <div id="createPRModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 w-full max-w-2xl shadow-2xl max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-4 border-b border-zinc-800 pb-3">
        <h3 class="text-sm font-bold text-yellow-400 uppercase tracking-wider flex items-center space-x-2">
          <i class="fas fa-plus-circle"></i>
          <span>Create Department Purchase Request</span>
        </h3>
        <button onclick="closeCreatePRModal()" class="text-gray-400 hover:text-white text-lg font-bold">&times;</button>
      </div>

      <form action="/purchase-requests/add" method="POST" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-400 mb-1">Requesting Department *</label>
            <select name="departmentId" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">
              <option value="">-- Select Department --</option>
              {{#each departments}}
                <option value="{{id}}">{{name}} ({{code}})</option>
              {{/each}}
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-400 mb-1">Priority Level</label>
            <select name="priority" class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">
              <option value="Low">Low Priority</option>
              <option value="Medium" selected>Medium Priority</option>
              <option value="High">High Priority</option>
              <option value="Urgent">Urgent (Immediate Kitchen Need)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1">Business Purpose / Menu Requirement *</label>
          <input type="text" name="purpose" placeholder="e.g. Weekend catering event inventory replenishment" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">
        </div>

        <!-- Dynamic Items Table -->
        <div class="border-t border-zinc-800 pt-4">
          <div class="flex justify-between items-center mb-2">
            <h4 class="text-xs font-bold text-gray-300 uppercase tracking-wider">Requested Line Items</h4>
            <button type="button" onclick="addPRItemRow()" class="text-xs bg-zinc-800 hover:bg-yellow-400 hover:text-black text-yellow-400 font-bold px-3 py-1 rounded-lg transition">
              + Add Item Row
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs" id="prItemsTable">
              <thead>
                <tr class="border-b border-zinc-800 text-gray-400 uppercase text-[10px]">
                  <th class="py-2">Item Name *</th>
                  <th class="py-2 w-24">Qty *</th>
                  <th class="py-2 w-24">Unit</th>
                  <th class="py-2">Remarks</th>
                  <th class="py-2 w-10 text-center"></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-800/40" id="prItemsBody">
                <tr>
                  <td class="py-2 pr-2">
                    <input type="text" name="item_name" placeholder="e.g. Ground Pork" required class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-yellow-400">
                    <input type="hidden" name="item_id" value="101">
                  </td>
                  <td class="py-2 pr-2">
                    <input type="number" step="0.01" name="item_qty" value="10.00" required class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-yellow-400">
                  </td>
                  <td class="py-2 pr-2">
                    <input type="text" name="item_unit" value="kg" class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-yellow-400">
                  </td>
                  <td class="py-2 pr-2">
                    <input type="text" name="item_remarks" placeholder="Fresh cut" class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-yellow-400">
                  </td>
                  <td class="py-2 text-center">
                    <button type="button" onclick="removePRItemRow(this)" class="text-red-400 hover:text-red-300 font-bold">&times;</button>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <div class="flex justify-end space-x-3 pt-4 border-t border-zinc-800">
          <button type="button" onclick="closeCreatePRModal()" class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-gray-300 text-xs font-bold rounded-xl transition">Cancel</button>
          <button type="submit" class="px-5 py-2 bg-yellow-400 hover:bg-yellow-500 text-black text-xs font-bold rounded-xl transition shadow-lg">Submit Requisition</button>
        </div>
      </form>
    </div>
  </div>

  <!-- 2. View PR Details Modal -->
  <div id="viewPRModal" class="fixed inset-0 bg-black/85 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 w-full max-w-2xl shadow-2xl max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-start mb-4 border-b border-zinc-800 pb-3">
        <div>
          <span id="viewPRNumber" class="font-mono text-xs text-yellow-400 font-bold bg-yellow-400/10 border border-yellow-400/20 px-2 py-0.5 rounded">PR-0000</span>
          <h3 id="viewPRDepartment" class="text-base font-bold text-white mt-1">Requisition Details</h3>
        </div>
        <button onclick="closeViewPRModal()" class="text-gray-400 hover:text-white text-lg font-bold">&times;</button>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 bg-black/50 p-4 rounded-xl border border-zinc-800 mb-6 text-xs">
        <div>
          <p class="text-gray-500 text-[10px] uppercase font-semibold">Requested By</p>
          <p id="viewPRRequester" class="text-white font-medium mt-0.5">-</p>
        </div>
        <div>
          <p class="text-gray-500 text-[10px] uppercase font-semibold">Date</p>
          <p id="viewPRDate" class="text-white mt-0.5">-</p>
        </div>
        <div>
          <p class="text-gray-500 text-[10px] uppercase font-semibold">Priority</p>
          <p id="viewPRPriority" class="mt-0.5">-</p>
        </div>
        <div>
          <p class="text-gray-500 text-[10px] uppercase font-semibold">Status</p>
          <p id="viewPRStatus" class="mt-0.5">-</p>
        </div>
        <div class="col-span-full">
          <p class="text-gray-500 text-[10px] uppercase font-semibold">Purpose</p>
          <p id="viewPRPurpose" class="text-gray-300 mt-0.5">-</p>
        </div>
      </div>

      <div id="rejectionSection" class="hidden mb-4 p-3 rounded-xl bg-red-950/80 border border-red-800 text-xs">
        <span class="font-bold text-red-400 uppercase tracking-wider block mb-1">Rejection Reason:</span>
        <p id="viewPRRejectionReason" class="text-red-200"></p>
      </div>

      <div>
        <h4 class="text-xs font-bold text-gray-300 uppercase tracking-wider mb-2">Requested Items</h4>
        <div id="viewPRItemsContainer" class="space-y-1.5">
          <!-- Items injected dynamically -->
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-zinc-800 flex justify-end">
        <button onclick="closeViewPRModal()" class="px-5 py-2 bg-zinc-800 hover:bg-zinc-700 text-white text-xs font-bold rounded-xl transition">
          Close
        </button>
      </div>
    </div>
  </div>

  <!-- 3. Reject PR Modal (Requires reason) -->
  <div id="rejectPRModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 w-full max-w-md shadow-2xl">
      <div class="flex justify-between items-center mb-4 border-b border-zinc-800 pb-3">
        <h3 class="text-sm font-bold text-red-400 uppercase tracking-wider">Reject Purchase Request</h3>
        <button onclick="closeRejectModal()" class="text-gray-400 hover:text-white text-lg font-bold">&times;</button>
      </div>
      <form id="rejectPRForm" action="/purchase-requests/reject/" method="POST" class="space-y-4">
        <p class="text-xs text-gray-300">You are rejecting request <span id="rejectPRNumberSpan" class="font-mono text-yellow-400 font-bold"></span>. Rule: A clear reason must be documented.</p>
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1">Rejection Reason *</label>
          <textarea name="rejectionReason" rows="3" required placeholder="Explain why this request is rejected (e.g. over-budget, excess inventory currently in storeroom)..." class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-red-500"></textarea>
        </div>
        <div class="flex justify-end space-x-3 pt-3 border-t border-zinc-800">
          <button type="button" onclick="closeRejectModal()" class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-gray-300 text-xs font-bold rounded-xl transition">Cancel</button>
          <button type="submit" class="px-5 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-xl transition shadow-lg">Confirm Rejection</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openCreatePRModal() {
      document.getElementById('createPRModal').classList.remove('hidden');
      document.getElementById('createPRModal').classList.add('flex');
    }

    function closeCreatePRModal() {
      document.getElementById('createPRModal').classList.remove('flex');
      document.getElementById('createPRModal').classList.add('hidden');
    }

    function addPRItemRow() {
      const tbody = document.getElementById('prItemsBody');
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="py-2 pr-2">
          <input type="text" name="item_name" placeholder="Item name" required class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-yellow-400">
          <input type="hidden" name="item_id" value="101">
        </td>
        <td class="py-2 pr-2">
          <input type="number" step="0.01" name="item_qty" value="1.00" required class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-yellow-400">
        </td>
        <td class="py-2 pr-2">
          <input type="text" name="item_unit" value="kg" class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-yellow-400">
        </td>
        <td class="py-2 pr-2">
          <input type="text" name="item_remarks" placeholder="Optional notes" class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-yellow-400">
        </td>
        <td class="py-2 text-center">
          <button type="button" onclick="removePRItemRow(this)" class="text-red-400 hover:text-red-300 font-bold">&times;</button>
        </td>
      `;
      tbody.appendChild(tr);
    }

    function removePRItemRow(btn) {
      const row = btn.closest('tr');
      const tbody = document.getElementById('prItemsBody');
      if (tbody.children.length > 1) {
        row.remove();
      } else {
        alert('A purchase request must have at least one line item.');
      }
    }

    async function viewPRDetails(id) {
      try {
        const response = await fetch('/api/purchase-requests/' + id);
        const data = await response.json();
        if (!data.success) return alert('Failed to load request');

        const pr = data.request;
        document.getElementById('viewPRNumber').innerText = pr.requestNumber;
        document.getElementById('viewPRDepartment').innerText = pr.Department ? pr.Department.name + ' Requisition' : 'Requisition';
        document.getElementById('viewPRRequester').innerText = pr.Requester ? pr.Requester.name : 'Unknown';
        document.getElementById('viewPRDate').innerText = pr.requestDate;
        document.getElementById('viewPRPriority').innerText = pr.priority;
        document.getElementById('viewPRStatus').innerText = pr.status;
        document.getElementById('viewPRPurpose').innerText = pr.purpose;

        const rejSec = document.getElementById('rejectionSection');
        if (pr.status === 'Rejected' && pr.rejectionReason) {
          document.getElementById('viewPRRejectionReason').innerText = pr.rejectionReason;
          rejSec.classList.remove('hidden');
        } else {
          rejSec.classList.add('hidden');
        }

        const itemsContainer = document.getElementById('viewPRItemsContainer');
        const items = pr.Items || [];
        itemsContainer.innerHTML = items.map(item => `
          <div class="flex justify-between items-center bg-black/40 border border-zinc-800 px-3 py-2 rounded-xl text-xs">
            <div>
              <span class="font-bold text-white">${item.productName}</span>
              ${item.remarks ? `<span class="text-gray-400 text-[10px] ml-2 italic">(${item.remarks})</span>` : ''}
            </div>
            <span class="font-mono text-yellow-400 font-bold">${item.quantity} ${item.unit}</span>
          </div>
        `).join('');

        document.getElementById('viewPRModal').classList.remove('hidden');
        document.getElementById('viewPRModal').classList.add('flex');
      } catch (e) {
        console.error(e);
        alert('Error fetching request details.');
      }
    }

    function closeViewPRModal() {
      document.getElementById('viewPRModal').classList.remove('flex');
      document.getElementById('viewPRModal').classList.add('hidden');
    }

    function openRejectModal(id, requestNumber) {
      document.getElementById('rejectPRForm').action = '/purchase-requests/reject/' + id;
      document.getElementById('rejectPRNumberSpan').innerText = requestNumber;
      document.getElementById('rejectPRModal').classList.remove('hidden');
      document.getElementById('rejectPRModal').classList.add('flex');
    }

    function closeRejectModal() {
      document.getElementById('rejectPRModal').classList.remove('flex');
      document.getElementById('rejectPRModal').classList.add('hidden');
    }

    setTimeout(() => {
      const toast = document.getElementById('toastMessage');
      if (toast) {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 400);
      }
    }, 3500);
  </script>

</body>
</html>
