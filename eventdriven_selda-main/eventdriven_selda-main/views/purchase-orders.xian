{{> head}}
<body class="bg-black text-gray-100 min-h-screen flex flex-col justify-between">

  <!-- Toast Notification Popups -->
  {{#if successMessage}}
    <div id="toastMessage" class="fixed top-5 right-5 z-50 bg-emerald-950 border border-emerald-800 text-emerald-300 px-6 py-3 rounded-xl shadow-2xl flex items-center space-x-3 transition-all duration-300">
      <i class="fas fa-check-circle text-emerald-400"></i>
      <span class="text-xs font-semibold">{{successMessage}}</span>
    </div>
  {{/if}}
  {{#if errorMessage}}
    <div id="toastMessage" class="fixed top-5 right-5 z-50 bg-red-950 border border-red-800 text-red-300 px-6 py-3 rounded-xl shadow-2xl flex items-center space-x-3 transition-all duration-300">
      <i class="fas fa-exclamation-triangle text-red-400"></i>
      <span class="text-xs font-semibold">{{errorMessage}}</span>
    </div>
  {{/if}}

  <div class="flex flex-1">
    <!-- Master Sidebar -->
    {{> sidebar}}

    <!-- Main Content Area -->
    <main class="flex-1 p-8 overflow-y-auto bg-black">
      
      <!-- Page Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 bg-zinc-900/60 border border-zinc-800/80 p-6 rounded-2xl backdrop-blur-md">
        <div>
          <div class="flex items-center space-x-3">
            <h2 class="text-xl font-bold text-white tracking-wide">Purchase Orders</h2>
            <span class="bg-yellow-400/10 text-yellow-400 border border-yellow-400/30 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
              Module 6
            </span>
          </div>
          <p class="text-xs text-gray-400 mt-1">Issue binding vendor orders, authorize purchases, track shipment statuses, and generate official printable PO vouchers.</p>
        </div>
        <div class="flex items-center space-x-3">
          <a href="/purchase-orders/create" class="bg-yellow-400 hover:bg-yellow-500 text-black font-bold px-4 py-2.5 rounded-xl text-xs transition shadow-lg flex items-center space-x-2">
            <i class="fas fa-plus"></i>
            <span>Create Purchase Order</span>
          </a>
        </div>
      </div>

      <!-- Quick KPI Cards -->
      <div class="grid grid-cols-2 md:grid-cols-6 gap-3 mb-8">
        <div class="bg-zinc-900/80 border border-zinc-800 p-4 rounded-xl">
          <p class="text-[9px] font-semibold text-gray-400 uppercase tracking-wider">Total Orders</p>
          <h3 class="text-xl font-bold text-white mt-0.5">{{totalOrders}}</h3>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-800 p-4 rounded-xl">
          <p class="text-[9px] font-semibold text-gray-400 uppercase tracking-wider">Pending Approval</p>
          <h3 class="text-xl font-bold text-amber-400 mt-0.5">{{pendingApprovalOrders}}</h3>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-800 p-4 rounded-xl">
          <p class="text-[9px] font-semibold text-gray-400 uppercase tracking-wider">Approved Orders</p>
          <h3 class="text-xl font-bold text-emerald-400 mt-0.5">{{approvedOrders}}</h3>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-800 p-4 rounded-xl">
          <p class="text-[9px] font-semibold text-gray-400 uppercase tracking-wider">Sent to Vendor</p>
          <h3 class="text-xl font-bold text-blue-400 mt-0.5">{{sentOrders}}</h3>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-800 p-4 rounded-xl">
          <p class="text-[9px] font-semibold text-gray-400 uppercase tracking-wider">Partial Delivery</p>
          <h3 class="text-xl font-bold text-purple-400 mt-0.5">{{partiallyReceived}}</h3>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-800 p-4 rounded-xl">
          <p class="text-[9px] font-semibold text-gray-400 uppercase tracking-wider">Completed POs</p>
          <h3 class="text-xl font-bold text-teal-400 mt-0.5">{{fullyReceived}}</h3>
        </div>
      </div>

      <!-- Search & Filter Controls -->
      <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 mb-6 shadow-xl flex flex-col md:flex-row items-center justify-between gap-4">
        <form action="/purchase-orders" method="GET" class="flex-1 w-full flex flex-col md:flex-row items-center gap-3">
          <div class="relative flex-1 w-full">
            <i class="fas fa-search absolute left-4 top-3.5 text-gray-500 text-xs"></i>
            <input type="text" name="search" value="{{searchQuery}}" placeholder="Search PO number or notes..." class="w-full bg-black border border-zinc-800 rounded-xl pl-10 pr-4 py-2.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-yellow-400 transition">
          </div>
          <div class="flex items-center space-x-2 w-full md:w-auto">
            <select name="supplierId" class="bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400 transition">
              <option value="All">All Suppliers</option>
              {{#each suppliers}}
                <option value="{{id}}" {{#eq ../selectedSupplier id}}selected{{/eq}}>{{name}}</option>
              {{/each}}
            </select>
            <select name="departmentId" class="bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400 transition">
              <option value="All">All Departments</option>
              {{#each departments}}
                <option value="{{id}}" {{#eq ../selectedDepartment id}}selected{{/eq}}>{{name}}</option>
              {{/each}}
            </select>
            <select name="status" class="bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400 transition">
              <option value="All" {{#eq statusFilter 'All'}}selected{{/eq}}>All Statuses</option>
              <option value="Draft" {{#eq statusFilter 'Draft'}}selected{{/eq}}>Draft</option>
              <option value="Pending Approval" {{#eq statusFilter 'Pending Approval'}}selected{{/eq}}>Pending Approval</option>
              <option value="Approved" {{#eq statusFilter 'Approved'}}selected{{/eq}}>Approved</option>
              <option value="Sent to Supplier" {{#eq statusFilter 'Sent to Supplier'}}selected{{/eq}}>Sent to Supplier</option>
              <option value="Partially Received" {{#eq statusFilter 'Partially Received'}}selected{{/eq}}>Partially Received</option>
              <option value="Fully Received" {{#eq statusFilter 'Fully Received'}}selected{{/eq}}>Fully Received</option>
              <option value="Cancelled" {{#eq statusFilter 'Cancelled'}}selected{{/eq}}>Cancelled</option>
            </select>
            <button type="submit" class="bg-zinc-800 hover:bg-zinc-700 text-gray-200 font-bold px-4 py-2.5 rounded-xl text-xs transition">
              Filter
            </button>
            {{#if searchQuery}}
              <a href="/purchase-orders" class="text-xs text-gray-400 hover:text-white px-2 py-2">Reset</a>
            {{/if}}
          </div>
        </form>
      </div>

      <!-- Purchase Orders Table -->
      <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl shadow-xl overflow-hidden mb-8">
        <div class="p-5 border-b border-zinc-800 flex justify-between items-center">
          <h3 class="text-xs font-bold text-yellow-400 uppercase tracking-wider">Purchase Orders Registry</h3>
          <span class="text-xs text-gray-500">{{orders.length}} order(s)</span>
        </div>

        {{#if orders.length}}
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead>
                <tr class="border-b border-zinc-800 text-gray-400 uppercase tracking-wider text-[10px] bg-black/40">
                  <th class="py-3 px-4">PO Number</th>
                  <th class="py-3 px-4">Date</th>
                  <th class="py-3 px-4">Supplier</th>
                  <th class="py-3 px-4">Department</th>
                  <th class="py-3 px-4 text-center">Items</th>
                  <th class="py-3 px-4">Total Amount</th>
                  <th class="py-3 px-4 text-center">Status</th>
                  <th class="py-3 px-4 text-right">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-800/60">
                {{#each orders}}
                  <tr class="hover:bg-zinc-800/40 transition">
                    <td class="py-3.5 px-4 font-mono font-bold text-yellow-400">
                      <a href="/purchase-orders/view/{{id}}" class="hover:underline">{{poNumber}}</a>
                      {{#if PurchaseRequest}}
                        <span class="block text-[9px] text-gray-500 font-mono">from {{PurchaseRequest.requestNumber}}</span>
                      {{/if}}
                    </td>
                    <td class="py-3.5 px-4 text-gray-300">
                      <p>{{formatDate orderDate}}</p>
                      {{#if expectedDeliveryDate}}
                        <p class="text-[10px] text-gray-500">Exp: {{formatDate expectedDeliveryDate}}</p>
                      {{/if}}
                    </td>
                    <td class="py-3.5 px-4">
                      <span class="font-bold text-white">{{Supplier.name}}</span>
                      <span class="block text-[10px] text-gray-400 font-mono">{{paymentTerms}}</span>
                    </td>
                    <td class="py-3.5 px-4 text-gray-300">{{Department.name}}</td>
                    <td class="py-3.5 px-4 text-center font-mono text-gray-300">
                      {{itemCount}} item(s)
                    </td>
                    <td class="py-3.5 px-4 font-mono font-bold text-sm text-yellow-400">
                      {{formatCurrency totalAmount}}
                    </td>
                    <td class="py-3.5 px-4 text-center">
                      {{{statusBadge status}}}
                    </td>
                    <td class="py-3.5 px-4 text-right">
                      <div class="flex items-center justify-end space-x-1.5">
                        <!-- View Order Voucher -->
                        <a href="/purchase-orders/view/{{id}}" class="p-1.5 bg-zinc-800 hover:bg-zinc-700 text-gray-300 hover:text-white rounded-lg transition" title="View & Print Voucher">
                          <i class="fas fa-file-invoice text-xs"></i>
                        </a>

                        {{#eq status 'Draft'}}
                          <!-- Approve Order -->
                          <form action="/purchase-orders/approve/{{id}}" method="POST" class="inline" onsubmit="return confirm('Authorize and approve this Purchase Order?')">
                            <button type="submit" class="p-1.5 bg-zinc-800 hover:bg-emerald-950 text-emerald-400 rounded-lg transition" title="Approve PO">
                              <i class="fas fa-check text-xs"></i>
                            </button>
                          </form>
                        {{/eq}}

                        {{#eq status 'Pending Approval'}}
                          <!-- Approve Order -->
                          <form action="/purchase-orders/approve/{{id}}" method="POST" class="inline" onsubmit="return confirm('Authorize and approve this Purchase Order?')">
                            <button type="submit" class="p-1.5 bg-zinc-800 hover:bg-emerald-950 text-emerald-400 rounded-lg transition" title="Approve PO">
                              <i class="fas fa-check text-xs"></i>
                            </button>
                          </form>
                        {{/eq}}

                        {{#eq status 'Approved'}}
                          <!-- Send to Supplier -->
                          <form action="/purchase-orders/send/{{id}}" method="POST" class="inline" onsubmit="return confirm('Mark Purchase Order as Sent to Supplier?')">
                            <button type="submit" class="p-1.5 bg-zinc-800 hover:bg-blue-950 text-blue-400 rounded-lg transition" title="Mark Sent to Supplier">
                              <i class="fas fa-paper-plane text-xs"></i>
                            </button>
                          </form>
                        {{/eq}}

                        {{#if (eq status 'Sent to Supplier')}}
                          <!-- Receive Shipment Shortcut -->
                          <a href="/goods-receipts/receive?poId={{id}}" class="p-1.5 bg-zinc-800 hover:bg-yellow-950 text-yellow-400 rounded-lg transition" title="Receive this Delivery">
                            <i class="fas fa-dolly text-xs"></i>
                          </a>
                        {{/if}}

                        {{#if (eq status 'Partially Received')}}
                          <!-- Receive Additional Delivery Shortcut -->
                          <a href="/goods-receipts/receive?poId={{id}}" class="p-1.5 bg-zinc-800 hover:bg-purple-950 text-purple-400 rounded-lg transition" title="Receive Remaining Balance">
                            <i class="fas fa-dolly text-xs"></i>
                          </a>
                        {{/if}}

                        {{#if (neq status 'Fully Received')}}
                          {{#if (neq status 'Cancelled')}}
                            <button onclick="openCancelPOModal('{{id}}', '{{poNumber}}')" class="p-1.5 bg-zinc-800 hover:bg-red-950 text-gray-500 hover:text-red-400 rounded-lg transition" title="Cancel Order">
                              <i class="fas fa-ban text-xs"></i>
                            </button>
                          {{/if}}
                        {{/if}}
                      </div>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{else}}
          <div class="p-12 text-center text-gray-500">
            <i class="fas fa-file-invoice text-3xl mb-3 text-zinc-700"></i>
            <p class="text-sm">No purchase orders found.</p>
            <a href="/purchase-orders/create" class="mt-4 inline-block bg-yellow-400 hover:bg-yellow-500 text-black font-bold px-4 py-2 rounded-xl text-xs transition">
              + Create First Purchase Order
            </a>
          </div>
        {{/if}}
      </div>
    </main>
  </div>

  <!-- Cancel Modal -->
  <div id="cancelPOModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 w-full max-w-md shadow-2xl">
      <div class="flex justify-between items-center mb-4 border-b border-zinc-800 pb-3">
        <h3 class="text-sm font-bold text-red-400 uppercase tracking-wider">Cancel Purchase Order</h3>
        <button onclick="closeCancelPOModal()" class="text-gray-400 hover:text-white text-lg font-bold">&times;</button>
      </div>
      <form id="cancelPOForm" action="/purchase-orders/cancel/" method="POST" class="space-y-4">
        <p class="text-xs text-gray-300">Are you sure you want to cancel order <span id="cancelPONumberSpan" class="font-mono text-yellow-400 font-bold"></span>?</p>
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1">Cancellation Reason</label>
          <textarea name="reason" rows="3" required placeholder="Explain reason for cancellation..." class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-red-500"></textarea>
        </div>
        <div class="flex justify-end space-x-3 pt-3 border-t border-zinc-800">
          <button type="button" onclick="closeCancelPOModal()" class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-gray-300 text-xs font-bold rounded-xl transition">Back</button>
          <button type="submit" class="px-5 py-2 bg-red-600 hover:bg-red-700 text-white text-xs font-bold rounded-xl transition shadow-lg">Confirm Cancellation</button>
        </div>
      </form>
    </div>
  </div>

  <footer class="bg-zinc-950 border-t border-zinc-800/80 px-8 py-4 text-center text-xs text-gray-600">
    © 2026 DJ's FoodHub. All rights reserved. Supplier Management Module v2.0.
  </footer>

  <script>
    function openCancelPOModal(id, poNumber) {
      document.getElementById('cancelPOForm').action = '/purchase-orders/cancel/' + id;
      document.getElementById('cancelPONumberSpan').innerText = poNumber;
      document.getElementById('cancelPOModal').classList.remove('hidden');
      document.getElementById('cancelPOModal').classList.add('flex');
    }

    function closeCancelPOModal() {
      document.getElementById('cancelPOModal').classList.remove('flex');
      document.getElementById('cancelPOModal').classList.add('hidden');
    }

    setTimeout(() => {
      const toast = document.getElementById('toastMessage');
      if (toast) {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 400);
      }
    }, 3500);
  </script>

</body>
</html>
