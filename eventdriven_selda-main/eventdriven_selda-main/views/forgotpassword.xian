{{> head}}
<body class="bg-black text-gray-100 flex flex-col justify-between min-h-screen">

  <!-- Top Bar with Theme Toggle -->
  <div class="p-6 flex justify-between items-center max-w-7xl mx-auto w-full">
    <div class="flex items-center space-x-2">
      <img src="/images/logo.png" alt="DJ's FoodHub" class="w-8 h-8 object-contain">
      <span class="font-bold text-yellow-400 text-sm tracking-wide">DJ's FoodHub</span>
    </div>

    <!-- Theme Toggle Icon Button -->
    <button onclick="toggleTheme()" type="button" class="theme-toggle-btn p-2.5 rounded-xl border border-zinc-700 bg-zinc-900 hover:bg-zinc-800 transition shadow flex items-center justify-center" title="Toggle Theme">
      <i class="themeToggleIcon fas fa-moon text-yellow-400"></i>
    </button>
  </div>

  <!-- Center Card Container -->
  <div class="flex items-center justify-center p-6 my-auto">
    <div class="w-full max-w-md bg-zinc-900/90 border border-zinc-800 rounded-3xl p-8 shadow-2xl backdrop-blur-md text-center">
      
      <!-- Official Logo / Brand Section -->
      <div class="flex flex-col items-center mb-6">
        <img src="/images/logo.png" alt="DJ's FoodHub Logo" class="w-20 h-20 object-contain rounded-2xl bg-black/60 p-2 border-2 border-yellow-400/80 shadow-2xl mb-3">
        <h1 class="text-xl font-black text-yellow-400 tracking-wide">PASSWORD RECOVERY</h1>
        <p class="text-xs text-gray-400 mt-1 uppercase tracking-wider font-semibold">DJ's FoodHub System Security</p>
      </div>

      <div class="bg-black/50 border border-zinc-800 rounded-2xl p-4 text-xs text-gray-300 space-y-2 mb-6">
        <i class="fas fa-key text-yellow-400 text-2xl mb-1"></i>
        <p>For password resets and role permissions, please coordinate directly with the DJYum System Administrator or Department Head.</p>
        <p class="text-[11px] text-gray-500 font-mono">admin@gmail.com</p>
      </div>

      <a href="/login" class="inline-flex items-center space-x-2 bg-yellow-400 hover:bg-yellow-500 text-black font-bold px-6 py-2.5 rounded-xl text-xs transition shadow-lg">
        <i class="fas fa-arrow-left"></i>
        <span>Return to Sign In</span>
      </a>

      <div class="mt-6 border-t border-zinc-800/80 pt-4">
        <p class="text-[11px] text-gray-500 font-mono">DJYum Enterprise Integrated Suite &bull; 2026</p>
      </div>
    </div>
  </div>

  <!-- Bottom Footer -->
  <footer class="py-6 text-center text-xs text-gray-500 tracking-wide">
    &copy; 2026 XianFire Framework &bull; Mindoro State University
  </footer>

</body>
</html>
