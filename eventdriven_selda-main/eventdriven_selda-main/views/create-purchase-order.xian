{{> head}}
<body class="bg-black text-gray-100 min-h-screen flex flex-col justify-between">

  <!-- Toast Notification Popups -->
  {{#if errorMessage}}
    <div id="toastMessage" class="fixed top-5 right-5 z-50 bg-red-950 border border-red-800 text-red-300 px-6 py-3 rounded-xl shadow-2xl flex items-center space-x-3 transition-all duration-300">
      <i class="fas fa-exclamation-triangle text-red-400"></i>
      <span class="text-xs font-semibold">{{errorMessage}}</span>
    </div>
  {{/if}}

  <div class="flex flex-1">
    <!-- Master Sidebar -->
    {{> sidebar}}

    <!-- Main Content Area -->
    <main class="flex-1 p-8 overflow-y-auto bg-black">
      
      <!-- Page Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 bg-zinc-900/60 border border-zinc-800/80 p-6 rounded-2xl backdrop-blur-md">
        <div>
          <div class="flex items-center space-x-3">
            <h2 class="text-xl font-bold text-white tracking-wide">Create Purchase Order</h2>
            {{#if prefilledPR}}
              <span class="bg-blue-400/10 text-blue-400 border border-blue-400/30 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                Converting from {{prefilledPR.requestNumber}}
              </span>
            {{else}}
              <span class="bg-yellow-400/10 text-yellow-400 border border-yellow-400/30 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
                New PO
              </span>
            {{/if}}
          </div>
          <p class="text-xs text-gray-400 mt-1">Generate a legally binding purchase order with real-time price snapshot calculations.</p>
        </div>
        <a href="/purchase-orders" class="text-xs bg-zinc-800 hover:bg-zinc-700 text-gray-300 font-bold px-4 py-2.5 rounded-xl transition">
          <i class="fas fa-arrow-left mr-1.5"></i> Back to Orders
        </a>
      </div>

      <!-- PO Form Card -->
      <form action="/purchase-orders/create" method="POST" class="space-y-6">
        {{#if prefilledPR}}
          <input type="hidden" name="purchaseRequestId" value="{{prefilledPR.id}}">
        {{/if}}

        <!-- Top Header Details -->
        <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-6 shadow-xl">
          <h3 class="text-xs font-bold text-yellow-400 uppercase tracking-wider mb-4 border-b border-zinc-800 pb-2">
            1. Order General Information
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
              <label class="block text-xs font-semibold text-gray-400 mb-1">Target Supplier *</label>
              <select name="supplierId" id="supplierSelect" onchange="onSupplierChange()" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400">
                <option value="">-- Select Active Vendor --</option>
                {{#each suppliers}}
                  <option value="{{id}}" data-terms="{{paymentTerms}}">{{name}} ({{supplierCode}})</option>
                {{/each}}
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-400 mb-1">Charging Department *</label>
              <select name="departmentId" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400">
                <option value="">-- Select Department --</option>
                {{#each departments}}
                  <option value="{{id}}" {{#eq ../prefilledPR.departmentId id}}selected{{/eq}}>{{name}} ({{code}})</option>
                {{/each}}
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-400 mb-1">Order Date *</label>
              <input type="date" name="orderDate" id="orderDateInput" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-400 mb-1">Expected Delivery Date</label>
              <input type="date" name="expectedDeliveryDate" class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-400 mb-1">Payment Terms</label>
              <input type="text" name="paymentTerms" id="paymentTermsInput" value="Net 30" class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-400 mb-1">Initial Status</label>
              <select name="status" class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">
                <option value="Draft" selected>Save as Draft</option>
                <option value="Pending Approval">Submit for Manager Approval</option>
                <option value="Approved">Direct Approve</option>
              </select>
            </div>

            <div class="md:col-span-2">
              <label class="block text-xs font-semibold text-gray-400 mb-1">Order Notes / Delivery Instructions</label>
              <input type="text" name="notes" placeholder="e.g. Deliver to back kitchen gate between 8am-10am" class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">
            </div>
          </div>
        </div>

        <!-- Line Items Section -->
        <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-6 shadow-xl">
          <div class="flex justify-between items-center mb-4 border-b border-zinc-800 pb-2">
            <div>
              <h3 class="text-xs font-bold text-yellow-400 uppercase tracking-wider">
                2. Purchase Order Line Items
              </h3>
              <p class="text-[11px] text-gray-500">Unit prices will be saved as immutable historical snapshots.</p>
            </div>
            <button type="button" onclick="addPOItemRow()" class="text-xs bg-zinc-800 hover:bg-yellow-400 hover:text-black text-yellow-400 font-bold px-3 py-1.5 rounded-xl transition flex items-center space-x-1">
              <i class="fas fa-plus"></i>
              <span>Add Product Row</span>
            </button>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs" id="poItemsTable">
              <thead>
                <tr class="border-b border-zinc-800 text-gray-400 uppercase text-[10px] bg-black/40">
                  <th class="py-2.5 px-3">Product Name *</th>
                  <th class="py-2.5 px-3 w-28">Quantity *</th>
                  <th class="py-2.5 px-3 w-24">Unit</th>
                  <th class="py-2.5 px-3 w-32">Unit Price (₱) *</th>
                  <th class="py-2.5 px-3 w-32 text-right">Subtotal</th>
                  <th class="py-2.5 px-2 w-10 text-center"></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-800/40" id="poItemsBody">
                {{#if prefilledPR.Items.length}}
                  {{#each prefilledPR.Items}}
                    <tr>
                      <td class="py-2.5 px-3">
                        <input type="text" name="item_name" value="{{productName}}" required class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-yellow-400">
                        <input type="hidden" name="item_id" value="{{productId}}">
                      </td>
                      <td class="py-2.5 px-3">
                        <input type="number" step="0.01" name="item_qty" value="{{quantity}}" oninput="recalcRow(this)" required class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:outline-none focus:border-yellow-400">
                      </td>
                      <td class="py-2.5 px-3">
                        <input type="text" name="item_unit" value="{{unit}}" class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-yellow-400">
                      </td>
                      <td class="py-2.5 px-3">
                        <input type="number" step="0.01" name="item_price" value="0.00" oninput="recalcRow(this)" required class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:outline-none focus:border-yellow-400">
                      </td>
                      <td class="py-2.5 px-3 text-right font-mono font-bold text-yellow-400 row-subtotal">
                        ₱0.00
                      </td>
                      <td class="py-2.5 px-2 text-center">
                        <button type="button" onclick="removePOItemRow(this)" class="text-red-400 hover:text-red-300 font-bold">&times;</button>
                      </td>
                    </tr>
                  {{/each}}
                {{else}}
                  <tr>
                    <td class="py-2.5 px-3">
                      <input type="text" name="item_name" placeholder="e.g. Ground Pork (70/30)" required class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-yellow-400">
                      <input type="hidden" name="item_id" value="101">
                    </td>
                    <td class="py-2.5 px-3">
                      <input type="number" step="0.01" name="item_qty" value="10.00" oninput="recalcRow(this)" required class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:outline-none focus:border-yellow-400">
                    </td>
                    <td class="py-2.5 px-3">
                      <input type="text" name="item_unit" value="kg" class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-yellow-400">
                    </td>
                    <td class="py-2.5 px-3">
                      <input type="number" step="0.01" name="item_price" value="280.00" oninput="recalcRow(this)" required class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:outline-none focus:border-yellow-400">
                    </td>
                    <td class="py-2.5 px-3 text-right font-mono font-bold text-yellow-400 row-subtotal">
                      ₱2,800.00
                    </td>
                    <td class="py-2.5 px-2 text-center">
                      <button type="button" onclick="removePOItemRow(this)" class="text-red-400 hover:text-red-300 font-bold">&times;</button>
                    </td>
                  </tr>
                {{/if}}
              </tbody>
            </table>
          </div>

          <!-- Grand Total Summary Box -->
          <div class="mt-6 flex flex-col md:flex-row justify-between items-center bg-black/50 p-4 rounded-xl border border-zinc-800">
            <span class="text-xs text-gray-400">Total Purchase Commitment</span>
            <div class="text-right mt-2 md:mt-0">
              <span class="text-xs text-gray-500 uppercase mr-2 font-semibold">Grand Total:</span>
              <span id="grandTotalDisplay" class="font-mono text-2xl font-bold text-yellow-400">₱0.00</span>
            </div>
          </div>
        </div>

        <div class="flex justify-end space-x-3 pt-2">
          <a href="/purchase-orders" class="px-5 py-2.5 bg-zinc-800 hover:bg-zinc-700 text-gray-300 text-xs font-bold rounded-xl transition">
            Cancel
          </a>
          <button type="submit" class="px-6 py-2.5 bg-yellow-400 hover:bg-yellow-500 text-black text-xs font-bold rounded-xl transition shadow-lg flex items-center space-x-2">
            <i class="fas fa-check"></i>
            <span>Confirm & Issue Purchase Order</span>
          </button>
        </div>
      </form>
    </main>
  </div>

  <footer class="bg-zinc-950 border-t border-zinc-800/80 px-8 py-4 text-center text-xs text-gray-600">
    © 2026 DJ's FoodHub. All rights reserved. Supplier Management Module v2.0.
  </footer>

  <script>
    // Set today's date on orderDate input if empty
    document.addEventListener('DOMContentLoaded', () => {
      const dateInput = document.getElementById('orderDateInput');
      if (!dateInput.value) {
        dateInput.value = new Date().toISOString().split('T')[0];
      }
      recalculateAll();
    });

    function onSupplierChange() {
      const select = document.getElementById('supplierSelect');
      const terms = select.options[select.selectedIndex].getAttribute('data-terms');
      if (terms) {
        document.getElementById('paymentTermsInput').value = terms;
      }
    }

    function recalcRow(input) {
      const row = input.closest('tr');
      const qtyInput = row.querySelector('input[name="item_qty"]');
      const priceInput = row.querySelector('input[name="item_price"]');
      const subtotalCell = row.querySelector('.row-subtotal');

      const qty = parseFloat(qtyInput.value) || 0;
      const price = parseFloat(priceInput.value) || 0;
      const subtotal = qty * price;

      subtotalCell.innerText = '₱' + subtotal.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      recalculateAll();
    }

    function recalculateAll() {
      let total = 0;
      const rows = document.querySelectorAll('#poItemsBody tr');
      rows.forEach(row => {
        const qty = parseFloat(row.querySelector('input[name="item_qty"]')?.value) || 0;
        const price = parseFloat(row.querySelector('input[name="item_price"]')?.value) || 0;
        total += (qty * price);
      });
      document.getElementById('grandTotalDisplay').innerText = '₱' + total.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function addPOItemRow() {
      const tbody = document.getElementById('poItemsBody');
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="py-2.5 px-3">
          <input type="text" name="item_name" placeholder="Item name" required class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-yellow-400">
          <input type="hidden" name="item_id" value="101">
        </td>
        <td class="py-2.5 px-3">
          <input type="number" step="0.01" name="item_qty" value="1.00" oninput="recalcRow(this)" required class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:outline-none focus:border-yellow-400">
        </td>
        <td class="py-2.5 px-3">
          <input type="text" name="item_unit" value="kg" class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-yellow-400">
        </td>
        <td class="py-2.5 px-3">
          <input type="number" step="0.01" name="item_price" value="0.00" oninput="recalcRow(this)" required class="w-full bg-black border border-zinc-800 rounded-lg px-3 py-1.5 text-xs text-white font-mono focus:outline-none focus:border-yellow-400">
        </td>
        <td class="py-2.5 px-3 text-right font-mono font-bold text-yellow-400 row-subtotal">
          ₱0.00
        </td>
        <td class="py-2.5 px-2 text-center">
          <button type="button" onclick="removePOItemRow(this)" class="text-red-400 hover:text-red-300 font-bold">&times;</button>
        </td>
      `;
      tbody.appendChild(tr);
    }

    function removePOItemRow(btn) {
      const tbody = document.getElementById('poItemsBody');
      if (tbody.children.length > 1) {
        btn.closest('tr').remove();
        recalculateAll();
      } else {
        alert('A purchase order must have at least one line item.');
      }
    }
  </script>

</body>
</html>
