{{> head}}
<body class="bg-black text-gray-100 min-h-screen flex flex-col justify-between">

  <!-- Toast Notification Popups -->
  {{#if successMessage}}
    <div id="toastMessage" class="fixed top-5 right-5 z-50 bg-emerald-950 border border-emerald-800 text-emerald-300 px-6 py-3 rounded-xl shadow-2xl flex items-center space-x-3 transition-all duration-300">
      <i class="fas fa-check-circle text-emerald-400"></i>
      <span class="text-xs font-semibold">{{successMessage}}</span>
    </div>
  {{/if}}
  {{#if errorMessage}}
    <div id="toastMessage" class="fixed top-5 right-5 z-50 bg-red-950 border border-red-800 text-red-300 px-6 py-3 rounded-xl shadow-2xl flex items-center space-x-3 transition-all duration-300">
      <i class="fas fa-exclamation-triangle text-red-400"></i>
      <span class="text-xs font-semibold">{{errorMessage}}</span>
    </div>
  {{/if}}

  <div class="flex flex-1">
    <!-- Master Sidebar -->
    {{> sidebar}}

    <!-- Main Content Area -->
    <main class="flex-1 p-8 overflow-y-auto bg-black">
      
      <!-- Page Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 bg-zinc-900/60 border border-zinc-800/80 p-6 rounded-2xl backdrop-blur-md">
        <div>
          <div class="flex items-center space-x-3">
            <h2 class="text-xl font-bold text-white tracking-wide">Supplier Performance & Quality Scoring</h2>
            <span class="bg-yellow-400/10 text-yellow-400 border border-yellow-400/30 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
              Module 11
            </span>
          </div>
          <p class="text-xs text-gray-400 mt-1">Multi-factor vendor evaluations: On-time delivery, fulfillment accuracy, defect rates, and purchasing recommendations.</p>
        </div>
        <div class="flex items-center space-x-3">
          <button onclick="window.print()" class="bg-zinc-800 hover:bg-zinc-700 text-white font-bold px-4 py-2.5 rounded-xl text-xs transition border border-zinc-700 flex items-center space-x-2">
            <i class="fas fa-print"></i>
            <span>Print Scorecard</span>
          </button>
        </div>
      </div>

      <!-- Quick KPI Cards -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-zinc-900/80 border border-zinc-800 p-5 rounded-2xl flex items-center justify-between">
          <div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Vendors Evaluated</p>
            <h3 class="text-2xl font-bold text-white mt-1">{{totalSuppliersCount}}</h3>
          </div>
          <div class="w-10 h-10 rounded-xl bg-yellow-400/10 text-yellow-400 flex items-center justify-center">
            <i class="fas fa-truck text-base"></i>
          </div>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-800 p-5 rounded-2xl flex items-center justify-between">
          <div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Total Spend Audited</p>
            <h3 class="text-2xl font-bold text-emerald-400 mt-1 font-mono">₱{{formatCurrency totalNetworkSpend}}</h3>
          </div>
          <div class="w-10 h-10 rounded-xl bg-emerald-400/10 text-emerald-400 flex items-center justify-center">
            <i class="fas fa-coins text-base"></i>
          </div>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-800 p-5 rounded-2xl flex items-center justify-between">
          <div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Purchase Orders Audited</p>
            <h3 class="text-2xl font-bold text-blue-400 mt-1">{{networkOrdersCount}}</h3>
          </div>
          <div class="w-10 h-10 rounded-xl bg-blue-400/10 text-blue-400 flex items-center justify-center">
            <i class="fas fa-file-invoice text-base"></i>
          </div>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-800 p-5 rounded-2xl flex items-center justify-between">
          <div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Top Performing Vendor</p>
            <h3 class="text-base font-bold text-amber-400 mt-1 truncate max-w-[150px]">{{topPerformerName}}</h3>
          </div>
          <div class="w-10 h-10 rounded-xl bg-amber-400/10 text-amber-400 flex items-center justify-center">
            <i class="fas fa-trophy text-base"></i>
          </div>
        </div>
      </div>

      <!-- Search & Grade Filters -->
      <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 mb-6 shadow-xl flex flex-col md:flex-row items-center justify-between gap-4">
        <form action="/supplier-performance" method="GET" class="flex-1 w-full flex flex-col md:flex-row items-center gap-3">
          <div class="relative flex-1 w-full">
            <i class="fas fa-search absolute left-4 top-3.5 text-gray-500 text-xs"></i>
            <input type="text" name="search" value="{{searchQuery}}" placeholder="Search supplier by name or supplier code..." class="w-full bg-black border border-zinc-800 rounded-xl pl-10 pr-4 py-2.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-yellow-400 transition">
          </div>
          <div class="flex items-center space-x-2 w-full md:w-auto">
            <select name="gradeFilter" class="bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400 transition">
              <option value="All" {{#eq gradeFilter 'All'}}selected{{/eq}}>All Tiers & Grades</option>
              <option value="A+" {{#eq gradeFilter 'A+'}}selected{{/eq}}>Grade A+ (Preferred Partner)</option>
              <option value="A" {{#eq gradeFilter 'A'}}selected{{/eq}}>Grade A (Reliable)</option>
              <option value="B" {{#eq gradeFilter 'B'}}selected{{/eq}}>Grade B (Needs Improvement)</option>
              <option value="C" {{#eq gradeFilter 'C'}}selected{{/eq}}>Grade C (At Risk)</option>
            </select>
            <button type="submit" class="bg-zinc-800 hover:bg-zinc-700 text-yellow-400 px-4 py-2.5 rounded-xl text-xs font-bold transition">
              Filter
            </button>
            <a href="/supplier-performance" class="text-gray-400 hover:text-white text-xs px-2 py-2.5">
              Reset
            </a>
          </div>
        </form>
      </div>

      <!-- Supplier Performance Cards Matrix -->
      <div class="space-y-4">
        {{#if suppliers.length}}
          {{#each suppliers}}
            <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-6 shadow-xl hover:border-zinc-700 transition">
              <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-4 border-b border-zinc-800">
                <div class="flex items-center space-x-4">
                  <!-- Score Circle Badge -->
                  <div class="w-14 h-14 rounded-2xl bg-zinc-950 border border-zinc-800 flex flex-col items-center justify-center shrink-0">
                    <span class="text-base font-bold font-mono text-yellow-400">{{score}}</span>
                    <span class="text-[8px] uppercase tracking-wider text-gray-500">/ 100</span>
                  </div>
                  <div>
                    <div class="flex items-center space-x-2.5">
                      <h3 class="text-base font-bold text-white">{{name}}</h3>
                      <span class="font-mono text-[10px] text-gray-500 bg-black px-2 py-0.5 rounded border border-zinc-800">{{code}}</span>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[9px] font-bold {{#eq badgeColor 'emerald'}}bg-emerald-500/10 text-emerald-400 border border-emerald-500/30{{/eq}}{{#eq badgeColor 'blue'}}bg-blue-500/10 text-blue-400 border border-blue-500/30{{/eq}}{{#eq badgeColor 'amber'}}bg-amber-500/10 text-amber-400 border border-amber-500/30{{/eq}}{{#eq badgeColor 'red'}}bg-red-500/10 text-red-400 border border-red-500/30{{/eq}}">
                        {{grade}} &bull; {{tier}}
                      </span>
                    </div>
                    <p class="text-xs text-gray-400 mt-1">
                      Contact: <span class="text-white">{{contactPerson}}</span> &bull; Status: <strong class="{{#eq status 'Active'}}text-emerald-400{{else}}text-zinc-500{{/eq}}">{{status}}</strong>
                    </p>
                  </div>
                </div>

                <div class="flex items-center space-x-3 shrink-0">
                  <div class="text-right">
                    <span class="text-[10px] text-gray-500 uppercase block font-semibold">Total Purchases</span>
                    <span class="text-sm font-bold text-white font-mono">₱{{formatCurrency totalSpend}}</span>
                  </div>
                  <a href="/purchase-history?supplierId={{id}}" class="px-3 py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-yellow-400 text-xs font-bold transition flex items-center space-x-1.5">
                    <i class="fas fa-clock-rotate-left"></i>
                    <span>Orders ({{totalOrders}})</span>
                  </a>
                </div>
              </div>

              <!-- Performance Factors Grid -->
              <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 py-4">
                
                <!-- On-Time Delivery Rate -->
                <div class="bg-black/40 border border-zinc-800/80 rounded-xl p-3">
                  <div class="flex justify-between items-center text-[10px] text-gray-400 uppercase font-semibold">
                    <span>On-Time Rate</span>
                    <i class="fas fa-clock text-blue-400"></i>
                  </div>
                  <div class="mt-1 flex items-baseline space-x-1">
                    <span class="text-lg font-bold font-mono {{#gte onTimeRate 90}}text-emerald-400{{else}}{{#gte onTimeRate 75}}text-amber-400{{else}}text-red-400{{/gte}}{{/gte}}">
                      {{onTimeRate}}%
                    </span>
                  </div>
                  <div class="w-full bg-zinc-800 h-1.5 rounded-full mt-2 overflow-hidden">
                    <div class="bg-blue-400 h-full rounded-full" style="width: {{onTimeRate}}%;"></div>
                  </div>
                </div>

                <!-- Fulfillment Accuracy Rate -->
                <div class="bg-black/40 border border-zinc-800/80 rounded-xl p-3">
                  <div class="flex justify-between items-center text-[10px] text-gray-400 uppercase font-semibold">
                    <span>Fulfillment Rate</span>
                    <i class="fas fa-boxes-packing text-emerald-400"></i>
                  </div>
                  <div class="mt-1 flex items-baseline space-x-1">
                    <span class="text-lg font-bold font-mono {{#gte fulfillmentRate 90}}text-emerald-400{{else}}{{#gte fulfillmentRate 75}}text-amber-400{{else}}text-red-400{{/gte}}{{/gte}}">
                      {{fulfillmentRate}}%
                    </span>
                  </div>
                  <div class="w-full bg-zinc-800 h-1.5 rounded-full mt-2 overflow-hidden">
                    <div class="bg-emerald-400 h-full rounded-full" style="width: {{fulfillmentRate}}%;"></div>
                  </div>
                </div>

                <!-- Damage / Defect Rate -->
                <div class="bg-black/40 border border-zinc-800/80 rounded-xl p-3">
                  <div class="flex justify-between items-center text-[10px] text-gray-400 uppercase font-semibold">
                    <span>Defect Rate</span>
                    <i class="fas fa-triangle-exclamation text-red-400"></i>
                  </div>
                  <div class="mt-1 flex items-baseline space-x-1">
                    <span class="text-lg font-bold font-mono {{#gt damageRate 3}}text-red-400{{else}}text-gray-300{{/gt}}">
                      {{damageRate}}%
                    </span>
                  </div>
                  <p class="text-[9px] text-gray-500 mt-2">Target &le; 2.0%</p>
                </div>

                <!-- Return Rate -->
                <div class="bg-black/40 border border-zinc-800/80 rounded-xl p-3">
                  <div class="flex justify-between items-center text-[10px] text-gray-400 uppercase font-semibold">
                    <span>Return Incidents</span>
                    <i class="fas fa-rotate-left text-amber-400"></i>
                  </div>
                  <div class="mt-1 flex items-baseline space-x-1">
                    <span class="text-lg font-bold font-mono text-white">
                      {{returnsCount}}
                    </span>
                    <span class="text-[10px] text-gray-500 font-mono">({{returnRate}}%)</span>
                  </div>
                  <p class="text-[9px] text-gray-500 mt-2">Returns logged</p>
                </div>

                <!-- Lead Time -->
                <div class="bg-black/40 border border-zinc-800/80 rounded-xl p-3">
                  <div class="flex justify-between items-center text-[10px] text-gray-400 uppercase font-semibold">
                    <span>Avg Lead Time</span>
                    <i class="fas fa-truck-ramp-box text-purple-400"></i>
                  </div>
                  <div class="mt-1 flex items-baseline space-x-1">
                    <span class="text-lg font-bold font-mono text-white">
                      {{avgLeadDays}}
                    </span>
                    <span class="text-[10px] text-gray-500">days</span>
                  </div>
                  <p class="text-[9px] text-gray-500 mt-2">Order to receiving</p>
                </div>

              </div>

              <!-- Actionable Quality Recommendation -->
              <div class="mt-1 bg-zinc-950 border border-zinc-800/80 rounded-xl p-3 flex items-center justify-between text-xs">
                <div class="flex items-center space-x-2">
                  <i class="fas fa-lightbulb text-yellow-400"></i>
                  <span class="text-gray-300 font-medium">Recommendation:</span>
                  <span class="text-gray-400">{{recommendation}}</span>
                </div>
                <a href="/supplier-products?supplierId={{id}}" class="text-yellow-400 hover:underline text-[11px] shrink-0 font-semibold ml-2">
                  View Catalog Offering &rarr;
                </a>
              </div>
            </div>
          {{/each}}
        {{else}}
          <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-12 text-center text-gray-500">
            <i class="fas fa-chart-line text-4xl mb-3 text-zinc-700"></i>
            <p class="text-sm font-medium">No suppliers match the performance criteria.</p>
          </div>
        {{/if}}
      </div>

    </main>
  </div>

  {{> footer}}

  <script>
    setTimeout(() => {
      const toast = document.getElementById('toastMessage');
      if (toast) toast.style.display = 'none';
    }, 4500);
  </script>
</body>
</html>