{{> head}}
<body class="bg-black text-gray-100 min-h-screen flex flex-col justify-between">

  <!-- Toast Notification Popups -->
  {{#if successMessage}}
    <div id="toastMessage" class="fixed top-5 right-5 z-50 bg-emerald-950 border border-emerald-800 text-emerald-300 px-6 py-3 rounded-xl shadow-2xl flex items-center space-x-3 transition-all duration-300">
      <i class="fas fa-check-circle text-emerald-400"></i>
      <span class="text-xs font-semibold">{{successMessage}}</span>
    </div>
  {{/if}}
  {{#if errorMessage}}
    <div id="toastMessage" class="fixed top-5 right-5 z-50 bg-red-950 border border-red-800 text-red-300 px-6 py-3 rounded-xl shadow-2xl flex items-center space-x-3 transition-all duration-300">
      <i class="fas fa-exclamation-triangle text-red-400"></i>
      <span class="text-xs font-semibold">{{errorMessage}}</span>
    </div>
  {{/if}}

  <div class="flex flex-1">
    <!-- Master Sidebar -->
    {{> sidebar}}

    <!-- Main Content -->
    <main class="flex-1 p-8 overflow-y-auto bg-black">
      
      <!-- Page Header -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 bg-zinc-900/60 border border-zinc-800/80 p-6 rounded-2xl backdrop-blur-md">
        <div>
          <div class="flex items-center space-x-3">
            <h2 class="text-xl font-bold text-white tracking-wide">Department Management</h2>
            <span class="bg-yellow-400/10 text-yellow-400 border border-yellow-400/30 text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider">
              Module 4
            </span>
          </div>
          <p class="text-xs text-gray-400 mt-1">Departments come from HR (shared across DJ's ERP). Monitor purchase request and order origins here; add or rename departments in HR.</p>
        </div>
        <div class="flex items-center space-x-3">
          <a href="{{hrDepartmentsUrl}}" class="bg-yellow-400 hover:bg-yellow-500 text-black font-bold px-4 py-2.5 rounded-xl text-xs transition shadow-lg flex items-center space-x-2" title="Departments are shared across DJ's ERP and managed in HR">
            <i class="fas fa-users"></i>
            <span>Manage in HR</span>
          </a>
        </div>
      </div>

      <!-- Quick KPI Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="bg-zinc-900/80 border border-zinc-800 p-5 rounded-2xl flex items-center justify-between">
          <div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Total Departments</p>
            <h3 class="text-2xl font-bold text-white mt-1">{{totalDepartments}}</h3>
          </div>
          <div class="w-10 h-10 rounded-xl bg-yellow-400/10 text-yellow-400 flex items-center justify-center">
            <i class="fas fa-building text-base"></i>
          </div>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-800 p-5 rounded-2xl flex items-center justify-between">
          <div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Active Departments</p>
            <h3 class="text-2xl font-bold text-emerald-400 mt-1">{{activeDepartments}}</h3>
          </div>
          <div class="w-10 h-10 rounded-xl bg-emerald-400/10 text-emerald-400 flex items-center justify-center">
            <i class="fas fa-check-circle text-base"></i>
          </div>
        </div>
        <div class="bg-zinc-900/80 border border-zinc-800 p-5 rounded-2xl flex items-center justify-between">
          <div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-wider">Inactive Units</p>
            <h3 class="text-2xl font-bold text-red-400 mt-1">{{inactiveDepartments}}</h3>
          </div>
          <div class="w-10 h-10 rounded-xl bg-red-400/10 text-red-400 flex items-center justify-center">
            <i class="fas fa-ban text-base"></i>
          </div>
        </div>
      </div>

      <!-- Search & Filter Bar -->
      <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-4 mb-6 shadow-xl flex flex-col md:flex-row items-center justify-between gap-4">
        <form action="/departments" method="GET" class="flex-1 w-full flex flex-col md:flex-row items-center gap-3">
          <div class="relative flex-1 w-full">
            <i class="fas fa-search absolute left-4 top-3.5 text-gray-500 text-xs"></i>
            <input type="text" name="search" value="{{searchQuery}}" placeholder="Search department name, code, or department head..." class="w-full bg-black border border-zinc-800 rounded-xl pl-10 pr-4 py-2.5 text-xs text-white placeholder-gray-500 focus:outline-none focus:border-yellow-400 transition">
          </div>
          <div class="flex items-center space-x-2 w-full md:w-auto">
            <select name="status" class="bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400 transition">
              <option value="All" {{#eq statusFilter 'All'}}selected{{/eq}}>All Statuses</option>
              <option value="Active" {{#eq statusFilter 'Active'}}selected{{/eq}}>Active Only</option>
              <option value="Inactive" {{#eq statusFilter 'Inactive'}}selected{{/eq}}>Inactive Only</option>
            </select>
            <button type="submit" class="bg-zinc-800 hover:bg-zinc-700 text-gray-200 font-bold px-4 py-2.5 rounded-xl text-xs transition">
              Filter
            </button>
            {{#if searchQuery}}
              <a href="/departments" class="text-xs text-gray-400 hover:text-white px-2 py-2">Reset</a>
            {{/if}}
          </div>
        </form>
      </div>

      <!-- Departments Card Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
        {{#each departments}}
          <div class="bg-zinc-900/90 border border-zinc-800 rounded-2xl p-6 shadow-xl flex flex-col justify-between hover:border-zinc-700 transition">
            <div>
              <!-- Header with Code & Status -->
              <div class="flex justify-between items-start mb-3">
                <div class="flex items-center space-x-2">
                  <span class="font-mono text-xs font-bold bg-yellow-400 text-black px-2.5 py-1 rounded-lg shadow">
                    {{code}}
                  </span>
                  <h3 class="text-base font-bold text-white">{{name}}</h3>
                </div>
                {{{statusBadge status}}}
              </div>

              <!-- Department Head -->
              <div class="mb-4 text-xs text-gray-400 border-b border-zinc-800 pb-3">
                <p>Head: <span class="text-white font-medium">{{#if departmentHead}}{{departmentHead}}{{else}}<span class="text-gray-500 italic">Not Assigned</span>{{/if}}</span></p>
                <p class="mt-1 text-gray-400 line-clamp-2">{{description}}</p>
              </div>

              <!-- Stats & PR Activity -->
              <div class="bg-black/50 p-3 rounded-xl border border-zinc-800/80 mb-4 flex justify-between items-center text-xs">
                <div>
                  <span class="text-[10px] text-gray-500 uppercase tracking-wider block">Purchase Requests</span>
                  <span class="text-yellow-400 font-bold font-mono text-sm">{{requestCount}}</span>
                </div>
                <div class="text-right">
                  <span class="text-[10px] text-gray-500 uppercase tracking-wider block">Purchase Orders</span>
                  <span class="text-white font-bold font-mono text-sm">{{orderCount}}</span>
                </div>
              </div>
            </div>

            <!-- Card Bottom Actions -->
            <div class="flex items-center justify-between border-t border-zinc-800 pt-4 mt-auto">
              <a href="/purchase-requests?departmentId={{id}}" class="text-xs text-yellow-400 hover:text-yellow-300 font-semibold flex items-center space-x-1">
                <span>View Requests</span>
                <i class="fas fa-chevron-right text-[10px]"></i>
              </a>
              <div class="flex items-center space-x-2">
                <span class="text-[10px] text-gray-500" title="Managed in HR">HR</span>
              </div>
            </div>
          </div>
        {{else}}
          <div class="col-span-full bg-zinc-900/50 border border-zinc-800 rounded-2xl p-12 text-center text-gray-500">
            <i class="fas fa-building text-3xl mb-3 text-zinc-700"></i>
            <p class="text-sm">No departments found.</p>
            <a href="{{hrDepartmentsUrl}}" class="mt-4 inline-block bg-yellow-400 hover:bg-yellow-500 text-black font-bold px-4 py-2 rounded-xl text-xs transition">
              Add departments in HR
            </a>
          </div>
        {{/each}}
      </div>
    </main>
  </div>

  <!-- Footer -->
  <footer class="bg-zinc-950 border-t border-zinc-800/80 px-8 py-4 text-center text-xs text-gray-600">
    © 2026 DJ's FoodHub. All rights reserved. Department Management Module v2.0.
  </footer>

  <!-- ==================== MODALS ==================== -->

  <!-- Add Department Modal -->
  <div id="addDeptModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 w-full max-w-md shadow-2xl">
      <div class="flex justify-between items-center mb-4 border-b border-zinc-800 pb-3">
        <h3 class="text-sm font-bold text-yellow-400 uppercase tracking-wider flex items-center space-x-2">
          <i class="fas fa-plus-circle"></i>
          <span>Add Restaurant Department</span>
        </h3>
        <button onclick="closeAddDeptModal()" class="text-gray-400 hover:text-white text-lg font-bold">&times;</button>
      </div>
      <form action="/departments/add" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1">Department Name *</label>
          <input type="text" name="name" placeholder="e.g. Kitchen, Purchasing, Bar" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-400 mb-1">Code (Unique) *</label>
            <input type="text" name="code" placeholder="e.g. KIT, PUR" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white uppercase focus:outline-none focus:border-yellow-400">
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-400 mb-1">Department Head</label>
            <input type="text" name="departmentHead" placeholder="Head Manager" class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1">Description / Responsibilities</label>
          <textarea name="description" rows="2" placeholder="Brief scope of this department..." class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400"></textarea>
        </div>
        <div class="flex justify-end space-x-3 pt-3 border-t border-zinc-800">
          <button type="button" onclick="closeAddDeptModal()" class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-gray-300 text-xs font-bold rounded-xl transition">Cancel</button>
          <button type="submit" class="px-5 py-2 bg-yellow-400 hover:bg-yellow-500 text-black text-xs font-bold rounded-xl transition shadow-lg">Save Department</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit Department Modal -->
  <div id="editDeptModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-6 w-full max-w-md shadow-2xl">
      <div class="flex justify-between items-center mb-4 border-b border-zinc-800 pb-3">
        <h3 class="text-sm font-bold text-yellow-400 uppercase tracking-wider flex items-center space-x-2">
          <i class="fas fa-edit"></i>
          <span>Edit Department</span>
        </h3>
        <button onclick="closeEditDeptModal()" class="text-gray-400 hover:text-white text-lg font-bold">&times;</button>
      </div>
      <form id="editDeptForm" action="/departments/update/" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1">Department Name *</label>
          <input type="text" id="editDeptName" name="name" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-400 mb-1">Code *</label>
            <input type="text" id="editDeptCode" name="code" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white uppercase focus:outline-none focus:border-yellow-400">
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-400 mb-1">Status</label>
            <select id="editDeptStatus" name="status" class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">
              <option value="Active">Active</option>
              <option value="Inactive">Inactive</option>
            </select>
          </div>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1">Department Head</label>
          <input type="text" id="editDeptHead" name="departmentHead" class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400">
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1">Description</label>
          <textarea id="editDeptDesc" name="description" rows="2" class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-yellow-400"></textarea>
        </div>
        <div class="flex justify-end space-x-3 pt-3 border-t border-zinc-800">
          <button type="button" onclick="closeEditDeptModal()" class="px-4 py-2 bg-zinc-800 hover:bg-zinc-700 text-gray-300 text-xs font-bold rounded-xl transition">Cancel</button>
          <button type="submit" class="px-5 py-2 bg-yellow-400 hover:bg-yellow-500 text-black text-xs font-bold rounded-xl transition shadow-lg">Update Department</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openAddDeptModal() {
      document.getElementById('addDeptModal').classList.remove('hidden');
      document.getElementById('addDeptModal').classList.add('flex');
    }

    function closeAddDeptModal() {
      document.getElementById('addDeptModal').classList.remove('flex');
      document.getElementById('addDeptModal').classList.add('hidden');
    }

    function openEditDeptModal(id, name, code, head, desc, status) {
      document.getElementById('editDeptForm').action = '/departments/update/' + id;
      document.getElementById('editDeptName').value = name;
      document.getElementById('editDeptCode').value = code;
      document.getElementById('editDeptHead').value = head || '';
      document.getElementById('editDeptDesc').value = desc || '';
      document.getElementById('editDeptStatus').value = status || 'Active';
      document.getElementById('editDeptModal').classList.remove('hidden');
      document.getElementById('editDeptModal').classList.add('flex');
    }

    function closeEditDeptModal() {
      document.getElementById('editDeptModal').classList.remove('flex');
      document.getElementById('editDeptModal').classList.add('hidden');
    }

    setTimeout(() => {
      const toast = document.getElementById('toastMessage');
      if (toast) {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 400);
      }
    }, 3500);
  </script>

</body>
</html>
