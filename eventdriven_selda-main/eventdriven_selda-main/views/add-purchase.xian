{{> head}}
<body class="bg-black text-gray-100 min-h-screen flex flex-col justify-between">
  <div class="flex flex-1 p-8 items-center justify-center">
    <main class="max-w-xl w-full bg-zinc-900 border border-zinc-800 p-8 rounded-2xl shadow-xl">
      <h2 class="text-base font-bold text-yellow-400 mb-6 uppercase tracking-wider">Record New Purchase Order</h2>
      
      <form action="/orders/add" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1 uppercase tracking-wider">Piliin ang Supplier</label>
          <select name="supplierId" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400">
            <option value="">-- Piliin ang Supplier --</option>
            {{#each suppliers}}
              <option value="{{id}}">{{name}}</option>
            {{/each}}
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1 uppercase tracking-wider">Item / Product Name</label>
          <input type="text" name="itemName" placeholder="e.g., Ground Pork" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400">
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1 uppercase tracking-wider">Unit Price (₱)</label>
          <input type="number" step="0.01" name="unitPrice" placeholder="0.00" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400">
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-400 mb-1 uppercase tracking-wider">Total Amount (₱)</label>
          <input type="number" step="0.01" name="totalAmount" placeholder="0.00" required class="w-full bg-black border border-zinc-800 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-yellow-400">
        </div>

        <div class="flex space-x-3 pt-4">
          <button type="submit" class="flex-1 bg-yellow-400 hover:bg-yellow-500 text-black font-bold py-3 rounded-xl text-xs transition shadow-lg">I-save ang Order</button>
          <a href="/purchase-history" class="px-4 py-3 bg-zinc-800 hover:bg-zinc-700 text-gray-300 text-xs font-bold rounded-xl text-center transition">Bumalik</a>
        </div>
      </form>
    </main>
  </div>
</body>
</html>