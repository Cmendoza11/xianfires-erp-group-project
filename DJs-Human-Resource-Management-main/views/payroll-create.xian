{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">
<div class="flex flex-col md:flex-row min-h-screen">

  {{> sidebar}}

  <main class="flex-1 min-w-0">

    <header class="bg-[#111111] border-b border-yellow-500/20 px-6 py-5">
      <h2 class="text-xl md:text-2xl font-bold">Create Payroll</h2>
      <p class="text-sm text-gray-500 mt-1">Compute the pay from attendance (DTR) and overtime, deduct SSS, PhilHealth, Pag-IBIG and cash advances, then save the payslip.</p>
    </header>

    <section class="p-6 max-w-4xl space-y-6">

      {{> flash}}

      <form method="POST" action="/payroll/create" class="rounded-2xl border border-white/5 bg-[#171717] p-5 sm:p-6 space-y-5" id="payrollForm">

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Employee *</label>
            <select id="employeeSelect" name="employeeId" required class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
              <option value="">Select employee</option>
              {{#each employees}}
              <option value="{{id}}" data-daily="{{dailyRateUsed}}" data-hourly="{{hourlyRateUsed}}">{{firstName}} {{lastName}} — {{employeeCode}}</option>
              {{/each}}
            </select>
            <p id="rateHint" class="mt-1 text-[11px] text-gray-500"></p>
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Status</label>
            <select name="status" class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
              {{#each statuses}}
              <option value="{{this}}">{{this}}</option>
              {{/each}}
            </select>
            <p class="mt-1 text-[11px] text-gray-500">Draft → Processed (approved) → Paid. Paid payroll is posted to Accounting automatically.</p>
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Period Start *</label>
            <input type="date" name="periodStart" required value="{{defaultStart}}"
                   class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
          </div>

          <div>
            <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Period End *</label>
            <input type="date" name="periodEnd" required value="{{defaultEnd}}"
                   class="w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button type="button" id="computeBtn" class="rounded-xl border border-yellow-400/40 px-5 py-2.5 text-sm font-semibold text-yellow-400 hover:bg-yellow-400 hover:text-black">Compute from attendance (DTR)</button>
          <span id="computeInfo" class="text-xs text-gray-400">Leave Basic Pay blank to compute everything from attendance when you save.</span>
        </div>
        <input type="hidden" name="daysWorked" id="daysWorked">
        <input type="hidden" name="overtimeHours" id="overtimeHours">

        <div class="border-t border-white/5 pt-5">
          <h3 class="font-bold mb-4">Earnings</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Basic Pay (₱)</label>
              <input id="basicSalary" type="number" name="basicSalary" min="0" step="0.01" placeholder="From attendance"
                     class="calc w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Overtime Pay (₱)</label>
              <input id="overtime" type="number" name="overtime" min="0" step="0.01" placeholder="From attendance"
                     class="calc w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Allowances (₱)</label>
              <input type="number" name="allowances" min="0" step="0.01" value="0"
                     class="calc w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
            </div>
          </div>
        </div>

        <div class="border-t border-white/5 pt-5">
          <h3 class="font-bold mb-4">Deductions</h3>
          <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">SSS (₱)</label>
              <input id="sssDeduction" type="number" name="sssDeduction" min="0" step="0.01" placeholder="Auto"
                     class="calc w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">PhilHealth (₱)</label>
              <input id="philhealthDeduction" type="number" name="philhealthDeduction" min="0" step="0.01" placeholder="Auto"
                     class="calc w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Pag-IBIG (₱)</label>
              <input id="pagibigDeduction" type="number" name="pagibigDeduction" min="0" step="0.01" placeholder="Auto"
                     class="calc w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
            </div>
            <div>
              <label class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Cash Advance (₱)</label>
              <input type="number" name="cashAdvance" min="0" step="0.01" value="0"
                     class="calc w-full rounded-xl border border-white/10 bg-[#0F0F0F] px-4 py-3 text-sm outline-none focus:border-yellow-400/60">
            </div>
          </div>
          <p class="mt-2 text-[11px] text-gray-500">Employee share: SSS 5% of the monthly salary credit, PhilHealth 2.5%, Pag-IBIG 2% (max ₱200 a month); a payroll of 16 days or less takes half.</p>

          <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div class="rounded-xl border border-white/10 p-4 flex items-center justify-between">
              <span class="text-sm text-gray-300">Total Deductions</span>
              <span id="totalDeductions" class="text-lg font-bold">₱0.00</span>
            </div>
            <div class="rounded-xl border border-yellow-500/20 bg-yellow-500/5 p-4 flex items-center justify-between">
              <span class="text-sm text-gray-300">Net Pay</span>
              <span id="netPay" class="text-xl font-black text-yellow-400">₱0.00</span>
            </div>
          </div>
        </div>

        <div class="flex flex-wrap gap-3">
          <button type="submit" class="rounded-xl bg-yellow-400 px-6 py-3 text-sm font-bold text-black hover:bg-yellow-300">Save Payroll</button>
          <a href="/payroll" class="rounded-xl border border-white/10 px-6 py-3 text-sm font-semibold text-gray-300 hover:bg-white/5">Cancel</a>
        </div>
      </form>

    </section>
  </main>
</div>

<script>
  (() => {
    const form = document.getElementById("payrollForm");
    const field = (name) => form.querySelector(`[name="${name}"]`);
    const employeeSelect = document.getElementById("employeeSelect");
    const info = document.getElementById("computeInfo");
    const money = (n) => "₱" + Number(n || 0).toLocaleString("en-PH", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const value = (name) => Number(field(name).value || 0);

    const recalc = () => {
      const deductions = value("sssDeduction") + value("philhealthDeduction") + value("pagibigDeduction") + value("cashAdvance");
      document.getElementById("totalDeductions").textContent = money(deductions);
      document.getElementById("netPay").textContent = money(value("basicSalary") + value("overtime") + value("allowances") - deductions);
    };

    employeeSelect.addEventListener("change", () => {
      const option = employeeSelect.options[employeeSelect.selectedIndex];
      document.getElementById("rateHint").textContent = option?.dataset.daily
        ? `Rate per day ${money(option.dataset.daily)} · per hour ${money(option.dataset.hourly)}`
        : "";
    });

    document.getElementById("computeBtn").addEventListener("click", async () => {
      const params = new URLSearchParams({ employeeId: employeeSelect.value, periodStart: field("periodStart").value, periodEnd: field("periodEnd").value });
      info.textContent = "Computing…";
      try {
        const res = await fetch(`/payroll/compute?${params}`, { headers: { Accept: "application/json" } });
        const body = await res.json();
        if (!res.ok) throw new Error(body.error || "Could not compute");
        const d = body.data;
        for (const name of ["basicSalary", "overtime", "sssDeduction", "philhealthDeduction", "pagibigDeduction"]) field(name).value = d[name].toFixed(2);
        document.getElementById("daysWorked").value = d.daysWorked;
        document.getElementById("overtimeHours").value = d.overtimeHours;
        info.textContent = d.daysWorked > 0
          ? `${d.daysWorked} day(s) paid (${d.leaveDays} on paid leave, ${d.absences} absent), ${d.overtimeHours} overtime hour(s), ${d.lateMinutes} late minute(s). You can still change any amount.`
          : "No attendance (DTR) or paid leave found for this employee in this period. Record attendance first, or type the basic pay.";
        recalc();
      } catch (error) {
        info.textContent = error.message;
      }
    });

    form.querySelectorAll(".calc").forEach((input) => input.addEventListener("input", recalc));
    recalc();
  })();
</script>

{{> footer}}
