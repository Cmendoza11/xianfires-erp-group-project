<p class="hidden md:block px-3 pt-5 pb-2 text-[10px] uppercase tracking-widest text-gray-600">DJ's ERP modules</p>
{{#each erpModules}}{{#unless current}}
<a href="{{url}}" class="flex items-center gap-2.5 whitespace-nowrap rounded-xl px-3 py-2 text-sm transition text-gray-400 hover:bg-yellow-400/10 hover:text-yellow-400">
  <span class="w-[18px] text-center shrink-0" aria-hidden="true">{{icon}}</span><span>{{label}}</span>
</a>
{{/unless}}{{/each}}
