{{!--
  Notification bell (any page with a header). Data comes from res.locals (attachNotifications):
  notifications = the latest 8, unreadCount. data-user-menu: closes on outside click / Esc.
--}}
<details class="relative no-print" data-user-menu>
  <summary class="relative grid h-10 w-10 cursor-pointer select-none list-none place-items-center rounded-xl border border-white/10 bg-[#171717] text-gray-400 hover:text-yellow-400 [&::-webkit-details-marker]:hidden" aria-label="Notifications{{#if unreadCount}} ({{unreadCount}} unread){{/if}}">
    <svg class="h-[18px] w-[18px]" aria-hidden="true"><use href="#i-bell"></use></svg>
    {{#if unreadCount}}
    <span class="absolute -right-1 -top-1 grid h-5 min-w-[20px] place-items-center rounded-full bg-yellow-400 px-1 text-[10px] font-bold text-black">{{unreadCount}}</span>
    {{/if}}
  </summary>

  <div class="absolute right-0 z-50 mt-2 w-96 max-w-[calc(100vw-2rem)] overflow-hidden rounded-2xl border border-white/10 bg-[#171717] shadow-2xl shadow-black/40">
    <div class="flex items-center justify-between gap-2 border-b border-white/5 px-4 py-3">
      <p class="text-sm font-bold">Notifications</p>
      {{#if unreadCount}}<span class="rounded-full bg-yellow-400/10 px-2 py-0.5 text-[11px] font-semibold text-yellow-400">{{unreadCount}} unread</span>{{/if}}
    </div>

    {{#if notifications.length}}
    <div class="flex items-center justify-between gap-2 border-b border-white/5 px-4 py-2 text-xs">
      <form method="POST" action="/notifications/read-all">
        <button type="submit" class="font-semibold text-blue-400 hover:underline disabled:cursor-not-allowed disabled:opacity-40" {{#unless unreadCount}}disabled{{/unless}}>Mark all as read</button>
      </form>
      <form method="POST" action="/notifications/delete-all"
            data-confirm-title="Delete all notifications?" data-confirm="All your notifications will be removed. The leaves, payroll and other records are not affected." data-confirm-ok="Delete all">
        <button type="submit" class="font-semibold text-red-400 hover:underline">Delete all</button>
      </form>
    </div>
    {{/if}}

    <div class="max-h-96 overflow-y-auto divide-y divide-white/5">
      {{#each notifications}}
      <div class="group flex items-start gap-3 px-4 py-3 transition {{#if readAt}}hover:bg-white/5{{else}}bg-yellow-400/[0.04] hover:bg-yellow-400/10{{/if}}">
        <a href="/notifications/{{id}}/open" class="flex min-w-0 flex-1 items-start gap-3">
          <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-lg
            {{#if (eq tone "red")}}bg-red-500/10 text-red-400{{else}}{{#if (eq tone "orange")}}bg-orange-500/10 text-orange-400{{else}}{{#if (eq tone "blue")}}bg-blue-500/10 text-blue-400{{else}}{{#if (eq tone "green")}}bg-green-500/10 text-green-400{{else}}bg-yellow-400/10 text-yellow-400{{/if}}{{/if}}{{/if}}{{/if}}">
            <svg class="h-4 w-4" aria-hidden="true"><use href="#{{icon}}"></use></svg>
          </span>
          <span class="min-w-0">
            <span class="block text-sm {{#if readAt}}text-gray-400{{else}}font-semibold text-gray-200{{/if}}">{{title}}</span>
            {{#if detail}}<span class="mt-0.5 block text-xs text-gray-500">{{detail}}</span>{{/if}}
            <span class="mt-0.5 block text-[11px] text-gray-600">{{formatDateTime createdAt}}</span>
          </span>
        </a>
        <div class="flex shrink-0 flex-col items-end gap-1">
          {{#unless readAt}}<span class="mt-1 h-2 w-2 rounded-full bg-yellow-400" title="Unread"></span>{{/unless}}
          <form method="POST" action="/notifications/{{id}}/read">
            <input type="hidden" name="read" value="{{#if readAt}}0{{else}}1{{/if}}">
            <button type="submit" class="whitespace-nowrap text-[11px] text-gray-500 hover:text-yellow-400" title="{{#if readAt}}Mark as unread{{else}}Mark as read{{/if}}">{{#if readAt}}Mark unread{{else}}Mark read{{/if}}</button>
          </form>
          <form method="POST" action="/notifications/{{id}}/delete">
            <button type="submit" class="text-[11px] text-gray-600 hover:text-red-400" aria-label="Delete notification" title="Delete">Delete</button>
          </form>
        </div>
      </div>
      {{else}}
      <div class="px-4 py-8 text-center">
        <svg class="mx-auto h-6 w-6 text-gray-600" aria-hidden="true"><use href="#i-check"></use></svg>
        <p class="mt-2 text-sm text-gray-400">No new notifications</p>
        <p class="text-xs text-gray-600">Leave requests, payslips, new employees and other updates show up here.</p>
      </div>
      {{/each}}
    </div>

    <a href="/notifications" class="block border-t border-white/5 px-4 py-2.5 text-center text-xs font-semibold text-yellow-400 hover:bg-yellow-400/10">View all notifications</a>
  </div>
</details>
