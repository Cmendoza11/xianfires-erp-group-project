{{!-- Brand panel (kaliwa) ng Sign in, Create account at Forgot password. Desktop lang (lg pataas).
      Laging madilim ang panel (kahit naka-light mode), kaya text-neutral-* ang gamit at hindi text-white. --}}
<div class="relative hidden lg:flex flex-col justify-between overflow-hidden bg-black p-12 text-neutral-100">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -top-40 -left-32 h-[28rem] w-[28rem] rounded-full bg-yellow-400/20 blur-3xl"></div>
    <div class="absolute -bottom-48 -right-24 h-[26rem] w-[26rem] rounded-full bg-yellow-500/10 blur-3xl"></div>
    <div class="absolute inset-0 opacity-[0.07]"
         style="background-image: linear-gradient(to right, #fff 1px, transparent 1px), linear-gradient(to bottom, #fff 1px, transparent 1px); background-size: 44px 44px; -webkit-mask-image: radial-gradient(ellipse at 30% 40%, #000 30%, transparent 75%); mask-image: radial-gradient(ellipse at 30% 40%, #000 30%, transparent 75%);"></div>
  </div>

  <a href="/login" class="relative flex items-center gap-3 w-fit">
    <img src="/images/djs-logo.svg" alt="DJ's FoodHub logo" class="h-12 w-12 rounded-xl ring-1 ring-yellow-400/40 shadow-lg shadow-yellow-500/10">
    <div>
      <p class="text-lg font-extrabold leading-tight tracking-tight text-neutral-50">DJs HRMS</p>
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-yellow-400">FoodHub · XianFire ERP</p>
    </div>
  </a>

  <div class="relative max-w-lg">
    <span class="inline-flex items-center gap-2 rounded-full border border-yellow-400/30 bg-yellow-400/10 px-3 py-1 text-xs font-semibold text-yellow-300">
      <span class="h-1.5 w-1.5 rounded-full bg-yellow-400"></span>
      Human Resource Management System
    </span>
    <h1 class="mt-6 text-5xl font-extrabold leading-[1.05] tracking-tight text-neutral-50">
      Human resources,<br><span class="bg-gradient-to-r from-yellow-300 to-yellow-500 bg-clip-text text-transparent">organized.</span>
    </h1>
    <p class="mt-5 text-base leading-relaxed text-neutral-400">
      Employees, departments, attendance, leaves, payroll and reports in one secure workspace for your team.
    </p>

    <ul class="mt-10 space-y-5">
      <li class="flex items-start gap-4">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-yellow-400/20 bg-yellow-400/10 text-yellow-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.04A11.96 11.96 0 0 1 3.6 6 12 12 0 0 0 3 9.75c0 5.6 3.82 10.3 9 11.62 5.18-1.33 9-6.03 9-11.62 0-1.31-.21-2.57-.6-3.75h-.15c-3.2 0-6.1-1.25-8.25-3.29Z"/></svg>
        </span>
        <div>
          <p class="text-sm font-semibold text-neutral-100">Role-based access</p>
          <p class="text-sm text-neutral-500">Separate permissions for HR and employees.</p>
        </div>
      </li>
      <li class="flex items-start gap-4">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-yellow-400/20 bg-yellow-400/10 text-yellow-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
        </span>
        <div>
          <p class="text-sm font-semibold text-neutral-100">Real-time attendance and leaves</p>
          <p class="text-sm text-neutral-500">Track time-ins, absences and leave requests as they happen.</p>
        </div>
      </li>
      <li class="flex items-start gap-4">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-yellow-400/20 bg-yellow-400/10 text-yellow-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.63a3.38 3.38 0 0 0-3.38-3.37h-1.5A1.13 1.13 0 0 1 13.5 7.13v-1.5A3.38 3.38 0 0 0 10.13 2.25H8.25m2.25 0H5.63c-.62 0-1.13.5-1.13 1.13v17.25c0 .62.5 1.12 1.13 1.12h12.75c.62 0 1.12-.5 1.12-1.12V11.25a9 9 0 0 0-9-9ZM9 15h6m-6 3h3.75"/></svg>
        </span>
        <div>
          <p class="text-sm font-semibold text-neutral-100">Payroll and reports</p>
          <p class="text-sm text-neutral-500">Printable payslips and summaries in a few clicks.</p>
        </div>
      </li>
    </ul>
  </div>

  <p class="relative text-xs text-neutral-600">© 2026 DJs Human Resource Management System</p>
</div>
