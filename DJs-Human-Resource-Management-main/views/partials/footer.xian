  <footer class="mt-10 py-6 text-center text-xs text-gray-600 no-print">
    © 2026 DJs Human Resource Management System · Powered by XianFire Framework
  </footer>

  <!--
    Modals (every page):
    - <details data-modal> + <summary> + <div data-modal-panel><div data-modal-box>…</div></div>
      opens the box centred over a dark backdrop; Esc, the backdrop or [data-modal-close] closes it.
    - <form data-confirm="Question?" data-confirm-ok="Delete" data-confirm-tone="danger|success">
      asks in the themed confirm dialog below before it is sent.
  -->
  <style>
    details[data-modal] > summary { list-style: none; }
    details[data-modal] > summary::-webkit-details-marker { display: none; }
    details[data-modal][open] > [data-modal-panel],
    #confirmModal[data-open] {
      position: fixed; inset: 0; z-index: 60;
      display: flex; align-items: center; justify-content: center;
      padding: 16px; background: rgba(0, 0, 0, .65);
      animation: hrms-fade .12s ease-out;
    }
    #confirmModal:not([data-open]) { display: none; }
    [data-modal-box] {
      width: 100%; max-width: 26rem; max-height: calc(100vh - 32px); overflow-y: auto;
      text-align: left; white-space: normal;
      box-shadow: 0 24px 60px rgba(0, 0, 0, .55);
      animation: hrms-pop .14s ease-out;
    }
    @keyframes hrms-fade { from { opacity: 0; } to { opacity: 1; } }
    @keyframes hrms-pop { from { transform: translateY(8px) scale(.98); opacity: 0; } to { transform: none; opacity: 1; } }
    html.hrms-modal-open { overflow: hidden; }
    [data-modal-box] input::placeholder, [data-modal-box] textarea::placeholder { color: #6B7280; }
    @media print { [data-modal-panel], #confirmModal { display: none !important; } }
  </style>

  <div id="confirmModal" role="dialog" aria-modal="true" aria-labelledby="confirmTitle" class="no-print">
    <div data-modal-box class="rounded-2xl border border-white/10 bg-[#171717] p-6 text-white">
      <h3 id="confirmTitle" class="text-lg font-bold">Please confirm</h3>
      <p id="confirmMessage" class="mt-2 text-sm text-gray-400"></p>
      <div class="mt-6 flex justify-end gap-3">
        <button type="button" id="confirmCancel" class="rounded-xl border border-white/10 px-5 py-2.5 text-sm font-semibold text-gray-300 hover:bg-white/5">Cancel</button>
        <button type="button" id="confirmOk" class="rounded-xl px-5 py-2.5 text-sm font-bold">Confirm</button>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var html = document.documentElement;
      var modal = document.getElementById("confirmModal");
      var okBtn = document.getElementById("confirmOk");
      var pendingForm = null;
      var lastFocus = null;
      var TONES = {
        danger: "bg-red-500 text-white hover:bg-red-400",
        success: "bg-emerald-500 text-black hover:bg-emerald-400",
        primary: "bg-yellow-400 text-black hover:bg-yellow-300"
      };

      function syncScrollLock() {
        var open = modal.hasAttribute("data-open") || document.querySelector("details[data-modal][open]");
        html.classList.toggle("hrms-modal-open", !!open);
      }

      function closeDetails(except) {
        document.querySelectorAll("details[data-modal][open]").forEach(function (d) {
          if (d !== except) d.open = false;
        });
      }

      function openConfirm(form) {
        pendingForm = form;
        lastFocus = document.activeElement;
        document.getElementById("confirmTitle").textContent = form.getAttribute("data-confirm-title") || "Please confirm";
        document.getElementById("confirmMessage").textContent = form.getAttribute("data-confirm");
        okBtn.textContent = form.getAttribute("data-confirm-ok") || "Confirm";
        okBtn.className = "rounded-xl px-5 py-2.5 text-sm font-bold " + (TONES[form.getAttribute("data-confirm-tone")] || TONES.danger);
        modal.setAttribute("data-open", "");
        syncScrollLock();
        okBtn.focus();
      }

      function closeConfirm() {
        modal.removeAttribute("data-open");
        pendingForm = null;
        syncScrollLock();
        if (lastFocus && lastFocus.focus) lastFocus.focus();
      }

      // Forms with data-confirm ask first. The confirmed form is sent with form.submit(), which skips this handler.
      document.addEventListener("submit", function (event) {
        var form = event.target;
        if (!form.hasAttribute || !form.hasAttribute("data-confirm")) return;
        event.preventDefault();
        openConfirm(form);
      }, true);

      okBtn.addEventListener("click", function () {
        var form = pendingForm;
        if (!form) return;
        okBtn.disabled = true;
        HTMLFormElement.prototype.submit.call(form);
      });
      document.getElementById("confirmCancel").addEventListener("click", closeConfirm);
      modal.addEventListener("click", function (event) { if (event.target === modal) closeConfirm(); });

      // <details data-modal>: one open at a time, closed by the backdrop or a close button.
      document.addEventListener("toggle", function (event) {
        var d = event.target;
        if (!d.matches || !d.matches("details[data-modal]")) return;
        if (d.open) {
          closeDetails(d);
          var box = d.querySelector("[data-modal-box]");
          var first = box && (box.querySelector("input:not([type=hidden]), select, textarea") || box.querySelector("button[type=submit]"));
          if (first) setTimeout(function () { first.focus(); }, 30);
        }
        syncScrollLock();
      }, true);

      document.addEventListener("click", function (event) {
        var panel = event.target.closest("[data-modal-panel]");
        if (panel && (event.target === panel || event.target.closest("[data-modal-close]"))) {
          event.preventDefault();
          panel.parentElement.open = false;
        }
      });

      document.addEventListener("keydown", function (event) {
        if (event.key !== "Escape") return;
        if (modal.hasAttribute("data-open")) closeConfirm();
        else closeDetails(null);
      });
    })();
  </script>

  <script>
    (function () {
      var root = document.documentElement;
      var KEY = "hrms-theme";

      function apply(theme) {
        var light = theme === "light";
        root.classList.toggle("light", light);
        root.classList.toggle("dark", !light);
        root.style.colorScheme = light ? "light" : "dark";

        document.querySelectorAll("[data-theme-toggle]").forEach(function (button) {
          button.setAttribute("aria-pressed", String(light));
          button.setAttribute("aria-label", light ? "Switch to dark mode" : "Switch to light mode");
          button.title = light ? "Switch to dark mode" : "Switch to light mode";

          button.querySelectorAll("[data-theme-icon]").forEach(function (icon) {
            var name = icon.getAttribute("data-theme-icon");
            icon.classList.toggle("hidden", name !== (light ? "sun" : "moon"));
          });

          var label = button.querySelector("[data-theme-label]");
          if (label) label.textContent = light ? "Light mode" : "Dark mode";
        });
      }

      apply(root.classList.contains("light") ? "light" : "dark");

      document.addEventListener("click", function (event) {
        var toggle = event.target.closest("[data-theme-toggle]");
        if (toggle) {
          event.preventDefault();
          var next = root.classList.contains("light") ? "dark" : "light";
          apply(next);
          try { localStorage.setItem(KEY, next); } catch (error) { /* storage blocked */ }
          return;
        }

        document.querySelectorAll("details[data-user-menu][open]").forEach(function (menu) {
          if (!menu.contains(event.target)) menu.open = false;
        });
      });

      document.addEventListener("keydown", function (event) {
        if (event.key !== "Escape") return;
        document.querySelectorAll("details[data-user-menu][open]").forEach(function (menu) {
          menu.open = false;
        });
      });
    })();
  </script>
</body>
</html>
