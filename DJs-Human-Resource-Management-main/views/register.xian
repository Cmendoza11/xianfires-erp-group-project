{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white antialiased">

<div class="min-h-screen grid lg:grid-cols-[1.1fr_1fr]">

  {{> auth-brand}}

  <main class="flex items-center justify-center px-6 py-12 sm:px-10">
    <div class="w-full max-w-[400px]">

      {{> auth-mobile-brand}}

      <div class="mb-8">
        <h2 class="text-3xl font-bold tracking-tight">Create your account</h2>
        <p class="mt-2 text-sm text-gray-400">
          New accounts start with employee access. HR can update your role if needed.
        </p>
      </div>

      <div class="mb-6 space-y-3 [&:not(:has(div))]:hidden">{{> flash}}</div>

      <form method="POST" action="/register" class="space-y-5">
        <div>
          <label for="name" class="mb-2 block text-sm font-medium text-gray-300">Full name</label>
          <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-gray-500">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.5 20.12a7.5 7.5 0 0 1 15 0A17.93 17.93 0 0 1 12 21.75c-2.68 0-5.22-.58-7.5-1.63Z"/></svg>
            </span>
            <input id="name" type="text" name="name" required minlength="2" autocomplete="name" placeholder="Juan Dela Cruz"
                   class="w-full rounded-xl border border-white/10 bg-[#171717] py-3 pl-12 pr-4 text-sm text-white placeholder-gray-600 outline-none transition focus:border-yellow-400/70 focus:ring-4 focus:ring-yellow-400/15">
          </div>
        </div>

        <div>
          <label for="email" class="mb-2 block text-sm font-medium text-gray-300">Work email</label>
          <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-gray-500">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.24a2.25 2.25 0 0 1-1.07 1.92l-7.5 4.61a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.92V6.75"/></svg>
            </span>
            <input id="email" type="email" name="email" required autocomplete="email" placeholder="you@company.com"
                   class="w-full rounded-xl border border-white/10 bg-[#171717] py-3 pl-12 pr-4 text-sm text-white placeholder-gray-600 outline-none transition focus:border-yellow-400/70 focus:ring-4 focus:ring-yellow-400/15">
          </div>
        </div>

        <div>
          <label for="password" class="mb-2 block text-sm font-medium text-gray-300">Password</label>
          <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-gray-500">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/></svg>
            </span>
            <input id="password" type="password" name="password" required minlength="8" autocomplete="new-password"
                   placeholder="At least 8 characters" aria-describedby="strengthText"
                   class="w-full rounded-xl border border-white/10 bg-[#171717] py-3 pl-12 pr-12 text-sm text-white placeholder-gray-600 outline-none transition focus:border-yellow-400/70 focus:ring-4 focus:ring-yellow-400/15">
            {{> eye-button}}
          </div>
          {{!-- Lakas ng password: gabay lang (8 character ang kailangan ng server) --}}
          <div class="mt-3 grid grid-cols-4 gap-1.5" aria-hidden="true">
            <span data-bar class="h-1 rounded-full bg-white/10 transition-colors"></span>
            <span data-bar class="h-1 rounded-full bg-white/10 transition-colors"></span>
            <span data-bar class="h-1 rounded-full bg-white/10 transition-colors"></span>
            <span data-bar class="h-1 rounded-full bg-white/10 transition-colors"></span>
          </div>
          <p id="strengthText" class="mt-2 text-xs text-gray-500">Use 8 or more characters with a mix of letters, numbers and symbols.</p>
        </div>

        <div>
          <label for="confirmPassword" class="mb-2 block text-sm font-medium text-gray-300">Confirm password</label>
          <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-gray-500">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
            </span>
            <input id="confirmPassword" type="password" name="confirmPassword" required minlength="8" autocomplete="new-password"
                   placeholder="Repeat your password" aria-describedby="matchText"
                   class="w-full rounded-xl border border-white/10 bg-[#171717] py-3 pl-12 pr-12 text-sm text-white placeholder-gray-600 outline-none transition focus:border-yellow-400/70 focus:ring-4 focus:ring-yellow-400/15">
            {{> eye-button}}
          </div>
          <p id="matchText" class="mt-2 hidden text-xs" aria-live="polite"></p>
        </div>

        <button type="submit" data-submit
                class="group flex w-full items-center justify-center gap-2 rounded-xl bg-yellow-400 px-4 py-3 text-sm font-bold text-black shadow-lg shadow-yellow-500/20 transition hover:bg-yellow-300 focus:outline-none focus:ring-4 focus:ring-yellow-400/30 disabled:cursor-wait disabled:opacity-80">
          <span data-label>Create account</span>
          <svg data-arrow class="h-4 w-4 transition group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/></svg>
        </button>
      </form>

      <p class="mt-8 text-center text-sm text-gray-500">
        Already have an account?
        <a href="/login" class="font-semibold text-yellow-400 hover:text-yellow-300">Sign in</a>
      </p>
    </div>
  </main>

</div>

<script>
  (function () {
    var password = document.getElementById("password");
    var confirm = document.getElementById("confirmPassword");
    var bars = document.querySelectorAll("[data-bar]");
    var strengthText = document.getElementById("strengthText");
    var matchText = document.getElementById("matchText");
    var levels = [
      { label: "Too short", color: "bg-red-500", text: "text-red-400" },
      { label: "Weak", color: "bg-orange-500", text: "text-orange-400" },
      { label: "Fair", color: "bg-yellow-400", text: "text-yellow-400" },
      { label: "Good", color: "bg-lime-500", text: "text-green-400" },
      { label: "Strong", color: "bg-green-500", text: "text-green-400" }
    ];

    function score(value) {
      if (value.length < 8) return 0;
      var s = 1;
      if (/[a-z]/.test(value) && /[A-Z]/.test(value)) s++;
      if (/\d/.test(value)) s++;
      if (/[^A-Za-z0-9]/.test(value) || value.length >= 12) s++;
      return s;
    }

    function updateStrength() {
      var value = password.value;
      var s = value ? score(value) : -1;
      bars.forEach(function (bar, i) {
        bar.className = "h-1 rounded-full transition-colors " + (s >= 0 && i < Math.max(s, 1) ? levels[s].color : "bg-white/10");
      });
      if (s < 0) {
        strengthText.className = "mt-2 text-xs text-gray-500";
        strengthText.textContent = "Use 8 or more characters with a mix of letters, numbers and symbols.";
      } else {
        strengthText.className = "mt-2 text-xs font-medium " + levels[s].text;
        strengthText.textContent = s === 0 ? "Too short: at least 8 characters." : "Password strength: " + levels[s].label;
      }
    }

    // Hindi maipapasa ang form kapag hindi tugma (pareho ng tseke ng server)
    function updateMatch() {
      if (!confirm.value) {
        matchText.className = "mt-2 hidden text-xs";
        confirm.setCustomValidity("");
        return;
      }
      var same = confirm.value === password.value;
      matchText.className = "mt-2 text-xs font-medium " + (same ? "text-green-400" : "text-red-400");
      matchText.textContent = same ? "Passwords match." : "Passwords do not match.";
      confirm.setCustomValidity(same ? "" : "Passwords do not match.");
    }

    password.addEventListener("input", function () { updateStrength(); updateMatch(); });
    confirm.addEventListener("input", updateMatch);
  })();
</script>
{{> password-toggle}}
{{> auth-submit}}
</body>
</html>
