{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">

<div class="min-h-screen grid lg:grid-cols-2">

  <div class="hidden lg:flex flex-col justify-between p-12 bg-gradient-to-br from-yellow-500 via-yellow-400 to-yellow-300 text-black">
    <div class="flex items-center gap-3">
      <img src="/images/djs-logo.svg" alt="DJ's FoodHub logo" class="h-14 w-14 rounded-xl ring-1 ring-black/40">
      <div>
        <p class="font-black text-xl leading-tight">DJs HRMS</p>
        <p class="text-xs font-semibold uppercase tracking-widest opacity-70">FoodHub · XianFire ERP</p>
      </div>
    </div>

    <div>
      <h1 class="text-4xl font-black leading-tight">Locked out?<br>HR has you covered.</h1>
      <p class="mt-4 max-w-sm text-sm font-medium opacity-80">
        Send a reset request and keep the page open. Once your HR administrator checks who you are and approves, you set your own new password.
      </p>

      <ol class="mt-8 space-y-3 text-sm font-semibold">
        <li class="flex items-center gap-2"><span class="grid h-6 w-6 place-items-center rounded-full bg-black text-[11px] text-yellow-400">1</span> Send your email and full name</li>
        <li class="flex items-center gap-2"><span class="grid h-6 w-6 place-items-center rounded-full bg-black text-[11px] text-yellow-400">2</span> HR verifies you and approves</li>
        <li class="flex items-center gap-2"><span class="grid h-6 w-6 place-items-center rounded-full bg-black text-[11px] text-yellow-400">3</span> Your page opens Set a new password</li>
      </ol>
    </div>

    <p class="text-xs opacity-70">© 2026 DJs Human Resource Management System</p>
  </div>

  <div class="flex items-center justify-center p-6 sm:p-10">
    <div class="w-full max-w-md">

      <div class="lg:hidden flex items-center gap-3 mb-8">
        <img src="/images/djs-logo.svg" alt="DJ's FoodHub logo" class="h-11 w-11 rounded-xl ring-1 ring-yellow-500/30">
        <div>
          <p class="font-bold text-yellow-400">DJs HRMS</p>
          <p class="text-xs text-gray-500">FoodHub · XianFire ERP</p>
        </div>
      </div>

      {{#if waiting}}
      <div id="waitBox">
        <div class="grid h-12 w-12 place-items-center rounded-2xl bg-yellow-400/10 text-yellow-400">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" d="M12 7v5l3 2"/></svg>
        </div>
        <h2 class="mt-4 text-2xl font-bold">Waiting for HR approval</h2>
        <p class="mt-2 text-sm text-gray-400">
          Request for <span class="break-all text-yellow-400">{{waiting.email}}</span>. The HR administrator has been notified.
        </p>
        <div id="waitStatus" role="status" aria-live="polite" class="mt-6 flex items-center gap-3 rounded-xl border border-yellow-500/20 bg-yellow-500/5 p-4 text-sm text-yellow-200/90">
          <svg class="h-5 w-5 shrink-0 animate-spin text-yellow-400" fill="none" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" class="opacity-25"/><path fill="currentColor" class="opacity-75" d="M12 3a9 9 0 0 1 9 9h-3a6 6 0 0 0-6-6V3Z"/></svg>
          <span>Keep this page open. It moves to <strong>Set a new password</strong> by itself once HR approves (until {{waiting.until}}).</span>
        </div>
        <form method="POST" action="/forgot-password/cancel" class="mt-6">
          <button type="submit" class="w-full rounded-xl border border-white/10 px-4 py-3 text-sm font-semibold text-gray-300 hover:bg-white/5">Cancel and start over</button>
        </form>
        <p class="mt-4 text-center text-xs text-gray-600">HR may also give you a temporary password or a reset link instead.</p>
      </div>
      <script>
        (function () {
          var box = document.getElementById("waitStatus");
          var stop = function (html, tone) {
            box.className = "mt-6 flex items-center gap-3 rounded-xl border p-4 text-sm " + tone;
            box.innerHTML = html;
            clearInterval(timer);
          };
          var check = function () {
            fetch("/forgot-password/status", { headers: { Accept: "application/json" }, cache: "no-store", credentials: "same-origin" })
              .then(function (r) { return r.json(); })
              .then(function (d) {
                if (d.status === "approved" && d.url) { stop("<span>Approved. Opening <strong>Set a new password</strong>…</span>", "border-green-500/30 bg-green-500/10 text-green-400"); window.location.href = d.url; }
                else if (d.status === "dismissed") stop("<span>HR closed this request. Contact your HR administrator, or send a new request.</span>", "border-red-500/30 bg-red-500/10 text-red-400");
                else if (d.status === "link") stop("<span>HR made a one-time reset link for you instead. Ask your HR administrator for it; it works for 30 minutes.</span>", "border-blue-500/30 bg-blue-500/10 text-blue-400");
                else if (d.status === "done") stop("<span>HR already reset your password. Ask them for your temporary password, then sign in.</span>", "border-blue-500/30 bg-blue-500/10 text-blue-400");
                else if (d.status === "expired") stop("<span>This request expired. Send a new one.</span>", "border-orange-500/30 bg-orange-500/10 text-orange-400");
              })
              .catch(function () { /* server busy or restarting: try again on the next tick */ });
          };
          var timer = setInterval(check, 3000);
          check();
        })();
      </script>
      {{else}}
      <h2 class="text-2xl font-bold">Forgot your password?</h2>
      <p class="text-sm text-gray-500 mt-1 mb-6">Send a reset request to your HR administrator.</p>

      <div class="space-y-4 mb-5">{{> flash}}</div>

      <form method="POST" action="/forgot-password" class="space-y-4">
        <div>
          <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Email address</label>
          <input id="email" type="email" name="email" required autofocus autocomplete="email" placeholder="you@company.com"
                 class="w-full rounded-xl border border-white/10 bg-[#171717] px-4 py-3 text-sm text-white placeholder-gray-600 outline-none focus:border-yellow-400/60 focus:ring-2 focus:ring-yellow-400/20">
        </div>

        <div>
          <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Full name</label>
          <input id="name" name="name" required minlength="2" maxlength="120" autocomplete="name" placeholder="Juan Dela Cruz"
                 class="w-full rounded-xl border border-white/10 bg-[#171717] px-4 py-3 text-sm text-white placeholder-gray-600 outline-none focus:border-yellow-400/60 focus:ring-2 focus:ring-yellow-400/20">
        </div>

        <div>
          <label for="note" class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Message to HR <span class="normal-case tracking-normal text-gray-600">(optional)</span></label>
          <input id="note" name="note" maxlength="255" placeholder="e.g. Kitchen staff, EMP-0006"
                 class="w-full rounded-xl border border-white/10 bg-[#171717] px-4 py-3 text-sm text-white placeholder-gray-600 outline-none focus:border-yellow-400/60 focus:ring-2 focus:ring-yellow-400/20">
        </div>

        <button type="submit" class="w-full rounded-xl bg-yellow-400 px-4 py-3 text-sm font-bold text-black transition hover:bg-yellow-300">
          Send reset request
        </button>
      </form>

      <div class="mt-6 text-center text-sm">
        <a href="/login" class="text-gray-500 hover:text-yellow-400">← Back to sign in</a>
      </div>
      {{/if}}
    </div>
  </div>

</div>

</body>
</html>
