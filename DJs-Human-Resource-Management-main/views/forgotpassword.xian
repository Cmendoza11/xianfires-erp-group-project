{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">

<div class="min-h-screen grid lg:grid-cols-2">

  <div class="hidden lg:flex flex-col justify-between p-12 bg-gradient-to-br from-yellow-500 via-yellow-400 to-yellow-300 text-black">
    <div class="flex items-center gap-3">
      <img src="/images/djs-logo.svg" alt="DJ's FoodHub logo" class="h-14 w-14 rounded-xl ring-1 ring-black/40">
      <div>
        <p class="font-black text-xl leading-tight">DJs HRMS</p>
        <p class="text-xs font-semibold uppercase tracking-widest opacity-70">FoodHub · XianFire ERP</p>
      </div>
    </div>

    <div>
      <h1 class="text-4xl font-black leading-tight">Locked out?<br>HR has you covered.</h1>
      <p class="mt-4 max-w-sm text-sm font-medium opacity-80">
        Send a reset request. Your HR administrator checks who you are, sets a temporary password, and gives it to you.
      </p>

      <ol class="mt-8 space-y-3 text-sm font-semibold">
        <li class="flex items-center gap-2"><span class="grid h-6 w-6 place-items-center rounded-full bg-black text-[11px] text-yellow-400">1</span> Send your email and full name</li>
        <li class="flex items-center gap-2"><span class="grid h-6 w-6 place-items-center rounded-full bg-black text-[11px] text-yellow-400">2</span> HR verifies you and sets a temporary password</li>
        <li class="flex items-center gap-2"><span class="grid h-6 w-6 place-items-center rounded-full bg-black text-[11px] text-yellow-400">3</span> Sign in, then change it in My Profile</li>
      </ol>
    </div>

    <p class="text-xs opacity-70">© 2026 DJs Human Resource Management System</p>
  </div>

  <div class="flex items-center justify-center p-6 sm:p-10">
    <div class="w-full max-w-md">

      <div class="lg:hidden flex items-center gap-3 mb-8">
        <img src="/images/djs-logo.svg" alt="DJ's FoodHub logo" class="h-11 w-11 rounded-xl ring-1 ring-yellow-500/30">
        <div>
          <p class="font-bold text-yellow-400">DJs HRMS</p>
          <p class="text-xs text-gray-500">FoodHub · XianFire ERP</p>
        </div>
      </div>

      {{#if sent}}
      <div class="grid h-12 w-12 place-items-center rounded-2xl bg-green-500/10 text-2xl text-green-400">✓</div>
      <h2 class="mt-4 text-2xl font-bold">Request sent</h2>
      <p class="mt-2 text-sm text-gray-400">
        If that email belongs to an HRMS account, your HR administrator now has your reset request.
        They will verify your identity and give you a temporary password in person or through your official contact.
      </p>
      <div class="mt-6 rounded-xl border border-yellow-500/20 bg-yellow-500/5 p-4 text-sm text-yellow-200/90">
        After signing in with the temporary password, change it right away in <strong>My Profile → Change password</strong>.
      </div>
      <a href="/login" class="mt-6 block w-full rounded-xl bg-yellow-400 px-4 py-3 text-center text-sm font-bold text-black transition hover:bg-yellow-300">Back to sign in</a>
      {{else}}
      <h2 class="text-2xl font-bold">Forgot your password?</h2>
      <p class="text-sm text-gray-500 mt-1 mb-6">Send a reset request to your HR administrator.</p>

      <div class="space-y-4 mb-5">{{> flash}}</div>

      <form method="POST" action="/forgot-password" class="space-y-4">
        <div>
          <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Email address</label>
          <input id="email" type="email" name="email" required autofocus autocomplete="email" placeholder="you@company.com"
                 class="w-full rounded-xl border border-white/10 bg-[#171717] px-4 py-3 text-sm text-white placeholder-gray-600 outline-none focus:border-yellow-400/60 focus:ring-2 focus:ring-yellow-400/20">
        </div>

        <div>
          <label for="name" class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Full name</label>
          <input id="name" name="name" required minlength="2" maxlength="120" autocomplete="name" placeholder="Juan Dela Cruz"
                 class="w-full rounded-xl border border-white/10 bg-[#171717] px-4 py-3 text-sm text-white placeholder-gray-600 outline-none focus:border-yellow-400/60 focus:ring-2 focus:ring-yellow-400/20">
        </div>

        <div>
          <label for="note" class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Message to HR <span class="normal-case tracking-normal text-gray-600">(optional)</span></label>
          <input id="note" name="note" maxlength="255" placeholder="e.g. Kitchen staff, EMP-0006"
                 class="w-full rounded-xl border border-white/10 bg-[#171717] px-4 py-3 text-sm text-white placeholder-gray-600 outline-none focus:border-yellow-400/60 focus:ring-2 focus:ring-yellow-400/20">
        </div>

        <button type="submit" class="w-full rounded-xl bg-yellow-400 px-4 py-3 text-sm font-bold text-black transition hover:bg-yellow-300">
          Send reset request
        </button>
      </form>

      <div class="mt-6 text-center text-sm">
        <a href="/login" class="text-gray-500 hover:text-yellow-400">← Back to sign in</a>
      </div>
      {{/if}}
    </div>
  </div>

</div>

</body>
</html>
