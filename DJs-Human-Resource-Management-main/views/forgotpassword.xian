{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white antialiased">

<div class="min-h-screen grid lg:grid-cols-[1.1fr_1fr]">

  {{> auth-brand}}

  <main class="flex items-center justify-center px-6 py-12 sm:px-10">
    <div class="w-full max-w-[400px]">

      {{> auth-mobile-brand}}

      {{#if waiting}}
      <span class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl border border-yellow-500/20 bg-yellow-500/10 text-yellow-400">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
      </span>
      <h1 class="text-3xl font-bold tracking-tight">Waiting for HR approval</h1>
      <p class="mt-2 text-sm text-gray-400">
        Request sent for <span class="break-all font-semibold text-yellow-400">{{waiting.email}}</span>. The HR administrator has been notified.
      </p>

      <div id="waitStatus" role="status" aria-live="polite" class="mt-6 flex items-center gap-3 rounded-xl border border-yellow-500/20 bg-yellow-500/5 p-4 text-sm text-yellow-200/90">
        <svg class="h-5 w-5 shrink-0 animate-spin text-yellow-400" fill="none" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" class="opacity-25"/><path fill="currentColor" class="opacity-75" d="M12 3a9 9 0 0 1 9 9h-3a6 6 0 0 0-6-6V3Z"/></svg>
        <span>Keep this page open. It moves to <strong>Set a new password</strong> by itself once HR approves (until {{waiting.until}}).</span>
      </div>

      <form method="POST" action="/forgot-password/cancel" class="mt-5">
        <button type="submit" class="w-full rounded-xl border border-white/10 px-4 py-3 text-sm font-semibold text-gray-300 transition hover:bg-white/5">Cancel and start over</button>
      </form>
      <p class="mt-4 text-center text-xs text-gray-500">HR may also give you a reset link or a temporary password instead.</p>
      {{else}}
      <span class="mb-6 flex h-12 w-12 items-center justify-center rounded-2xl border border-yellow-500/20 bg-yellow-500/10 text-yellow-400">
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 0 1 3 3m3 0a6 6 0 0 1-7.03 5.91c-.56-.1-1.16.03-1.56.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.82c0-.6.24-1.17.66-1.6l6.16-6.15c.4-.4.52-1 .43-1.56A6 6 0 1 1 21.75 8.25Z"/></svg>
      </span>
      <h1 class="text-3xl font-bold tracking-tight">Forgot your password?</h1>
      <p class="mt-2 text-sm text-gray-400">
        Enter the email you sign in with. HR is notified, and once they approve, this page opens <strong class="text-gray-200">Set a new password</strong> by itself.
      </p>

      <div class="mt-6 space-y-3 [&:not(:has(div))]:hidden">{{> flash}}</div>

      <form method="POST" action="/forgot-password" class="mt-6 space-y-5">
        <div>
          <label for="email" class="mb-2 block text-sm font-medium text-gray-300">Email address</label>
          <div class="relative">
            <span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-gray-500">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.24a2.25 2.25 0 0 1-1.07 1.92l-7.5 4.61a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.92V6.75"/></svg>
            </span>
            <input id="email" type="email" name="email" required autofocus autocomplete="email" placeholder="you@company.com"
                   class="w-full rounded-xl border border-white/10 bg-[#171717] py-3 pl-12 pr-4 text-sm text-white placeholder-gray-600 outline-none transition focus:border-yellow-400/70 focus:ring-4 focus:ring-yellow-400/15">
          </div>
        </div>
        <button type="submit" data-submit
                class="group flex w-full items-center justify-center gap-2 rounded-xl bg-yellow-400 px-4 py-3 text-sm font-bold text-black shadow-lg shadow-yellow-500/20 transition hover:bg-yellow-300 focus:outline-none focus:ring-4 focus:ring-yellow-400/30 disabled:cursor-wait disabled:opacity-80">
          <span data-label>Send request to HR</span>
          <svg data-arrow class="h-4 w-4 transition group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.27 3.13A59.77 59.77 0 0 1 21.49 12 59.77 59.77 0 0 1 3.27 20.88L6 12Zm0 0h7.5"/></svg>
        </button>
      </form>

      {{!-- Mga hakbang --}}
      <ol class="mt-8 space-y-4">
        <li class="flex items-start gap-3">
          <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-yellow-400 text-xs font-bold text-black">1</span>
          <p class="pt-0.5 text-sm text-gray-400">Send this request and keep the page open.</p>
        </li>
        <li class="flex items-start gap-3">
          <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 text-xs font-bold text-gray-300">2</span>
          <p class="pt-0.5 text-sm text-gray-400">Wait for HR to approve it.</p>
        </li>
        <li class="flex items-start gap-3">
          <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-white/10 bg-white/5 text-xs font-bold text-gray-300">3</span>
          <p class="pt-0.5 text-sm text-gray-400">This page opens <strong class="text-gray-200">Set a new password</strong> by itself (valid for 30 minutes).</p>
        </li>
      </ol>
      {{/if}}

      <a href="/login" class="mt-10 inline-flex items-center gap-2 text-sm font-semibold text-gray-400 transition hover:text-yellow-400">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/></svg>
        Back to sign in
      </a>
    </div>
  </main>

</div>

{{#if waiting}}
<script>
  // Asks every 3 s; when HR approves, this browser (and only this one) goes to "Set a new password".
  (function () {
    var box = document.getElementById("waitStatus");
    var stop = function (text, tone) {
      clearInterval(timer);
      box.className = "mt-6 flex items-center gap-3 rounded-xl border p-4 text-sm " + tone;
      box.textContent = text;
    };
    var check = function () {
      fetch("/forgot-password/status", { headers: { Accept: "application/json" }, cache: "no-store", credentials: "same-origin" })
        .then(function (r) { return r.json(); })
        .then(function (d) {
          if (d.status === "approved" && d.url) { stop("Approved. Opening Set a new password…", "border-green-500/30 bg-green-500/10 text-green-400"); window.location.href = d.url; }
          else if (d.status === "dismissed") stop("HR closed this request. Contact your HR administrator, or send a new request.", "border-red-500/30 bg-red-500/10 text-red-400");
          else if (d.status === "link") stop("HR made a one-time reset link for you instead. Ask your HR administrator for it; it works for 30 minutes.", "border-blue-500/30 bg-blue-500/10 text-blue-400");
          else if (d.status === "done") stop("HR already reset your password. Ask them for your temporary password, then sign in.", "border-blue-500/30 bg-blue-500/10 text-blue-400");
          else if (d.status === "expired") stop("This request expired. Press Cancel and start over to send a new one.", "border-orange-500/30 bg-orange-500/10 text-orange-400");
        })
        .catch(function () { /* server busy or restarting: try again next time */ });
    };
    var timer = setInterval(check, 3000);
    check();
  })();
</script>
{{/if}}
{{> auth-submit}}
</body>
</html>
