{{> head}}

<body class="min-h-screen bg-[#0A0A0A] text-white">

<div class="min-h-screen grid lg:grid-cols-2">

  <div class="hidden lg:flex flex-col justify-between p-12 bg-gradient-to-br from-yellow-500 via-yellow-400 to-yellow-300 text-black">
    <div class="flex items-center gap-3">
      <img src="/images/djs-logo.svg" alt="DJ's FoodHub logo" class="h-14 w-14 rounded-xl ring-1 ring-black/40">
      <div>
        <p class="font-black text-xl leading-tight">DJs HRMS</p>
        <p class="text-xs font-semibold uppercase tracking-widest opacity-70">FoodHub · XianFire ERP</p>
      </div>
    </div>

    <div>
      <h1 class="text-4xl font-black leading-tight">Approved.<br>Choose a new password.</h1>
      <p class="mt-4 max-w-sm text-sm font-medium opacity-80">
        Use at least 8 characters that are hard to guess. This page works once, for 30 minutes.
      </p>
    </div>

    <p class="text-xs opacity-70">© 2026 DJs Human Resource Management System</p>
  </div>

  <div class="flex items-center justify-center p-6 sm:p-10">
    <div class="w-full max-w-md">

      <div class="lg:hidden flex items-center gap-3 mb-8">
        <img src="/images/djs-logo.svg" alt="DJ's FoodHub logo" class="h-11 w-11 rounded-xl ring-1 ring-yellow-500/30">
        <div>
          <p class="font-bold text-yellow-400">DJs HRMS</p>
          <p class="text-xs text-gray-500">FoodHub · XianFire ERP</p>
        </div>
      </div>

      {{#if valid}}
      <h2 class="text-2xl font-bold">Set a new password</h2>
      <p class="text-sm text-gray-500 mt-1 mb-6">For <span class="break-all text-yellow-400">{{account.email}}</span> · valid until {{account.until}}</p>

      <div class="space-y-4 mb-5">{{> flash}}</div>

      <form method="POST" action="/reset-password/{{token}}" class="space-y-4">
        <div>
          <label for="password" class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">New password</label>
          <div class="relative">
            <input id="password" type="password" name="password" required minlength="8" autofocus autocomplete="new-password" placeholder="At least 8 characters"
                   class="w-full rounded-xl border border-white/10 bg-[#171717] py-3 pl-4 pr-12 text-sm text-white placeholder-gray-600 outline-none focus:border-yellow-400/60 focus:ring-2 focus:ring-yellow-400/20">
            {{> eye-button}}
          </div>
        </div>
        <div>
          <label for="confirmPassword" class="block text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Confirm new password</label>
          <div class="relative">
            <input id="confirmPassword" type="password" name="confirmPassword" required minlength="8" autocomplete="new-password" placeholder="Repeat the new password"
                   class="w-full rounded-xl border border-white/10 bg-[#171717] py-3 pl-4 pr-12 text-sm text-white placeholder-gray-600 outline-none focus:border-yellow-400/60 focus:ring-2 focus:ring-yellow-400/20">
            {{> eye-button}}
          </div>
        </div>
        <button type="submit" class="w-full rounded-xl bg-yellow-400 px-4 py-3 text-sm font-bold text-black transition hover:bg-yellow-300">
          Save new password
        </button>
      </form>
      {{else}}
      <div class="grid h-12 w-12 place-items-center rounded-2xl bg-red-500/10 text-2xl text-red-400">!</div>
      <h2 class="mt-4 text-2xl font-bold">Link not valid</h2>
      <p class="mt-2 text-sm text-gray-400">
        This page was already used, has expired (30 minutes), or the link is wrong. Send a new reset request.
      </p>
      <a href="/forgot-password" class="mt-6 block w-full rounded-xl bg-yellow-400 px-4 py-3 text-center text-sm font-bold text-black transition hover:bg-yellow-300">Send a new request</a>
      {{/if}}

      <div class="mt-6 text-center text-sm">
        <a href="/login" class="text-gray-500 hover:text-yellow-400">← Back to sign in</a>
      </div>
    </div>
  </div>

</div>

{{> password-toggle}}
</body>
</html>
