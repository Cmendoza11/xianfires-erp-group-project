# DJ's HRMS - settings for running HR on its OWN laptop (LAN mode).
# Copy this file to .env (same folder) and fill in the values from the Accounting laptop (the host).
# Not needed when you start everything from the ERP root with `npm run dev`: the root .env is used then.
# Never push .env to GitHub. Restart HR after every change.

PORT=3002
TZ=Asia/Manila
# Weekly rest days, not counted as leave days or paid leave (0 = Sunday ... 6 = Saturday)
HR_REST_DAYS=0
SESSION_SECRET=change-me-hr-session-secret

# ---- Database: HR's own database (djs_hr) on the Accounting laptop's MySQL ----
DB_HOST=192.168.1.10          # Accounting laptop's IPv4 (ipconfig). 127.0.0.1 in solo mode
DB_PORT=3306
DB_NAME=djs_hr
DB_USER=djs_hr
DB_PASSWORD=change-me         # the password given to 'djs_hr' on the host

# ---- Other modules (the host's IP + each module's port) ----
ERP_URL_ERP=http://192.168.1.10:3000   # Accounting - where paid payroll is posted
ERP_URL_POS=http://192.168.1.10:3001
ERP_URL_HR=http://192.168.1.20:3002    # THIS laptop's IP, so other modules can open HR
ERP_URL_SCM=http://192.168.1.10:3003
ERP_URL_CRM=http://192.168.1.10:3004

# ---- Keys: copy them from the root .env on the Accounting laptop ----
ERP_API_KEY_HR=                # HR's key for the Accounting API (xfk_...)
ERP_INTERNAL_KEY=              # shared X-ERP-Key the modules use to call each other
