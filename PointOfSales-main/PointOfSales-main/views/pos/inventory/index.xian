{{> app-head title="Stock Management" active="inventory" subtitle="Ingredients and raw materials used to prepare your menu products"}}

{{> stock-tabs}}

<section class="grid grid-cols-2 gap-3 lg:grid-cols-4">
  <div class="card p-4"><p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Ingredients</p><p class="stat-value mt-1 text-xl">{{int summary.totalProducts}}</p></div>
  <div class="card p-4"><p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Stock Value</p><p class="stat-value mt-1 text-xl">{{money summary.stockValue}}</p></div>
  <a href="/pos/inventory/low-stock" class="card p-4 transition hover:shadow-md"><p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Low Stock</p><p class="stat-value mt-1 text-xl {{#if summary.lowStock}}text-amber-600{{/if}}">{{int summary.lowStock}}</p></a>
  <a href="/pos/inventory/out-of-stock" class="card p-4 transition hover:shadow-md"><p class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Out of Stock</p><p class="stat-value mt-1 text-xl {{#if summary.outOfStock}}text-red-600{{/if}}">{{int summary.outOfStock}}</p></a>
</section>

<section class="card p-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <form method="GET" action="/pos/inventory" class="inventory-filters flex flex-1 flex-wrap gap-3">
      <input type="search" name="q" value="{{filters.q}}" class="input min-w-[180px] flex-1" placeholder="Search ingredient or product…" />
      <select name="product" class="select max-w-[180px]" aria-label="Filter by menu category or product">
        <option value="">All menu items</option>
        {{#if recipeCategories.length}}
          <optgroup label="Menu categories">
            {{#each recipeCategories}}
              <option value="{{this.value}}" {{selected this.value ../filters.recipeSelection}}>{{this.name}}</option>
            {{/each}}
          </optgroup>
        {{/if}}
        {{#if recipeProducts.length}}
          <optgroup label="Menu products">
            {{#each recipeProducts}}
              <option value="{{this.id}}" {{selected this.id ../filters.recipeSelection}}>{{this.name}}</option>
            {{/each}}
          </optgroup>
        {{/if}}
      </select>
      <select name="status" class="select max-w-[160px]">
        <option value="">All status</option>
        <option value="in" {{selected "in" filters.status}}>In stock</option>
        <option value="low" {{selected "low" filters.status}}>Low stock</option>
        <option value="out" {{selected "out" filters.status}}>Out of stock</option>
      </select>
      <div class="flex shrink-0 gap-2">
        <button type="submit" class="btn btn-dark">Filter</button>
        <a href="/pos/inventory" class="btn btn-light">Reset</a>
      </div>
    </form>
    {{#can "inventory.manage"}}
      <div class="flex shrink-0 gap-2">
        <a href="/pos/inventory/stock-in" class="btn btn-primary">+ Stock In</a>
        <a href="/pos/inventory/adjustment" class="btn btn-light">Adjust</a>
      </div>
    {{/can}}
  </div>
</section>

<section class="card overflow-hidden">
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr><th>Ingredient / Raw Material</th><th>Used in products</th><th>On hand</th><th>Min level</th><th>Status</th><th>Last updated</th></tr>
      </thead>
      <tbody>
        {{#each rows}}
          <tr>
            <td>
              <div class="flex items-center gap-3">
                <div class="h-9 w-9 shrink-0 overflow-hidden rounded-lg bg-stone-100">
                  {{#if this.image}}<img src="{{this.image}}" alt="" class="h-full w-full object-cover" />{{else}}<div class="flex h-full w-full items-center justify-center text-sm"></div>{{/if}}
                </div>
                <a href="/pos/inventory/{{this.productId}}" class="font-bold text-charcoal hover:text-ember">{{this.name}}</a>
              </div>
            </td>
            <td class="text-stone-500">
              {{#each this.usedBy}}{{this.name}}{{#unless @last}}, {{/unless}}{{else}}No recipe yet{{/each}}
            </td>
            <td class="font-bold text-stone-800">{{int this.currentStock}} <span class="text-[11px] font-normal text-stone-400">{{this.unit}}</span></td>
            <td class="text-stone-500">{{int this.minStockLevel}}</td>
            <td><span class="badge {{badge this.stockStatus}}">{{this.stockStatus}}</span></td>
            <td class="text-stone-500">{{datetime this.lastUpdated}}</td>
          </tr>
        {{else}}
          <tr><td colspan="6" class="py-12 text-center text-sm text-stone-500">No inventory records match this filter.</td></tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>

<script>
  for (const filter of document.querySelectorAll('.inventory-filters select')) {
    filter.addEventListener('change', function () {
      this.form.requestSubmit();
    });
  }
</script>

{{> app-foot}}
