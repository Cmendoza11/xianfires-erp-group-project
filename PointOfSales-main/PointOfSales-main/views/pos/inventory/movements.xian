{{> app-head title="Inventory Reports" active="reports-inventory" subtitle="Track inbound and outbound product stock with a complete audit trail"}}
<nav class="flex flex-wrap gap-2"><a href="/pos/reports/inventory" class="btn btn-primary">Product Movement Report</a><a href="/pos/reports/inventory?view=stock" class="btn btn-light">Current Stock Report</a></nav>
<section class="flex flex-wrap items-center justify-between gap-3">
 <div><h1 class="text-xl font-bold">Product Movements</h1><p class="mt-1 text-xs text-stone-500">Showing {{shown}} of {{total}} matching movements, newest first.</p></div>
 <button type="button" id="open-movement-modal" class="btn btn-primary">Add Movement</button>
</section>
<section class="card p-4">
 <form method="GET" action="/pos/reports/inventory" class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
  <div><label class="label" for="movement-scope">Items</label><select id="movement-scope" name="scope" class="select"><option value="products" {{selected "products" filters.scope}}>Menu products</option><option value="ingredients" {{selected "ingredients" filters.scope}}>Ingredients / raw materials</option><option value="all" {{selected "all" filters.scope}}>All items</option></select></div>
  <div><label class="label" for="movement-product">Product</label><select id="movement-product" name="product" class="select"><option value="">All listed items</option>{{#each products}}<option value="{{this.id}}" {{selected this.id ../filters.product}}>{{this.name}}</option>{{/each}}</select></div>
  <div><label class="label" for="movement-from">Start date</label><input id="movement-from" type="date" name="from" value="{{filters.from}}" class="input" /></div>
  <div><label class="label" for="movement-to">End date</label><input id="movement-to" type="date" name="to" value="{{filters.to}}" class="input" /></div>
  <div><label class="label" for="movement-type">Type</label><select id="movement-type" name="type" class="select"><option value="">All types</option>{{#each types}}<option value="{{this}}" {{selected this ../filters.type}}>{{this}}</option>{{/each}}</select></div>
  <div class="sm:col-span-2"><label class="label" for="movement-search">Search</label><input id="movement-search" type="search" name="q" value="{{filters.q}}" class="input" placeholder="Product or user" /></div>
  <div class="flex items-end gap-2"><button class="btn btn-primary">Filter</button><a href="/pos/reports/inventory" class="btn btn-light">Clear Filters</a></div>
 </form>
</section>
<section class="card overflow-hidden"><div class="table-wrap"><table class="data-table movement-audit-table">
 <thead><tr><th>Date &amp; Time</th><th>Product</th><th>Type</th><th>Quantity</th><th>Previous Balance</th><th>New Balance</th><th>User</th></tr></thead>
 <tbody>{{#each movements}}<tr>
  <td>{{datetime this.createdAt}}</td>
  <td><p class="font-semibold">{{this.productName}}</p><p class="mt-1 text-[10px] text-stone-500">ID: {{this.productId}}</p></td>
  <td><span class="badge {{#if this.inbound}}badge-available{{else}}bg-red-50 text-red-700{{/if}}">{{this.direction}}</span><p class="mt-1 text-[10px] text-stone-500">{{this.type}}</p></td>
  <td class="font-bold {{#if this.inbound}}text-emerald-700{{else}}text-red-700{{/if}}">{{this.signedQuantity}} {{this.unit}}</td>
  <td>{{int this.previousStock}} {{this.unit}}</td><td class="font-bold">{{int this.newStock}} {{this.unit}}</td>
  <td><p>{{#if this.performedByName}}{{this.performedByName}}{{else}}System / unknown{{/if}}</p>{{#if this.performedBy}}<p class="mt-1 text-[10px] text-stone-500">User ID: {{this.performedBy}}</p>{{/if}}</td>
 </tr>{{else}}<tr><td colspan="7" class="py-12 text-center text-stone-500">No movements match these filters.</td></tr>{{/each}}</tbody>
</table></div></section>
<script>document.getElementById('movement-scope').addEventListener('change', function () { document.getElementById('movement-product').value = ''; this.form.requestSubmit(); });</script>
{{> product-movement-modal}}
<script defer src="/product-movement-modal.js"></script>
{{> app-foot}}
