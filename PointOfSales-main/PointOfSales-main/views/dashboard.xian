{{> app-head title="POS Dashboard" active="dashboard" subtitle="Sales performance, stock alerts and recent transactions"}}
<div class="flex flex-wrap items-center justify-between gap-3">
  <div><p class="text-xs font-semibold uppercase tracking-wider text-ember">DJs POS &amp; Inventory</p><h1 class="mt-1 text-2xl font-extrabold">Dashboard</h1><p class="mt-1 text-sm text-stone-500">Welcome back, {{currentUser.name}}. Here is your store overview.</p></div>
  <div class="flex flex-wrap items-center gap-3"><span id="dashboard-date" class="text-xs text-stone-400"></span>{{#can "pos"}}<a href="/pos/terminal" class="btn btn-primary">New Sale</a>{{/can}}</div>
</div>
<section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <div class="card dashboard-stat dashboard-stat-sales p-5"><p class="text-[11px] font-bold uppercase tracking-wider text-stone-400">Today's Sales</p><p class="stat-value mt-3">{{money summary.salesToday}}</p><p class="mt-2 text-xs text-stone-500">{{summary.transactionsToday}} completed sales today</p></div>
  <div class="card dashboard-stat dashboard-stat-transactions p-5"><p class="text-[11px] font-bold uppercase tracking-wider text-stone-400">Total Transactions</p><p class="stat-value mt-3">{{int summary.totalTransactions}}</p><p class="mt-2 text-xs text-stone-500">Completed transactions, all time</p></div>
  <div class="card dashboard-stat dashboard-stat-low p-5"><p class="text-[11px] font-bold uppercase tracking-wider text-stone-400">Low Stock Ingredients</p><p class="stat-value mt-3">{{int summary.lowStock}}</p><p class="mt-2 text-xs text-stone-500">At or below minimum stock level</p></div>
  <div class="card dashboard-stat dashboard-stat-out p-5"><p class="text-[11px] font-bold uppercase tracking-wider text-stone-400">Out of Stock Ingredients</p><p class="stat-value mt-3">{{int summary.outOfStock}}</p><p class="mt-2 text-xs text-stone-500">Restock before selling</p></div>
</section>

<section class="space-y-6">
  <div class="card p-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h2 class="text-base font-bold text-charcoal">Weekly Sales Trend</h2>
        <p class="text-xs text-stone-500">Daily sales over the last 7 days; switch views below</p>
      </div>
      <div class="flex rounded-xl border border-stone-200 bg-stone-50 p-1 text-xs font-semibold">
        <button type="button" data-range="daily" class="chart-tab rounded-lg px-3 py-1.5">Daily</button>
        <button type="button" data-range="weekly" class="chart-tab rounded-lg px-3 py-1.5">Weekly</button>
        <button type="button" data-range="monthly" class="chart-tab rounded-lg px-3 py-1.5">Monthly</button>
      </div>
    </div>
    <div class="mt-4 h-72"><canvas id="salesChart"></canvas></div>
  </div>

  <div class="card p-5">
    <div class="flex items-center justify-between">
      <h2 class="text-base font-bold text-charcoal">Top Selling Products</h2>
      <span class="text-[10px] font-bold uppercase tracking-wider text-stone-400">Last 7 days</span>
    </div>
    <div class="mt-4 space-y-3">
      {{#each bestSellers}}
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-ember-50 text-xs font-bold text-ember">{{this.rank}}</span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-stone-800">{{this.name}}</p>
            <p class="text-xs text-stone-500">{{int this.qty}} sold</p>
          </div>
          <span class="text-sm font-bold text-stone-700">{{money this.revenue}}</span>
        </div>
      {{else}}
        <p class="rounded-xl bg-stone-50 px-4 py-8 text-center text-sm text-stone-500">No completed sales yet.</p>
      {{/each}}
    </div>

    <div class="mt-5 grid grid-cols-2 gap-2">
      {{#can "pos"}}
        <a href="/pos/terminal" class="btn btn-primary w-full">Open POS</a>
      {{/can}}
      {{#can "menu"}}
        <a href="/pos/products/new" class="btn btn-light w-full">Add Product</a>
      {{/can}}
    </div>
  </div>
</section>

<section class="grid gap-6 xl:grid-cols-2">
  <div class="card overflow-hidden">
    <div class="flex items-center justify-between border-b border-stone-200/80 px-5 py-4">
      <h2 class="text-base font-bold text-charcoal">Recent Transactions</h2>
      {{#can "transactions"}}<a href="/pos/transactions" class="text-xs font-semibold text-ember hover:underline">View all</a>{{/can}}
    </div>
    <div class="table-wrap">
      <table class="data-table dashboard-table">
        <thead>
          <tr><th>Transaction</th><th>Type</th><th>Cashier</th><th>Total</th><th>Status</th><th>Date</th><th>Details</th></tr>
        </thead>
        <tbody>
          {{#each recentTransactions}}
            <tr>
              <td class="font-semibold text-stone-800">{{this.transactionNumber}}</td>
              <td>{{this.order.orderType}}</td>
              <td class="text-stone-500">{{this.cashierName}}</td>
              <td class="font-bold">{{money this.totalAmount}}</td>
              <td><span class="badge badge-available">Paid</span></td>
              <td class="text-stone-500">{{datetime this.createdAt}}</td>
              <td>{{#can "transactions"}}<a href="/pos/transactions/{{this.id}}" class="btn btn-light">View</a>{{else}}?{{/can}}</td>
            </tr>
          {{else}}
            <tr><td colspan="7" class="py-8 text-center text-stone-500">No transactions recorded yet.</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card overflow-hidden">
    <div class="flex items-center justify-between border-b border-stone-200/80 px-5 py-4">
      <h2 class="text-base font-bold text-charcoal">Recent Inventory Movements</h2>
      {{#can "inventory"}}<a href="/pos/inventory/movements" class="text-xs font-semibold text-ember hover:underline">View all</a>{{/can}}
    </div>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr><th>Product</th><th>Type</th><th>Qty</th><th>Stock</th><th>When</th></tr>
        </thead>
        <tbody>
          {{#each recentMovements}}
            <tr>
              <td class="font-semibold text-stone-800">{{this.productName}}</td>
              <td><span class="badge bg-stone-100 text-stone-600">{{this.type}}</span></td>
              <td class="font-semibold">{{int this.quantity}}</td>
              <td class="text-stone-500">{{int this.previousStock}} → {{int this.newStock}}</td>
              <td class="text-stone-500">{{datetime this.createdAt}}</td>
            </tr>
          {{else}}
            <tr><td colspan="5" class="py-8 text-center text-stone-500">No stock movements yet.</td></tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
  document.getElementById('dashboard-date').textContent = new Intl.DateTimeFormat(undefined, { dateStyle: 'full' }).format(new Date());
  const CHART_DATA = {{{json charts}}};
  let salesChart = null;

  function renderSalesChart(range) {
    const data = CHART_DATA[range] || [];
    const canvas = document.getElementById("salesChart");
    if (!canvas || typeof Chart === "undefined") return;

    if (salesChart) salesChart.destroy();
    salesChart = new Chart(canvas.getContext("2d"), {
      type: "bar",
      data: {
        labels: data.map((point) => point.label),
        datasets: [{
          label: "Sales",
          data: data.map((point) => point.total),
          backgroundColor: "#F9DF36",
          hoverBackgroundColor: "#E5CB24",
          borderRadius: 8,
          maxBarThickness: 42
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: (context) => `Sales: ₱${Number(context.raw).toLocaleString(undefined, { minimumFractionDigits: 2 })}`
            }
          }
        },
        scales: {
          x: { grid: { display: false }, ticks: { color: "#a8a29e", font: { size: 11 } } },
          y: {
            beginAtZero: true,
            grid: { color: "rgba(255,255,255,.08)" },
            ticks: { color: "#a8a29e", font: { size: 11 }, callback: (value) => `₱${value}` }
          }
        }
      }
    });
  }

  function setActiveTab(active) {
    document.querySelectorAll(".chart-tab").forEach((tab) => {
      const isActive = tab.dataset.range === active;
      tab.className = `chart-tab rounded-lg px-3 py-1.5 ${isActive ? "bg-white text-charcoal shadow-sm" : "text-stone-500"}`;
    });
  }

  document.querySelectorAll(".chart-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      setActiveTab(tab.dataset.range);
      renderSalesChart(tab.dataset.range);
    });
  });

  setActiveTab("daily");
  renderSalesChart("daily");
</script>

{{> app-foot}}
