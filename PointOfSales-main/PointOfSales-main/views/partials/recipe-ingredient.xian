<div class="grid grid-cols-[minmax(0,1fr)_100px_100px] items-center gap-3">
  <div class="flex flex-wrap items-center gap-2">
    <label for="recipe-{{id}}" class="text-sm">{{name}}</label>
    {{#if canArchive}}{{#can "inventory.manage"}}
      <button type="submit" form="archive-recipe-ingredient" formaction="/pos/inventory/ingredients/{{id}}/archive" class="btn btn-light px-2 py-1 text-[11px]" aria-label="Archive {{name}}">Archive</button>
    {{/can}}{{/if}}
  </div>
  <span class="text-xs text-stone-500">{{inventory.unit}}</span>
  <input id="recipe-{{id}}" name="ingredient_{{id}}" value="{{recipeQuantity}}" type="number" min="0" max="100000" step="1" class="input" aria-label="{{name}} per serving" />
</div>
