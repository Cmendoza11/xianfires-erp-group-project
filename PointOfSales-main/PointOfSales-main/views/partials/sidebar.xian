<aside id="sidebar" class="fixed inset-y-0 left-0 z-40 flex w-72 -translate-x-full flex-col bg-charcoal text-stone-300 transition-transform duration-200 lg:sticky lg:top-0 lg:h-screen lg:shrink-0 lg:translate-x-0">
  <div class="flex shrink-0 items-center gap-3 border-b border-white/10 px-5 py-5">
    <img src="/foodhub-logo.png" alt="DJs FoodHub logo" width="44" height="44" class="h-11 w-11 shrink-0 rounded-lg object-contain" />
    <div class="min-w-0">
      <p class="text-base font-extrabold leading-tight text-ember">DJs POS &amp; Inventory</p>
      <p class="truncate text-[10px] font-semibold uppercase tracking-[0.18em] text-stone-500">FoodHub - POS System</p>
    </div>
    <button type="button" class="ml-auto text-stone-400 hover:text-white lg:hidden" onclick="toggleSidebar()" aria-label="Close menu">✕</button>
  </div>

  <nav class="min-h-0 flex-1 space-y-1 overflow-y-auto px-3 py-3 text-[13px]">
    <a href="/dashboard" class="nav-link {{#if (eq active 'dashboard')}}active{{/if}}">
      Dashboard
    </a>

    {{#can "pos"}}
      <a href="/pos/terminal" class="nav-link {{#if (eq active 'terminal')}}active{{/if}}">
        POS Terminal
      </a>
    {{/can}}

    {{#can "menu"}}
      <a href="/pos/products" class="nav-link {{#if (eq active 'products')}}active{{/if}}">
        Products
      </a>
      <a href="/pos/categories" class="nav-link {{#if (eq active 'categories')}}active{{/if}}">
        Categories
      </a>
    {{/can}}

    {{#can "inventory"}}
      <a href="/pos/inventory" class="nav-link {{#if (eq active 'inventory')}}active{{/if}}">Stock Management</a>
    {{/can}}

    {{#can "orders"}}
      <a href="/pos/orders" class="nav-link {{#if (eq active 'orders')}}active{{/if}}">
        Orders
      </a>
    {{/can}}
    {{#can "tables"}}
      <a href="/pos/tables" class="nav-link {{#if (eq active 'tables')}}active{{/if}}">
        Table Management
      </a>
    {{/can}}

    {{#can "transactions"}}
      <a href="/pos/transactions" class="nav-link {{#if (eq active 'transactions')}}active{{/if}}">
        Transactions
      </a>
    {{/can}}
    {{#can "reports.sales"}}
      <a href="/pos/reports/sales" class="nav-link {{#if (eq active 'reports-sales')}}active{{/if}}">
        Sales Reports
      </a>
    {{/can}}
    {{#can "reports.inventory"}}
      <a href="/pos/reports/inventory" class="nav-link {{#if (eq active 'reports-inventory')}}active{{/if}}">
        Inventory Reports
      </a>
    {{/can}}
    {{#can "settings"}}
      <a href="/pos/settings" class="nav-link {{#if (eq active 'settings')}}active{{/if}}">
        Settings
      </a>
    {{/can}}
    {{> erpModules}}
  </nav>

  <div class="shrink-0 border-t border-white/10 p-4">
    <div class="flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-full bg-ember/20 text-xs font-bold text-ember">
        {{initials currentUser.name}}
      </div>
      
    <div class="min-w-0">
        <p class="truncate text-sm font-semibold text-white">{{currentUser.name}}</p>
        <p class="truncate text-[11px] capitalize text-stone-500">{{currentUser.role}}</p>
      </div>
      <a href="/logout" class="ml-auto shrink-0 rounded-lg px-2 py-1 text-xs font-semibold text-stone-400 hover:bg-white/10 hover:text-white">Logout</a>
    </div>
  </div>
</aside>
