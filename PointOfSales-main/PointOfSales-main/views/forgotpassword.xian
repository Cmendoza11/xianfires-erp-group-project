{{> head}}
<body class="bg-gray-50">
  <div class="mx-auto mt-20 max-w-md px-4 text-center">
    <h2 class="text-xl font-bold">Forgot Password</h2>
    <p class="mt-3 text-sm text-gray-600">
      Ask a POS administrator to set a new password for you. On the server they run, in the POS folder:
    </p>
    <pre class="mt-3 overflow-x-auto rounded-lg bg-gray-900 p-3 text-left text-xs text-gray-100">npm run user:password -- --email you@example.com --password NewPassword</pre>
    <p class="mt-3 text-xs text-gray-500">Passwords are case-sensitive. Each DJ's ERP module (Accounting, POS, HR, Procurement, Customer Logs) has its own login.</p>
    <a href="/login" class="mt-5 inline-block text-blue-600">Back to Login</a>
  </div>
{{> footer }}
