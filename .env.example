# DJ's ERP - shared settings for all 5 modules.
# `npm run migrate` copies this file to .env and fills in the generated keys.
# Values set in your shell win over this file.

# ---- Databases: every module has its OWN database on this MySQL server ----
# Modules never read each other's databases; they talk only through each other's APIs.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Database names. Leave empty for the defaults:
#   Accounting xianfires_erp, HR djs_hr, POS djs_pos, Procurement djs_procurement, Customer Logs djs_customer_logs
DB_NAME_ERP=
DB_NAME_HR=
DB_NAME_POS=
DB_NAME_SCM=
DB_NAME_CRM=
# Another set of the five databases, e.g. _demo -> xianfires_erp_demo, djs_hr_demo, djs_pos_demo, ...
# (usually set in the shell for one session: $env:DB_SUFFIX="_demo")
DB_SUFFIX=

# ---- Ports (change only if a port is taken) ----
PORT_ERP=3000
PORT_POS=3001
PORT_HR=3002
PORT_SCM=3003
PORT_CRM=3004

# ---- Module URLs (used by the module switcher and the integrations) ----
# Leave empty to use http://localhost:<port>.
ERP_URL_ERP=
ERP_URL_POS=
ERP_URL_HR=
ERP_URL_SCM=
ERP_URL_CRM=

# ---- First admin accounts created by `npm run migrate` (HR asks if these are empty) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Generated by `npm run migrate` - do not share ----
# Shared secret the modules send in the X-ERP-Key header when they call each other.
ERP_INTERNAL_KEY=
# Session cookie signing secret for all modules.
SESSION_SECRET=
# Accounting API keys (one per module, issued by the Accounting ERP). Each database set keeps its own:
# ERP_API_KEY_POS for the main set, ERP_API_KEY_POS_DEMO for DB_SUFFIX=_demo, and so on.
ERP_API_KEY_POS=
ERP_API_KEY_HR=
ERP_API_KEY_SCM=
